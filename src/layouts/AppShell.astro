---
// AppShell — the Biochar Atlas frame, ported from beacon-design's AppShell
// (itself a verbatim port of Beacon's Angular "modern-layout"):
//   .modern-layout (topbar + body[sidenav + content]) · BEM classes, sidebar
//   collapse, nav-section expand/collapse, dropdown open/close — all kept.
//
// Biochar changes vs Beacon:
//   - Tokens: every --bcn-* swapped for semantic (--color-*) or spoke (--bca-*)
//     tokens from theme-biochar.css, always with literal fallbacks.
//   - Sidebar header: the issued ABI symbol beside the product wordmark —
//     "Biochar Atlas" when expanded, the symbol alone on the collapsed rail.
//     Beacon's project-switcher is dropped.
//   - Nav: data-driven NavSections, pruned to what is real — the Suitability
//     Tool, About and Admin. The Phase 2 roadmap sections were removed
//     outright (Andy, 2026-08-14); a nav that previews unbuilt modules was
//     reading as an app with dead links.
//   - Topbar: sidebar toggle on the left, global search in the center, a simple
//     user menu (Profile / Sign out) on the right. No page heading, no badges.
import BaseLayout from './BaseLayout.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcaGlobalSearch from '../components/bca/bca-global-search.astro';
import { withBase } from '../lib/base';

/** Sublinks are text-only — the icon column belongs to the section header. */
interface NavItem {
  id: string;
  label: string;
  /** Real route (already withBase'd). Defaults to the `#id` stub when absent. */
  href?: string;
  active?: boolean;
}
interface NavSection {
  id: string;
  title: string;
  icon: string;
  /** Inline Lucide path markup for glyphs not in esa-icon's registry. */
  iconPaths?: string;
  items?: NavItem[];
  /**
   * Single-link section (no sublist) — the header IS the link. Declares intent;
   * a section with no `items` is forced to this shape regardless (see below).
   */
  link?: boolean;
  /** Destination for a `link` section (already withBase'd). */
  href?: string;
  expanded?: boolean;
  active?: boolean;
  dividerAfter?: boolean;
}
interface Props {
  title?: string;
  navSections?: NavSection[];
  /** NavItem id to highlight (overrides the static default, Suitability Tool). */
  activeNavId?: string;
  /** Section ids to render expanded (overrides the per-section `expanded` defaults when provided). */
  expandedSections?: string[];
}

// ── Lucide glyphs not in esa-icon's built-in registry (inner SVG markup only) ──
const LUCIDE = {
  // section icons
  'map-pinned':
    '<path d="M18 8c0 3.613-3.869 7.429-5.393 8.795a1 1 0 0 1-1.214 0C9.87 15.429 6 11.613 6 8a6 6 0 0 1 12 0"/><circle cx="12" cy="8" r="2"/><path d="M8.714 14h-3.71a1 1 0 0 0-.948.683l-2.004 6A1 1 0 0 0 3 22h18a1 1 0 0 0 .948-1.316l-2-6a1 1 0 0 0-.949-.684h-3.712"/>',
  // About section
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  // user menu
  user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  'log-out':
    '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/>',
};

const {
  title = 'Biochar Suitability Tool',
  activeNavId,
  expandedSections,
  // Default nav — only what is real: the Suitability Tool, About, Admin.
  // The Suitability Tool is a single link rather than a section because it has
  // exactly one destination; a chevron over a one-item list is a disclosure
  // that discloses nothing.
  navSections = [
    {
      id: 'suitability-tool',
      title: 'Suitability Tool',
      icon: 'map-pinned',
      iconPaths: LUCIDE['map-pinned'],
      link: true,
      href: withBase('/suitability-tool'),
      active: true,
      dividerAfter: true,
    },
    {
      id: 'about',
      title: 'About',
      icon: 'info',
      iconPaths: LUCIDE['info'],
      expanded: false,
      items: [
        { id: 'methodology', label: 'Methodology', href: '#' },
        { id: 'resources', label: 'Resources', href: '#' },
      ],
    },
    {
      id: 'admin',
      title: 'Admin',
      icon: 'settings',
      expanded: false,
      items: [
        { id: 'admin-users', label: 'Users', href: withBase('/admin/users') },
        { id: 'admin-catalog', label: 'Biochar Catalog', href: '#' },
        { id: 'datasets-refresh', label: 'Datasets & Refresh', href: '#' },
      ],
    },
  ],
} = Astro.props as Props;

// A section with no sublinks IS a link, whatever the data says. `link: true`
// declares the intent; this makes the RENDER follow the items, so a section
// whose children are pruned can never leave a chevron behind disclosing an
// empty list. Runs before everything downstream, so `section.link === true` is
// the single honest test for "header is the destination" from here on — the
// active-match below, the accordion script, and the rail flyout all read it.
for (const section of navSections) {
  if (!section.items?.length) section.link = true;
}

// Per-page section expansion — when provided, a section is expanded iff its id is listed.
if (expandedSections) {
  for (const section of navSections) {
    section.expanded = expandedSections.includes(section.id);
  }
}

// Per-page nav highlight — activeNavId beats the static default (Suitability
// Tool). A `link` section matches on its own id, since it has no sublist.
// Matching a sublink also OPENS its section: an active row inside a collapsed
// accordion is a highlight nobody can see. An explicit `expandedSections`
// still wins, so a page can override.
if (activeNavId) {
  for (const section of navSections) {
    let hit = section.link === true && section.id === activeNavId;
    for (const item of section.items ?? []) {
      item.active = item.id === activeNavId;
      if (item.active) hit = true;
    }
    section.active = hit;
    if (hit && !expandedSections) section.expanded = true;
  }
}
---

<BaseLayout title={title}>
  <div class="modern-layout">
    <!-- ═══ TOPBAR ═══ -->
    <header class="topbar">
      <!-- Left: sidebar toggle -->
      <div class="topbar__left">
        <!-- bcn-lego-checked: esa-icon-button cannot host this control, and the
             reasons are structural rather than stylistic. It renders exactly
             `<Tag class aria-label title><EsaIcon name size/></Tag>` with no
             rest-spread, so (a) there is no `id` for the script's hook, (b) it
             cannot carry `aria-expanded`, which a disclosure control must ship
             in server-rendered markup rather than acquire on first click, (c) it
             forwards no `paths`, and this glyph — Lucide `panel-left` — is not
             in esa-icon's built-in registry, and (d) the icon mirrors on state
             via .sidebar-toggle__icon, and the lego exposes no hook on its inner
             icon. Beacon hit (c) for its ESA-Config control and hit ALL of these
             for its own sidebar toggle: beacon-design/src/layouts/AppShell.astro
             ships the identical hand-rolled button and reserves EsaIconButton
             for its plain admin link. Checked Ecology + Beacon; the reusable
             home for this is a hub-level esa-disclosure-button that does not
             exist yet. Filed in NEEDS.md. -->
        <button
          type="button"
          class="sidebar-toggle"
          id="sidebar-toggle"
          aria-label="Collapse sidebar"
          aria-expanded="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="sidebar-toggle__icon"
          >
            <rect width="18" height="18" x="3" y="3" rx="2" />
            <path d="M9 3v18" />
          </svg>
        </button>
      </div>

      <!-- Center: global search -->
      <div class="topbar__center">
        <BcaGlobalSearch />
      </div>

      <!-- Right: user menu -->
      <div class="topbar__right">
        <div class="user-menu" id="user-menu">
          <button
            type="button"
            class="user-trigger"
            id="user-trigger"
            aria-haspopup="menu"
            aria-expanded="false"
          >
            <span class="user-trigger__avatar">TC</span>
            <span class="user-trigger__name">Tim Creed</span>
            <EsaIcon name="chevron-down" size="xs" />
          </button>

          <div class="user-panel" id="user-panel" hidden>
            <a href="#" class="user-panel__item">
              <EsaIcon name="user" size="sm" paths={LUCIDE['user']} />
              <span>Profile</span>
            </a>
            <button type="button" class="user-panel__item user-panel__item--danger">
              <EsaIcon name="log-out" size="sm" paths={LUCIDE['log-out']} />
              <span>Sign out</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══ BODY (sidenav + content) ═══ -->
    <div class="modern-layout__body">
      <!-- ─── side nav ─── -->
      <!-- Expanded by default: the lockup and the nav hierarchy are the demo,
           and collapsed-first hid both behind a click. -->
      <nav class="side-nav" id="side-nav">
        <div class="sidebar-header">
          <a href={withBase('/')} class="brand" aria-label="Biochar Atlas — American Biochar Institute">
            <img
              class="brand__logo brand__logo--symbol"
              src={withBase('/abi-logo-symbol-alpha.png')}
              width="1240"
              height="1246"
              alt="American Biochar Institute"
            />
            <span class="brand__product">Biochar Atlas</span>
          </a>
        </div>

        <div class="main-nav">
          {
            navSections.map((section) => (
              <>
                {section.link ? (
                  <div class:list={['nav-section', { 'nav-section--active': section.active }]}>
                    {/* aria-label AND title: on the 72px rail the label span is
                        display:none, so without these the control is an
                        unlabelled icon. The accordion sections get their name
                        back from the flyout panel; a link section has no
                        flyout, so the native tooltip is the only thing naming
                        it for a sighted mouse user. Both repeat the visible
                        label when the rail is open, which is harmless. */}
                    <a
                      href={section.href ?? `#${section.id}`}
                      class="nav-section__header nav-section__header--link"
                      aria-label={section.title}
                      title={section.title}
                    >
                      <EsaIcon
                        name={section.icon}
                        size="sm"
                        paths={section.iconPaths ?? LUCIDE[section.icon as keyof typeof LUCIDE]}
                      />
                      <span class="nav-section__title">{section.title}</span>
                    </a>
                  </div>
                ) : (
                  <div
                    class:list={[
                      'nav-section',
                      { 'nav-section--collapsed': !section.expanded, 'nav-section--active': section.active },
                    ]}
                  >
                    <button
                      type="button"
                      class="nav-section__header"
                      aria-label={section.title}
                      aria-expanded={section.expanded ? 'true' : 'false'}
                    >
                      <EsaIcon
                        name={section.icon}
                        size="sm"
                        paths={section.iconPaths ?? LUCIDE[section.icon as keyof typeof LUCIDE]}
                      />
                      <span class="nav-section__title">{section.title}</span>
                      <EsaIcon name="chevron-down" size="sm" />
                    </button>
                    <div class="nav-flyout">
                    <div class="nav-flyout__panel">
                    <span class="nav-flyout__title">{section.title}</span>
                    <ul class="nav-section__items">
                      {section.items?.map((item) => (
                        <li class="nav-item">
                          <a href={item.href ?? `#${item.id}`} class:list={['nav-sublink', { active: item.active }]}>
                            <span class="nav-sublink__label">{item.label}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    </div>
                    </div>
                  </div>
                )}
                {section.dividerAfter && <hr class="nav-divider" aria-hidden="true" />}
              </>
            ))
          }
        </div>
      </nav>

      <!-- content -->
      <div class="modern-layout__content">
        <slot />
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  // Sidebar collapse toggle + chevron mirroring + user panel open/close.
  // Same contracts as Beacon's AppShell (onToggleSidebar + ui-dropdown).
  const toggle = document.getElementById('sidebar-toggle');
  const sideNav = document.getElementById('side-nav');
  if (toggle && sideNav) {
    toggle.addEventListener('click', () => {
      const collapsed = sideNav.classList.toggle('collapsed');
      toggle.classList.toggle('sidebar-toggle--collapsed', collapsed);
      toggle.setAttribute('aria-expanded', String(!collapsed));
      toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
    });
  }

  // Nav-section expand/collapse (expanded sidebar only).
  document.querySelectorAll<HTMLButtonElement>('button.nav-section__header').forEach((btn) => {
    btn.addEventListener('click', () => {
      const section = btn.closest('.nav-section');
      if (!section) return;
      const nowCollapsed = section.classList.toggle('nav-section--collapsed');
      btn.setAttribute('aria-expanded', String(!nowCollapsed));
    });
  });

  // Keep aria-expanded honest for the collapsed-rail flyouts. CSS does the
  // showing (:hover / :focus-within), which a static attribute cannot describe,
  // so the same header button that reports the accordion state when the rail is
  // open reports the flyout state when it is closed. Only aria-expanded is set:
  // aria-haspopup would advertise a menu widget, and these are plain links with
  // no menu-item keyboard model behind them.
  document.querySelectorAll<HTMLElement>('.nav-section').forEach((section) => {
    const btn = section.querySelector<HTMLElement>('.nav-section__header');
    if (!btn || !section.querySelector('.nav-flyout')) return;
    const sync = (open: boolean) => {
      if (!sideNav?.classList.contains('collapsed')) return;
      btn.setAttribute('aria-expanded', String(open));
    };
    section.addEventListener('mouseenter', () => sync(true));
    section.addEventListener('mouseleave', () => sync(false));
    section.addEventListener('focusin', () => sync(true));
    section.addEventListener('focusout', (e) => {
      if (!section.contains(e.relatedTarget as Node)) sync(false);
    });
  });

  // User menu dropdown (outside-click + Escape close, like Beacon's user menu).
  const userTrigger = document.getElementById('user-trigger');
  const userPanel = document.getElementById('user-panel');
  const userMenu = document.getElementById('user-menu');
  if (userTrigger && userPanel && userMenu) {
    const setOpen = (open: boolean) => {
      userPanel.hidden = !open;
      userTrigger.setAttribute('aria-expanded', String(open));
    };
    userTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(userPanel.hidden);
    });
    document.addEventListener('click', (e) => {
      if (!userMenu.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

</script>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     .modern-layout frame
     ═══════════════════════════════════════════════════════════════════ */
  .modern-layout {
    /* private knobs — public tokens with literal fallbacks */
    --_topbar-h: 56px;
    --_sidenav-w: 340px;
    --_sidenav-w-collapsed: 72px;
    --_chrome-border: var(--bca-chrome-seam, #deddd4);

    display: flex;
    flex-direction: column;
    height: 100vh;
  }

  .modern-layout__body {
    display: flex;
    flex: 1;
    overflow: hidden;
    min-height: 0;
    padding-top: var(--_topbar-h, 56px); /* header height */
  }

  .modern-layout__content {
    flex: 1;
    overflow-y: auto;
    min-width: 0;
    /* min-height: 0 lets a child claim 100% height and run its own internal
       scroll (the suitability tool fills this area edge-to-edge). */
    min-height: 0;
    position: relative;
  }

  /* ═══════════════════════════════════════════════════════════════════
     topbar
     ═══════════════════════════════════════════════════════════════════ */
  .topbar {
    /* Darkest of the four shell surfaces, by one tick: ΔE 0.0215 from the
       sidenav, just over the 0.020 visible-edge floor. The bar is its own
       plane, but the two still share the Sage cast, so the shell reads as one
       frame with a lid rather than the two unrelated regions it was at 0.0783
       when the topbar was white. */
    --_topbar-bg: var(--bca-chrome-topbar, #e6e5dd);

    /* The topbar's own bottom edge runs one rung darker than the shell seam —
       sage-7, where every other chrome border is #deddd4. Under a bar that is
       now its own plane, the shared seam went soft: it reads ΔE 0.0247 against
       the topbar where sage-7 reads 0.0684. Scoped here deliberately; the
       sidenav's right edge and the panels keep --_chrome-border. */
    --_topbar-border: var(--bca-sage-7, #d0cfc4);

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--_topbar-h, 56px);
    background: var(--_topbar-bg, #f3f1ea);
    border-bottom: 1px solid var(--_topbar-border, #d0cfc4);
    z-index: 1100;

    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    padding: 0 var(--spacing-200, 0.5rem);
  }

  @media (min-width: 768px) {
    .topbar {
      padding: 0 var(--spacing-400, 1rem);
    }
  }

  .topbar__left {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
    min-width: 0;
  }

  .topbar__center {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    gap: var(--spacing-400, 1rem);
    padding: 0 var(--spacing-400, 1rem);
  }

  .topbar__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-300, 0.75rem);
  }

  /* Sidebar toggle */
  .sidebar-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: var(--radius-100, 0.25rem);
    background: transparent;
    color: var(--color-text-tertiary, #6a665e);
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
  }
  .sidebar-toggle:hover {
    background: var(--color-border-light, #ebe8e1);
    color: var(--color-primary, #234a31);
  }
  .sidebar-toggle:focus-visible {
    outline: 2px solid var(--color-primary, #234a31);
    outline-offset: 2px;
  }
  .sidebar-toggle__icon {
    transition: transform 150ms ease;
  }
  .sidebar-toggle--collapsed .sidebar-toggle__icon {
    transform: scaleX(-1);
  }

  /* ── User menu (Profile / Sign out) ── */
  .user-menu {
    position: relative;
  }
  .user-trigger {
    display: flex;
    align-items: center;
    gap: var(--spacing-250, 0.625rem);
    padding: var(--spacing-100, 0.25rem) var(--spacing-200, 0.5rem);
    border: none;
    border-radius: var(--radius-200, 0.5rem);
    background: transparent;
    cursor: pointer;
    transition: background 150ms ease;
  }
  .user-trigger:hover {
    background: var(--color-border-light, #ebe8e1);
  }
  .user-trigger:focus-visible {
    outline: 2px solid var(--color-primary, #234a31);
    outline-offset: 2px;
  }
  .user-trigger__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full, 9999px);
    /* Brand Gold, filled (Andy, 2026-08-13). Dark initials, never white:
       white on Gold is 1.60:1, Green on Gold is 6.54:1. No ring — the disc
       sits ΔE 0.1416 from the topbar, seven times the visible-edge floor, so
       it holds its own edge, and the old green ring was doing that job for a
       fill that could not. */
    background: var(--bca-brand-gold, #ffc261);
    color: var(--color-primary, #364500);
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold, 600);
    transition: box-shadow 150ms ease;
  }
  .user-trigger:hover .user-trigger__avatar {
    box-shadow: 0 0 0 2px var(--bca-gold-10, #ca8c02);
  }
  .user-trigger__name {
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-primary, #33312a);
    line-height: 1.25;
    white-space: nowrap;
  }
  .user-trigger > :global(.esa-icon:last-child) {
    flex-shrink: 0;
    color: var(--color-text-muted, #807c73);
  }

  @media (max-width: 767px) {
    .user-trigger__name {
      display: none;
    }
  }

  /* User panel (dropdown, position bottom-end) */
  .user-panel {
    position: absolute;
    top: calc(100% + var(--spacing-200, 0.5rem));
    right: 0;
    min-width: 200px;
    background: var(--color-surface, #fff);
    border-radius: var(--radius-200, 0.5rem);
    border: 1px solid var(--_chrome-border, #ddd9d0);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
    z-index: 1200;
    padding: var(--spacing-200, 0.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050, 0.125rem);
  }
  .user-panel[hidden] {
    display: none;
  }

  .user-panel__item {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
    width: 100%;
    padding: var(--spacing-250, 0.625rem) var(--spacing-300, 0.75rem);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-medium, 500);
    color: var(--color-text-primary, #33312a);
    background: transparent;
    border: none;
    border-radius: var(--radius-200, 0.5rem);
    cursor: pointer;
    text-align: left;
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .user-panel__item:hover {
    background: var(--color-surface-sunken, #f3f1ea);
  }
  .user-panel__item :global(.esa-icon) {
    color: var(--color-text-tertiary, #6a665e);
  }
  .user-panel__item--danger {
    color: var(--color-danger, #ef4444);
  }
  .user-panel__item--danger:hover {
    background: var(--color-danger-subtle, #fef2f2);
  }
  .user-panel__item--danger :global(.esa-icon) {
    color: var(--color-danger, #ef4444);
  }

  /* ═══════════════════════════════════════════════════════════════════
     side nav ($sidebar-width 300px / collapsed 72px)
     ═══════════════════════════════════════════════════════════════════ */
  .side-nav {
    --_sidenav-bg: var(--bca-chrome-sidenav, #edece5);
    --_nav-hover-bg: var(--color-active-overlay, rgba(0, 0, 0, 0.04));

    /* ── The active-item treatment. Two tokens; swap the pair. ──────────
       SHIPPED: green-4 wash + Green label, semibold (Andy asked for quieter
       than the solid slab, 2026-08-13). green-4 sits ΔE 0.0583 from the
       sidenav — roughly 3x the 0.020 visible-edge floor, so the row reads as
       filled — and Green on it measures 7.45:1.

       Read the trade honestly. The slab it replaces was 8.83:1 against the
       sidenav, so the FILL ALONE cleared WCAG 1.4.11 as a non-text state
       indicator. No tint can: green-7 is the first step over 3:1 (2.87, still
       short) and it is far too dark to carry Green text. So the state now
       rests on three changes together — fill, label color, and weight — which
       satisfies 1.4.1 (it is not color alone) and keeps label contrast high,
       but the fill by itself is no longer a 3:1 indicator. That is what
       "quieter" costs here.

       ALTERNATES — replace the two lines below, nothing else moves:
         More presence, same idea:
           --_nav-active-bg:  var(--bca-green-5);   (dE 0.1227, ink 6.06:1)
           --_nav-active-ink: var(--color-primary);
         Brand accent, warm:
           --_nav-active-bg:  var(--bca-gold-5);    (dE 0.0612, ink 8.31:1)
           --_nav-active-ink: var(--color-primary);
         Gold is the only other hue in the mark, so it reads instantly — but it
         is the one move that puts a second hue in a monochrome rail, and gold
         carries no meaning elsewhere in this system yet.
         Back to the slab: --_nav-active-bg: var(--color-primary) +
         --_nav-active-ink: var(--color-text-inverse).
       green-3 is not an option in any of these: at dE 0.0126 it is the sidenav. */
    --_nav-active-bg: var(--bca-green-4, #d6dccc);
    /* Stays primary: this also colors .nav-section__header hover and active
       text, which sit directly on the sidenav. Inverting it here would blank
       those labels. The label ON the solid fill uses --_nav-active-ink. */
    --_nav-active-color: var(--color-primary, #364500);
    --_nav-active-ink: var(--color-primary, #364500);

