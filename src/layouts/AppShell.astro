  }
  .user-trigger:hover .user-trigger__avatar {
    box-shadow: 0 0 0 2px var(--bca-gold-10, #ca8c02);
  }
  .user-trigger__name {
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-primary, #33312a);
    line-height: 1.25;
    white-space: nowrap;
  }
  .user-trigger > :global(.esa-icon:last-child) {
    flex-shrink: 0;
    color: var(--color-text-muted, #807c73);
  }

  @media (max-width: 767px) {
    .user-trigger__name {
      display: none;
    }
  }

  /* User panel (dropdown, position bottom-end) */
  .user-panel {
    position: absolute;
    top: calc(100% + var(--spacing-200, 0.5rem));
    right: 0;
    min-width: 200px;
    background: var(--color-surface, #fff);
    border-radius: var(--radius-200, 0.5rem);
    border: 1px solid var(--_chrome-border, #ddd9d0);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
    z-index: 1200;
    padding: var(--spacing-200, 0.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050, 0.125rem);
  }
  .user-panel[hidden] {
    display: none;
  }

  .user-panel__item {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
    width: 100%;
    padding: var(--spacing-250, 0.625rem) var(--spacing-300, 0.75rem);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-medium, 500);
    color: var(--color-text-primary, #33312a);
    background: transparent;
    border: none;
    border-radius: var(--radius-200, 0.5rem);
    cursor: pointer;
    text-align: left;
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .user-panel__item:hover {
    background: var(--color-surface-sunken, #f3f1ea);
  }
  .user-panel__item :global(.esa-icon) {
    color: var(--color-text-tertiary, #6a665e);
  }
  .user-panel__item--danger {
    color: var(--color-danger, #ef4444);
  }
  .user-panel__item--danger:hover {
    background: var(--color-danger-subtle, #fef2f2);
  }
  .user-panel__item--danger :global(.esa-icon) {
    color: var(--color-danger, #ef4444);
  }

  /* ═══════════════════════════════════════════════════════════════════
     side nav ($sidebar-width 300px / collapsed 72px)
     ═══════════════════════════════════════════════════════════════════ */
  .side-nav {
    --_sidenav-bg: var(--bca-chrome-sidenav, #edece5);
    --_nav-hover-bg: var(--color-active-overlay, rgba(0, 0, 0, 0.04));

    /* ── The active-item treatment. Two tokens; swap the pair. ──────────
       SHIPPED: green-4 wash + Green label, semibold (Andy asked for quieter
       than the solid slab, 2026-08-13). green-4 sits ΔE 0.0583 from the
       sidenav — roughly 3x the 0.020 visible-edge floor, so the row reads as
       filled — and Green on it measures 7.45:1.

       Read the trade honestly. The slab it replaces was 8.83:1 against the
       sidenav, so the FILL ALONE cleared WCAG 1.4.11 as a non-text state
       indicator. No tint can: green-7 is the first step over 3:1 (2.87, still
       short) and it is far too dark to carry Green text. So the state now
       rests on three changes together — fill, label color, and weight — which
       satisfies 1.4.1 (it is not color alone) and keeps label contrast high,
       but the fill by itself is no longer a 3:1 indicator. That is what
       "quieter" costs here.

       ALTERNATES — replace the two lines below, nothing else moves:
         More presence, same idea:
           --_nav-active-bg:  var(--bca-green-5);   (dE 0.1227, ink 6.06:1)
           --_nav-active-ink: var(--color-primary);
         Brand accent, warm:
           --_nav-active-bg:  var(--bca-gold-5);    (dE 0.0612, ink 8.31:1)
           --_nav-active-ink: var(--color-primary);
         Gold is the only other hue in the mark, so it reads instantly — but it
         is the one move that puts a second hue in a monochrome rail, and gold
         carries no meaning elsewhere in this system yet.
         Back to the slab: --_nav-active-bg: var(--color-primary) +
         --_nav-active-ink: var(--color-text-inverse).
       green-3 is not an option in any of these: at dE 0.0126 it is the sidenav. */
    --_nav-active-bg: var(--bca-green-4, #d6dccc);
    /* Stays primary: this also colors .nav-section__header hover and active
       text, which sit directly on the sidenav. Inverting it here would blank
       those labels. The label ON the solid fill uses --_nav-active-ink. */
    --_nav-active-color: var(--color-primary, #364500);
    --_nav-active-ink: var(--color-primary, #364500);

    width: var(--_sidenav-w, 300px);
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: var(--_sidenav-bg, #faf9f6);
    font-size: 0.9375rem;
    overflow: visible;
    transition: width 200ms ease-in-out;
    border-right: 1px solid var(--_chrome-border, #ddd9d0);
    flex-shrink: 0;
  }
  .side-nav.collapsed {
    width: var(--_sidenav-w-collapsed, 72px);
    max-width: var(--_sidenav-w-collapsed, 72px);
  }

  .sidebar-header {
    flex-shrink: 0;
    padding: var(--spacing-300, 0.75rem) var(--spacing-400, 1rem);
    transition: padding 200ms ease-in-out;
  }
  .side-nav.collapsed .sidebar-header {
    padding: var(--spacing-300, 0.75rem) var(--spacing-200, 0.5rem);
  }

  /* Brand — the symbol beside the product wordmark, one lockup.
     The institute logotype is gone (Andy, 2026-08-13): "Atlas" IS the
     logotype here. Side by side rather than stacked for two reasons. The
     header has ~72px of vertical room and Crimson Pro at display scale is a
     wide, low word, so stacking would push the first nav row down the rail.
     And laid out horizontally the collapse is honest — the word drops away
     and the symbol stays exactly where it was, rather than the pair
     reflowing. The institute keeps its credit in the img alt. */
  .brand {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-250, 0.625rem);
    padding: var(--spacing-200, 0.5rem);
    border-radius: var(--radius-200, 0.5rem);
    text-decoration: none;
    transition: background 150ms ease;
  }
  .brand:hover {
    background: var(--_nav-hover-bg, rgba(0, 0, 0, 0.04));
  }
  /* The marks are issued PNGs — dark green + gold on transparent. They sit on
     the tinted sidenav as-issued: no filter, no tint, no recolor. Width is set
     in CSS and height stays auto so the intrinsic width/height attributes fix
     the aspect ratio and nothing reflows on load. */
  .brand__logo {
    flex-shrink: 0;
    height: auto;
  }
  /* 36px in BOTH states, so the mark does not resize when the rail collapses —
     only the word leaves. It is also the floor: the symbol is a dense cluster
     with fine negative space, and below ~32px the gold star and the cutouts
     close up into a blob. */
  .brand__logo--symbol {
    width: 36px;
  }
  /* The product name — now the logotype, not a subtitle under one. Crimson Pro
     Light in ABI Green, the same treatment bca-coming-soon gives it, so the
     lockup reads the same in the chrome and on the canvas. 30px against the
     36px mark: the word leads and the symbol reads as the mark before it. */
  .brand__product {
    font-family: var(--font-display, 'Crimson Pro', Georgia, serif);
    font-weight: var(--font-weight-light, 300);
    font-size: 1.875rem; /* 30px */
    line-height: 1;
    color: var(--color-primary, #364500);
  }
  .side-nav.collapsed .brand {
    justify-content: center;
    padding: var(--spacing-200, 0.5rem) 0;
    width: 100%;
  }
  /* The 72px rail leaves 56px of usable width. "Atlas" scaled to fit lands
     under the 16px type floor, so the rail carries the symbol alone and the
     product name comes back the moment the rail expands. */
  .side-nav.collapsed .brand__product {
    display: none;
  }

  .main-nav {
    flex: 1;
    overflow-y: auto;
    overflow-x: visible;
    padding: 0 var(--spacing-400, 1rem) var(--spacing-400, 1rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-050, 0.125rem);
    transition: padding 200ms ease-in-out;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .main-nav::-webkit-scrollbar {
    display: none;
  }
  /* overflow must go fully visible on the rail, not just overflow-x: a box
     with `overflow-y: auto` computes a `visible` overflow-x to `auto` as well,
     so the declaration above does NOT let the flyout escape — it would be
     clipped at the rail's edge. Seven icon rows never need to scroll at 72px,
     so the rail gives up scrolling to gain the overhang. */
  .side-nav.collapsed .main-nav {
    padding: 0 var(--spacing-200, 0.5rem);
    overflow: visible;
  }

  .nav-section {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .nav-divider {
    flex-shrink: 0;
    height: 1px;
    margin: var(--spacing-200, 0.5rem) 0;
    border: 0;
    background: var(--_chrome-border, #ddd9d0);
  }

  .nav-section__header {
    display: flex;
    align-items: center;
    gap: var(--spacing-250, 0.625rem);
    padding: var(--spacing-250, 0.625rem) var(--spacing-200, 0.5rem);
    color: var(--color-text-primary, #33312a);
    font-size: 0.9375rem; /* 15px */
    font-weight: var(--font-weight-semibold, 600);
    border: none;
    background: transparent;
    border-radius: var(--radius-100, 0.25rem);
    transition: all 150ms ease;
    white-space: nowrap;
    width: 100%;
    text-align: left;
    cursor: pointer;
    text-decoration: none;
  }
  .nav-section__header--link {
    text-decoration: none;
    color: var(--color-text-primary, #33312a);
  }
  .nav-section__header:hover {
    background: var(--_nav-hover-bg, rgba(0, 0, 0, 0.04));
    color: var(--_nav-active-color, #234a31);
  }
  .nav-section__header:hover :global(.esa-icon) {
    color: var(--_nav-active-color, #234a31);
  }
  .nav-section--active .nav-section__header {
    color: var(--_nav-active-color, #234a31);
  }
  .nav-section--active .nav-section__header :global(.esa-icon) {
    color: var(--_nav-active-color, #234a31);
  }

  /* icon (first esa-icon in the header) */
  .nav-section__header > :global(.esa-icon:first-child) {
    flex-shrink: 0;
    color: var(--color-text-primary, #33312a);
    transition: color 150ms ease;
  }
  /* chevron (last esa-icon in the header) */
  .nav-section__header > :global(.esa-icon:last-child) {
    color: var(--color-text-muted, #807c73);
    transition: transform 150ms ease, opacity 200ms ease-in-out;
    flex-shrink: 0;
  }
  .nav-section--collapsed .nav-section__header > :global(.esa-icon:last-child) {
    transform: rotate(-90deg);
  }

  /* Phase 2 sections. The roadmap stays legible in the nav, but the header does
     not open and does not respond — muted label, muted icon, no chevron, no
     hover. That absence is the statement; a pill saying the same thing beside
     it would be the label repeating the treatment.

     Must sit AFTER the icon rule above: both selectors weigh 0,2,0, so source
     order is the only thing deciding the icon color, and placing this block
     earlier silently left the icons at full strength — which is the whole
     signal on the collapsed rail. */
  .nav-section__header--disabled,
  .nav-section__header--disabled:hover {
    color: var(--color-text-muted, #807c73);
    background: transparent;
    /* Default, not not-allowed (Andy, 2026-08-13). These sections are not
       refusing an action, they are roadmap — the muting already says so, and
       the crossed-circle reads as an error. */
    cursor: default;
  }
  .nav-section__header--disabled > :global(.esa-icon:first-child),
  .nav-section__header--disabled:hover > :global(.esa-icon:first-child) {
    color: var(--color-text-muted, #807c73);
  }

  /* title spans flex between icon and chevron */
  .nav-section__title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 200ms ease-in-out;
  }
  .side-nav.collapsed .nav-section__title {
    display: none;
  }
  .side-nav.collapsed .nav-section__header > :global(.esa-icon:last-child) {
    display: none;
  }
  .side-nav.collapsed .nav-section__header {
    justify-content: center;
    padding: var(--spacing-250, 0.625rem) var(--spacing-200, 0.5rem);
  }

  .nav-section__items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    max-height: 500px;
    opacity: 1;
    transition: max-height 200ms ease-in-out, opacity 200ms ease-in-out;
  }
  .nav-section--collapsed .nav-section__items {
    max-height: 0;
    opacity: 0;
  }

  /* ── Collapsed-rail flyouts ──────────────────────────────────────────
     On the 72px rail a section's sublinks move into a floating panel beside
     the icon. Expanded, both wrappers are `display: contents`, so the <ul>
     stays a direct flex child of .nav-section and the accordion above is
     untouched — this whole block only exists inside .side-nav.collapsed.

     bcn-lego-checked: nothing in the hub does a rail flyout. esa-sidebar-nav
     — the closest thing, an entire sidebar nav — resolves the same problem
     with `:host([collapsed]) .children { display: none }`, i.e. it drops the
     children rather than relocating them. esa-nav-dropdown is a <details>
     panel that opens BELOW its trigger (top: 100%, left: 0) off a labelled
     icon-link with a chevron: wrong axis, wrong trigger. esa-popover is
     closest mechanically (position="right", hover trigger, Esc + outside
     click) but renders role="dialog" and pins itself to `top: 50%;
     translateY(-50%)`, both inside shadow DOM and therefore unreachable — a
     submenu of links is not a dialog, and a 4-item panel centred on a 44px
     icon row hangs above and below it. Checked Ecology + Beacon; the reusable
     home is a hub-level rail flyout. Filed in NEEDS.md. */
  .nav-flyout,
  .nav-flyout__panel {
    display: contents;
  }
  .nav-flyout__title {
    display: none;
  }

  .side-nav.collapsed .nav-flyout {
    display: block;
    position: absolute;
    top: 0;
    left: 100%;
    z-index: 1000;
    /* Transparent, and the reason the flyout is two elements: the pointer has
       to cross this gap to reach the panel, so the gap belongs INSIDE the
       hover target rather than between the icon and the panel. Measured from
       the section, not the rail — .main-nav's 8px padding means the panel
       lands ~8px short of where this number suggests. */
    padding-left: var(--spacing-500, 1.5rem);
    visibility: hidden;
    opacity: 0;
    transition: opacity 120ms ease, visibility 120ms;
  }
  /* :focus-within is what makes this keyboard-reachable. The links are
     visibility:hidden and therefore untabbable until the panel opens — but
     focusing the section's own header (which is always visible) opens it,
     and from there the links are in the tab order. Tabbing off the last one
     drops focus out of the section and closes it. */
  .side-nav.collapsed .nav-section:hover .nav-flyout,
  .side-nav.collapsed .nav-section:focus-within .nav-flyout {
    visibility: visible;
    opacity: 1;
  }
  .side-nav.collapsed .nav-flyout__panel {
    display: block;
    min-width: 208px;
    padding: var(--spacing-200, 0.5rem);
    background: var(--color-surface, #fafaf7);
    border: 1px solid var(--_chrome-border, #deddd4);
    border-radius: var(--radius-200, 0.5rem);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.12);
  }
  /* The rail has no room for the section title, so the panel carries it —
     otherwise the flyout is a list of links with nothing naming the group. */
  .side-nav.collapsed .nav-flyout__title {
    display: block;
    padding: var(--spacing-150, 0.375rem) var(--spacing-200, 0.5rem);
    font-size: 1rem;
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-primary, #21201c);
  }
  /* The accordion's own collapsed state must not follow the items into the
     panel — inside a flyout the list is always open. */
  .side-nav.collapsed .nav-flyout .nav-section__items {
    max-height: none;
    opacity: 1;
  }
  .side-nav.collapsed .nav-flyout .nav-item {
    padding-left: 0;
  }

  /* Indent is shallower than Beacon's 2.5rem — items carry their own icons
     (or sit one level under an iconed section header), which do the hierarchy
     work without eating label width. */
  .nav-item {
    padding: 0 0 0 var(--spacing-300, 0.75rem);
  }
  .nav-item + .nav-item {
    margin-top: var(--spacing-050, 0.125rem);
  }

  .nav-sublink {
    display: flex;
    align-items: center;
    gap: var(--spacing-250, 0.625rem);
    padding: var(--spacing-200, 0.5rem);
    color: var(--color-text-secondary, #54514a);
    text-decoration: none;
    border-radius: var(--radius-100, 0.25rem);
    font-size: 0.9375rem; /* 15px — nav items stay ≥14px */
    transition: all 150ms ease;
    line-height: 1.2;
  }
  .nav-sublink :global(.esa-icon) {
    flex-shrink: 0;
    color: var(--color-text-tertiary, #6a665e);
    transition: color 150ms ease;
  }
  .nav-sublink__label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .nav-sublink:hover {
    background: var(--_nav-hover-bg, rgba(0, 0, 0, 0.04));
    color: var(--color-text-primary, #33312a);
  }
  /* Active = tint fill + Green label + semibold (no left-border indicator).
     All three change together; see the token block on .side-nav for why the
     fill alone is no longer doing the work. */
  .nav-sublink.active {
    background: var(--_nav-active-bg, #d6dccc);
    color: var(--_nav-active-ink, #364500);
    font-weight: var(--font-weight-semibold, 600);
  }
  .nav-sublink.active :global(.esa-icon) {
    color: var(--_nav-active-ink, #364500);
  }
  /* Pins the active row against hover. `.nav-sublink.active` and
     `.nav-sublink:hover` both weigh 0,2,0, so today the active rule wins only
     because it happens to come later — this states the intent instead of
     depending on that. */
  .nav-sublink.active:hover {
    background: var(--_nav-active-bg, #d6dccc);
    color: var(--_nav-active-ink, #364500);
  }

  /* Ghosted roadmap items */
  .nav-sublink--disabled {
    color: var(--color-text-muted, #807c73);
    cursor: default;
  }
  .nav-sublink--disabled :global(.esa-icon) {
    color: var(--color-text-muted, #807c73);
  }
  .nav-sublink--disabled:hover {
    background: transparent;
    color: var(--color-text-muted, #807c73);
  }

