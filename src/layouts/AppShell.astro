  }
  .user-trigger:hover {
    background: var(--color-border-light, #ebe8e1);
  }
  .user-trigger:focus-visible {
    outline: 2px solid var(--color-primary, #234a31);
    outline-offset: 2px;
  }
  .user-trigger__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full, 9999px);
    /* Brand Gold, filled (Andy, 2026-08-13). Dark initials, never white:
       white on Gold is 1.60:1, Green on Gold is 6.54:1. No ring — the disc
       sits ΔE 0.1416 from the topbar, seven times the visible-edge floor, so
       it holds its own edge, and the old green ring was doing that job for a
       fill that could not. */
    background: var(--bca-brand-gold, #ffc261);
    color: var(--color-primary, #364500);
