---
// AppShell — the Biochar Atlas frame, ported from beacon-design's AppShell
// (itself a verbatim port of Beacon's Angular "modern-layout"):
//   .modern-layout (topbar + body[sidenav + content]) · BEM classes, sidebar
//   collapse, nav-section expand/collapse, dropdown open/close — all kept.
//
// Biochar changes vs Beacon:
//   - Tokens: every --bcn-* swapped for semantic (--color-*) or spoke (--bca-*)
//     tokens from theme-biochar.css, always with literal fallbacks.
//   - Sidebar header: the issued ABI brand mark over the product wordmark —
//     institute lockup + "Atlas" when expanded, the symbol alone on the
//     collapsed rail. Beacon's project-switcher is dropped.
//   - Nav: data-driven NavSections. The four planned Atlas modules are TOP-LEVEL
//     sections rendered inert — muted, no chevron, no sublist — so the roadmap
//     stays visible without competing with the one live section.
//   - Topbar: sidebar toggle on the left, global search in the center, a simple
//     user menu (Profile / Sign out) on the right. No page heading, no badges.
import BaseLayout from './BaseLayout.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';
import BcaGlobalSearch from '../components/bca/bca-global-search.astro';
import { withBase } from '../lib/base';

interface NavItem {
  id: string;
  label: string;
  /** Real route (already withBase'd). Defaults to the `#id` stub when absent. */
  href?: string;
  /** Lucide glyph key — esa-icon registry name or LUCIDE entry below. */
  icon?: string;
  /** Inline Lucide path markup override for glyphs not in either lookup. */
  iconPaths?: string;
  active?: boolean;
  /** Ghosted roadmap item — muted, not-allowed cursor, no navigation. */
  disabled?: boolean;
}
interface NavSection {
  id: string;
  title: string;
  icon: string;
  /** Inline Lucide path markup for glyphs not in esa-icon's registry. */
  iconPaths?: string;
  items?: NavItem[];
  /** Single-link section (no sublist). */
  link?: boolean;
  expanded?: boolean;
  active?: boolean;
  dividerAfter?: boolean;
  /**
   * Whole section is inert: the header renders muted with no chevron and does
   * not open. `items` stay in the data as the roadmap record — flipping this
   * flag is what renders them.
   */
  disabled?: boolean;
}
interface Props {
  title?: string;
  navSections?: NavSection[];
  /** NavItem id to highlight (overrides the static default, Suitability Tool). */
  activeNavId?: string;
  /** Section ids to render expanded (overrides the per-section `expanded` defaults when provided). */
  expandedSections?: string[];
}

// ── Lucide glyphs not in esa-icon's built-in registry (inner SVG markup only) ──
const LUCIDE = {
  // section icons
  'map-pinned':
    '<path d="M18 8c0 3.613-3.869 7.429-5.393 8.795a1 1 0 0 1-1.214 0C9.87 15.429 6 11.613 6 8a6 6 0 0 1 12 0"/><circle cx="12" cy="8" r="2"/><path d="M8.714 14h-3.71a1 1 0 0 0-.948.683l-2.004 6A1 1 0 0 0 3 22h18a1 1 0 0 0 .948-1.316l-2-6a1 1 0 0 0-.949-.684h-3.712"/>',
  // Suitability items
  'map-pin':
    '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
  'columns-2': '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M12 3v18"/>',
  bookmark: '<path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/>',
  calculator:
    '<rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>',
  // Atlas-module sections (database lives in esa-icon's registry)
  store:
    '<path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7v3a2 2 0 0 1-2 2a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7"/>',
  'book-open':
    '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  'clipboard-check':
    '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>',
  // About section
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  'file-text':
    '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  'folder-open':
    '<path d="m6 14 1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H18a2 2 0 0 1 2 2v2"/>',
  // Admin items
  archive:
    '<rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/>',
  'refresh-cw':
    '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
  'git-branch':
    '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
  // user menu
  user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  'log-out':
    '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/>',
};

const {
  title = 'Biochar Suitability Tool',
  activeNavId,
  expandedSections,
  // Default nav: the live Suitability section, then the four planned Atlas
  // modules as inert top-level sections, then About and Admin. The roadmap is
  // deliberately visible but unopenable — no pill says so, the muted header and
  // the missing chevron do.
  navSections = [
    {
      id: 'suitability',
      title: 'Suitability',
      icon: 'map-pinned',
      iconPaths: LUCIDE['map-pinned'],
      expanded: true,
      dividerAfter: true,
      items: [
        {
          id: 'suitability-tool',
          label: 'Suitability Tool',
          icon: 'map-pin',
          href: withBase('/suitability-tool'),
          active: true,
        },
        { id: 'scenario-comparison', label: 'Scenario Comparison', icon: 'columns-2', disabled: true },
        { id: 'saved-assessments', label: 'Saved Assessments', icon: 'bookmark', disabled: true },
        { id: 'cps-336-calculator', label: 'CPS 336 Calculator', icon: 'calculator', disabled: true },
      ],
    },
    {
      id: 'sourcing',
      title: 'Sourcing',
      icon: 'store',
      iconPaths: LUCIDE['store'],
      disabled: true,
      items: [
        { id: 'find-suppliers', label: 'Find Suppliers', disabled: true },
        { id: 'compare-materials', label: 'Compare Materials', disabled: true },
        { id: 'supplier-directory', label: 'Supplier Directory', disabled: true },
      ],
    },
    {
      id: 'learning-center',
      title: 'Learning Center',
      icon: 'book-open',
      iconPaths: LUCIDE['book-open'],
      disabled: true,
      items: [
        { id: 'biochar-basics', label: 'Biochar Basics', disabled: true },
        { id: 'fact-sheets-videos', label: 'Fact Sheets & Videos', disabled: true },
        { id: 'training-ceus', label: 'Training & CEUs', disabled: true },
      ],
    },
    {
      id: 'nrcs-implementation',
      title: 'NRCS Implementation',
      icon: 'clipboard-check',
      iconPaths: LUCIDE['clipboard-check'],
      disabled: true,
      items: [
        { id: 'practice-planning', label: 'Practice Planning (CPS 336)', disabled: true },
        { id: 'cost-payment-estimator', label: 'Cost & Payment Estimator', disabled: true },
        { id: 'monitoring-risk', label: 'Monitoring & Risk Guidance', disabled: true },
      ],
    },
    {
      id: 'deployment-database',
      title: 'Deployment Database',
      icon: 'database',
      disabled: true,
      dividerAfter: true,
      items: [
        { id: 'field-trials', label: 'Field Trials', disabled: true },
        { id: 'outcomes-explorer', label: 'Outcomes Explorer', disabled: true },
        { id: 'submit-trial-data', label: 'Submit Trial Data', disabled: true },
      ],
    },
    {
      id: 'about',
      title: 'About',
      icon: 'info',
      iconPaths: LUCIDE['info'],
      expanded: false,
      items: [
        { id: 'methodology', label: 'Methodology', icon: 'file-text', href: '#' },
        { id: 'resources', label: 'Resources', icon: 'folder-open', href: '#' },
      ],
    },
    {
      id: 'admin',
      title: 'Admin',
      icon: 'settings',
      expanded: false,
      items: [
        { id: 'admin-catalog', label: 'Biochar Catalog', icon: 'archive', href: '#' },
        { id: 'datasets-refresh', label: 'Datasets & Refresh', icon: 'refresh-cw', href: '#' },
        { id: 'algorithm-versions', label: 'Algorithm Versions', icon: 'git-branch', href: '#' },
      ],
    },
  ],
} = Astro.props as Props;

// Per-page section expansion — when provided, a section is expanded iff its id is listed.
if (expandedSections) {
  for (const section of navSections) {
    section.expanded = expandedSections.includes(section.id);
  }
}

// Per-page nav highlight — activeNavId beats the static default (Suitability Tool).
// Disabled (roadmap) items never highlight.
if (activeNavId) {
  for (const section of navSections) {
    let hit = false;
    for (const item of section.items ?? []) {
      item.active = !item.disabled && item.id === activeNavId;
      if (item.active) hit = true;
    }
    section.active = hit;
  }
}
---

<BaseLayout title={title}>
  <div class="modern-layout">
    <!-- ═══ TOPBAR ═══ -->
    <header class="topbar">
      <!-- Left: sidebar toggle -->
      <div class="topbar__left">
        <!-- bcn-lego-checked: esa-icon-button cannot host this control, and the
             reasons are structural rather than stylistic. It renders exactly
             `<Tag class aria-label title><EsaIcon name size/></Tag>` with no
             rest-spread, so (a) there is no `id` for the script's hook, (b) it
             cannot carry `aria-expanded`, which a disclosure control must ship
             in server-rendered markup rather than acquire on first click, (c) it
             forwards no `paths`, and this glyph — Lucide `panel-left` — is not
             in esa-icon's built-in registry, and (d) the icon mirrors on state
             via .sidebar-toggle__icon, and the lego exposes no hook on its inner
             icon. Beacon hit (c) for its ESA-Config control and hit ALL of these
             for its own sidebar toggle: beacon-design/src/layouts/AppShell.astro
             ships the identical hand-rolled button and reserves EsaIconButton
             for its plain admin link. Checked Ecology + Beacon; the reusable
             home for this is a hub-level esa-disclosure-button that does not
             exist yet. Filed in NEEDS.md. -->
        <button
          type="button"
          class="sidebar-toggle"
          id="sidebar-toggle"
          aria-label="Collapse sidebar"
          aria-expanded="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="sidebar-toggle__icon"
          >
            <rect width="18" height="18" x="3" y="3" rx="2" />
            <path d="M9 3v18" />
          </svg>
        </button>
      </div>

      <!-- Center: global search -->
      <div class="topbar__center">
        <BcaGlobalSearch />
      </div>

      <!-- Right: user menu -->
      <div class="topbar__right">
        <div class="user-menu" id="user-menu">
          <button
            type="button"
            class="user-trigger"
            id="user-trigger"
            aria-haspopup="menu"
            aria-expanded="false"
          >
            <span class="user-trigger__avatar">TC</span>
            <span class="user-trigger__name">Tim Creed</span>
            <EsaIcon name="chevron-down" size="xs" />
          </button>

          <div class="user-panel" id="user-panel" hidden>
            <a href="#" class="user-panel__item">
              <EsaIcon name="user" size="sm" paths={LUCIDE['user']} />
              <span>Profile</span>
            </a>
            <button type="button" class="user-panel__item user-panel__item--danger">
              <EsaIcon name="log-out" size="sm" paths={LUCIDE['log-out']} />
              <span>Sign out</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══ BODY (sidenav + content) ═══ -->
    <div class="modern-layout__body">
      <!-- ─── side nav ─── -->
      <!-- Expanded by default: the nav hierarchy, the Atlas lockup and the
           inert roadmap sections are the demo. Collapsed-first hid all three
           behind a click. -->
      <nav class="side-nav" id="side-nav">
        <div class="sidebar-header">
          <a href={withBase('/')} class="brand" aria-label="Atlas — American Biochar Institute">
            <img
              class="brand__logo brand__logo--symbol"
              src={withBase('/abi-logo-symbol-alpha.png')}
              width="1240"
              height="1246"
              alt="American Biochar Institute"
            />
            <span class="brand__product">Atlas</span>
          </a>
        </div>

        <div class="main-nav">
          {
            navSections.map((section) => (
              <>
                {section.disabled ? (
                  <div class="nav-section">
                    <div class="nav-section__header nav-section__header--disabled" aria-disabled="true">
                      <EsaIcon
                        name={section.icon}
                        size="sm"
                        paths={section.iconPaths ?? LUCIDE[section.icon as keyof typeof LUCIDE]}
                      />
                      <span class="nav-section__title">{section.title}</span>
                    </div>
                  </div>
                ) : section.link ? (
                  <div class:list={['nav-section', { 'nav-section--active': section.active }]}>
                    <a href={`#${section.id}`} class="nav-section__header nav-section__header--link">
                      <EsaIcon
                        name={section.icon}
                        size="sm"
                        paths={section.iconPaths ?? LUCIDE[section.icon as keyof typeof LUCIDE]}
                      />
                      <span class="nav-section__title">{section.title}</span>
                    </a>
                  </div>
                ) : (
                  <div
                    class:list={[
                      'nav-section',
                      { 'nav-section--collapsed': !section.expanded, 'nav-section--active': section.active },
                    ]}
                  >
                    <button type="button" class="nav-section__header" aria-expanded={section.expanded ? 'true' : 'false'}>
                      <EsaIcon
                        name={section.icon}
                        size="sm"
                        paths={section.iconPaths ?? LUCIDE[section.icon as keyof typeof LUCIDE]}
                      />
                      <span class="nav-section__title">{section.title}</span>
                      <EsaIcon name="chevron-down" size="sm" />
                    </button>
                    <div class="nav-flyout">
                    <div class="nav-flyout__panel">
                    <span class="nav-flyout__title">{section.title}</span>
                    <ul class="nav-section__items">
                      {section.items?.map((item) => (
                        <li class="nav-item">
                          {item.disabled ? (
                            <span class="nav-sublink nav-sublink--disabled" aria-disabled="true">
                              {item.icon && (
                                <EsaIcon
                                  name={item.icon}
                                  size="sm"
                                  paths={item.iconPaths ?? LUCIDE[item.icon as keyof typeof LUCIDE]}
                                />
                              )}
                              <span class="nav-sublink__label">{item.label}</span>
                            </span>
                          ) : (
                            <a href={item.href ?? `#${item.id}`} class:list={['nav-sublink', { active: item.active }]}>
                              {item.icon && (
                                <EsaIcon
                                  name={item.icon}
                                  size="sm"
                                  paths={item.iconPaths ?? LUCIDE[item.icon as keyof typeof LUCIDE]}
                                />
                              )}
                              <span class="nav-sublink__label">{item.label}</span>
                            </a>
                          )}
                        </li>
                      ))}
                    </ul>
                    </div>
                    </div>
                  </div>
                )}
                {section.dividerAfter && <hr class="nav-divider" aria-hidden="true" />}
              </>
            ))
          }
        </div>
      </nav>

      <!-- content -->
      <div class="modern-layout__content">
        <slot />
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  // Sidebar collapse toggle + chevron mirroring + user panel open/close.
  // Same contracts as Beacon's AppShell (onToggleSidebar + ui-dropdown).
  const toggle = document.getElementById('sidebar-toggle');
  const sideNav = document.getElementById('side-nav');
  if (toggle && sideNav) {
    toggle.addEventListener('click', () => {
      const collapsed = sideNav.classList.toggle('collapsed');
      toggle.classList.toggle('sidebar-toggle--collapsed', collapsed);
      toggle.setAttribute('aria-expanded', String(!collapsed));
      toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
    });
  }

  // Nav-section expand/collapse (expanded sidebar only).
  document.querySelectorAll<HTMLButtonElement>('button.nav-section__header').forEach((btn) => {
    btn.addEventListener('click', () => {
      const section = btn.closest('.nav-section');
      if (!section) return;
      const nowCollapsed = section.classList.toggle('nav-section--collapsed');
      btn.setAttribute('aria-expanded', String(!nowCollapsed));
    });
  });

  // Keep aria-expanded honest for the collapsed-rail flyouts. CSS does the
  // showing (:hover / :focus-within), which a static attribute cannot describe,
  // so the same header button that reports the accordion state when the rail is
  // open reports the flyout state when it is closed. Only aria-expanded is set:
  // aria-haspopup would advertise a menu widget, and these are plain links with
  // no menu-item keyboard model behind them.
  document.querySelectorAll<HTMLElement>('.nav-section').forEach((section) => {
    const btn = section.querySelector<HTMLElement>('.nav-section__header');
    if (!btn || !section.querySelector('.nav-flyout')) return;
    const sync = (open: boolean) => {
      if (!sideNav?.classList.contains('collapsed')) return;
      btn.setAttribute('aria-expanded', String(open));
    };
    section.addEventListener('mouseenter', () => sync(true));
    section.addEventListener('mouseleave', () => sync(false));
    section.addEventListener('focusin', () => sync(true));
    section.addEventListener('focusout', (e) => {
      if (!section.contains(e.relatedTarget as Node)) sync(false);
    });
  });

  // User menu dropdown (outside-click + Escape close, like Beacon's user menu).
  const userTrigger = document.getElementById('user-trigger');
  const userPanel = document.getElementById('user-panel');
  const userMenu = document.getElementById('user-menu');
  if (userTrigger && userPanel && userMenu) {
    const setOpen = (open: boolean) => {
      userPanel.hidden = !open;
      userTrigger.setAttribute('aria-expanded', String(open));
    };
    userTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(userPanel.hidden);
    });
    document.addEventListener('click', (e) => {
      if (!userMenu.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

</script>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     .modern-layout frame
     ═══════════════════════════════════════════════════════════════════ */
  .modern-layout {
    /* private knobs — public tokens with literal fallbacks */
    --_topbar-h: 56px;
    --_sidenav-w: 340px;
    --_sidenav-w-collapsed: 72px;
    --_chrome-border: var(--bca-chrome-seam, #deddd4);

    display: flex;
    flex-direction: column;
    height: 100vh;
  }

  .modern-layout__body {
    display: flex;
    flex: 1;
    overflow: hidden;
    min-height: 0;
    padding-top: var(--_topbar-h, 56px); /* header height */
  }

  .modern-layout__content {
    flex: 1;
    overflow-y: auto;
    min-width: 0;
    /* min-height: 0 lets a child claim 100% height and run its own internal
       scroll (the suitability tool fills this area edge-to-edge). */
    min-height: 0;
    position: relative;
  }

  /* ═══════════════════════════════════════════════════════════════════
     topbar
     ═══════════════════════════════════════════════════════════════════ */
  .topbar {
    /* Darkest of the four shell surfaces, by one tick: ΔE 0.0215 from the
       sidenav, just over the 0.020 visible-edge floor. The bar is its own
       plane, but the two still share the Sage cast, so the shell reads as one
       frame with a lid rather than the two unrelated regions it was at 0.0783
       when the topbar was white. */
    --_topbar-bg: var(--bca-chrome-topbar, #e6e5dd);

    /* The topbar's own bottom edge runs one rung darker than the shell seam —
       sage-7, where every other chrome border is #deddd4. Under a bar that is
       now its own plane, the shared seam went soft: it reads ΔE 0.0247 against
       the topbar where sage-7 reads 0.0684. Scoped here deliberately; the
       sidenav's right edge and the panels keep --_chrome-border. */
    --_topbar-border: var(--bca-sage-7, #d0cfc4);

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--_topbar-h, 56px);
    background: var(--_topbar-bg, #f3f1ea);
    border-bottom: 1px solid var(--_topbar-border, #d0cfc4);
    z-index: 1100;

    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    padding: 0 var(--spacing-200, 0.5rem);
  }

  @media (min-width: 768px) {
    .topbar {
      padding: 0 var(--spacing-400, 1rem);
    }
  }

  .topbar__left {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
    min-width: 0;
  }

  .topbar__center {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    gap: var(--spacing-400, 1rem);
    padding: 0 var(--spacing-400, 1rem);
  }

  .topbar__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--spacing-300, 0.75rem);
  }

  /* Sidebar toggle */
  .sidebar-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
