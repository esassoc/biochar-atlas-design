---
// Thin spoke wrapper around @esa/docs DocsShell. The shell (sidebar, topbar,
// "On this page" rail, all CSS + scroll-spy) is shared with the hub and every
// other spoke; this wrapper supplies only the Biochar-specific axes: the brand
// theme CSS, the ABI brand font links, the brand chrome, and the nav data.
// Import DocsShell FIRST — it pulls in @esa/tokens (the :root primitives +
// default teal semantics). The theme CSS must load AFTER so it wins: a
// [data-theme] block and :root have equal specificity, so source order decides.
import DocsShell from '@esa/docs/DocsShell.astro';
import '../styles/theme-biochar.css';
import { allGroups } from '../data/ds-nav';
import { withBase } from '../lib/base';

interface Props {
  title?: string;
  activeHref?: string; // base-less, e.g. "/design-system/foundations/color"
}
const { title = 'Biochar Atlas — Design System', activeHref = '' } = Astro.props;
---
<DocsShell
  title={title}
  activeHref={activeHref}
  groups={allGroups}
  theme="biochar"
  brandName="Biochar Atlas"
  brandTag="Design System"
  brandHref="/design-system"
>
  <img
    slot="brand-mark"
    class="brand-mark-img"
    src={withBase('/abi-logo-symbol-alpha.png')}
    width="1240"
    height="1246"
    alt="American Biochar Institute"
  />

  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=Crimson+Pro:wght@300;400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <a class="topbar-action" slot="topbar-actions" href={withBase('/')}>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    Prototype Library
  </a>

  <slot />
</DocsShell>

<style>
  .brand-mark-img { width: 100%; height: auto; display: block; }

  /* DocsShell emits the brand row as three flat flex siblings — mark, name,
     tag — so name and tag compete for one line and both wrap in a 264px
     sidebar. There is no text wrapper to target, so the row gets re-laid as a
     two-column grid from here: the mark spans both rows and centers against
     them, and name over tag becomes the second column's stack. Descendant
     selectors keep these above the hub's single-class rules regardless of
     bundle order. */
  :global(.sidebar .brand) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: center;
    /* The shell's `gap` shorthand sets both axes; left alone its 10px lands
       between the two lines and they stop reading as one lockup. */
    row-gap: 0;
    column-gap: var(--spacing-250, 0.625rem);
  }
  /* 32px is the floor the app shell states for this mark: below it the gold
     star and the cutouts close into a blob. Stacking the text is what buys the
     room to hold that floor — the previous fix shrank the mark to 26px to stop
     the wrap. */
  :global(.sidebar .brand .brand-mark-slot) {
    grid-row: 1 / span 2;
    align-self: center;
    width: 32px;
    height: 32px;
  }
  /* Both lines tighten from the shell's 1.6 body leading: at 1.6 the stack is
     44.8px in a 56px row and crowds the divider. */
  :global(.sidebar .brand b) {
    grid-column: 2;
    align-self: end;
    line-height: 1.2;
  }
  :global(.sidebar .brand .ver) {
    grid-column: 2;
    align-self: start;
    line-height: 1.3;
  }
</style>
