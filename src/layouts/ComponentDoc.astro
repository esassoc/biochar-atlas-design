---
// Per-component doc page wrapper — breadcrumbs, title, type/import meta, then
// slotted specimens. Mirrors the Ecology ComponentDoc, scoped to the Biochar
// design-system routes. The component itself is inherited from @esa/ecology;
// this page just documents how it looks wearing the Biochar Atlas skin.
import DocsLayout from './DocsLayout.astro';
import { withBase } from '../lib/base';

interface Props {
  name: string;          // display name, e.g. "Button"
  category: string;      // sidebar group, e.g. "Forms"
  slug: string;          // component basename, e.g. "esa-button"
  type: '.astro' | 'wc'; // .astro template vs Lit web component
  summary: string;
  /**
   * Where the component comes from. Inherited components are the hub's,
   * documented here wearing the Atlas skin; spoke components are this repo's
   * own and are imported by path.
   */
  origin?: 'inherited' | 'spoke';
}
const { name, category, slug, type, summary, origin = 'inherited' } = Astro.props;

const activeHref = `/design-system/components/${slug}`;
const pascal = slug.split('-').map((p) => p.charAt(0).toUpperCase() + p.slice(1)).join('');
const source = origin === 'spoke' ? `../../components/bca/${slug}.astro` : `@esa/ecology/${slug}`;
const importLine =
  type === '.astro'
    ? `import ${pascal} from '${origin === 'spoke' ? source : `${source}.astro`}';`
    : `import '${source}';`;
---
<DocsLayout title={`${name} — Biochar Atlas`} activeHref={activeHref}>
  <nav class="crumbs">
    <a href={withBase('/design-system')}>Biochar Atlas</a> <span>/</span>
    <span>{category}</span> <span>/</span> <span>{name}</span>
  </nav>
  <h1>{name}</h1>
  <p class="lede" set:html={summary} />
  <div class="meta-row">
    {/* Plain pill, not the shell's `pill--stable`. That modifier tints itself
        with the success tokens, which put a pale green fill behind a word that
        states provenance rather than health — and pale green is not an accent
        this brand uses. The status tints stay available for actual status. */}
    <span class="pill">{origin === 'spoke' ? 'Spoke' : 'Inherited'}</span>
    <span class="pill">{type}</span>
    <code class="imp">{importLine}</code>
  </div>
  <slot />
</DocsLayout>
