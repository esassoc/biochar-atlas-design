---
// Biochar Atlas base layout — wires the hub tokens + the Biochar theme, loads
// the ABI brand faces (Inter + Crimson Pro) and JetBrains Mono for data values,
// and sets data-theme="biochar" so every inherited esa-* component re-skins.
import '@esa/tokens/tokens.css';
import '@esa/tokens/component-tokens.css';
// The hub's composition layer — layout primitives (.stack/.cluster/.repel/.grid)
// and type roles (.typography-body-md/.typography-label/…). Opt-in classes, so loading them
// restyles nothing; they are what keeps a page a manifest instead of bespoke CSS.
import '@esa/tokens/layouts.css';
import '@esa/tokens/type-roles.css';
import '../styles/theme-biochar.css';
import { withBase } from '../lib/base';
// Runtime handoff inspector (hub package) — self-gating: dormant unless the
// current route has a bundle at public/handoff/<slug>/.
import HandoffInspector from '@esa/handoff/HandoffInspector.astro';

interface Props {
  title?: string;
}
const { title = 'Biochar Atlas' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="biochar">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=Crimson+Pro:wght@300;400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--typography-font-family-sans, system-ui, sans-serif);
        font-weight: var(--typography-font-weight-regular, 400);
        color: var(--color-content-default, #21201c);
        /* Canvas, not card — the shell's content region has no background of
           its own, so the body IS the canvas the topbar and sidebar sit on. */
        background: var(--color-background-default, #f6f5f4);
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--color-content-link, #45173d); text-decoration: none; }
      img { display: block; max-width: 100%; }
      button { font-family: inherit; cursor: pointer; background: none; border: 0; }
    </style>
  </head>
  <body>
    <slot />
    <HandoffInspector />
  </body>
</html>
