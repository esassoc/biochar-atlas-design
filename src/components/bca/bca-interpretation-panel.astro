---
// bca-interpretation-panel — "Field readiness": the NRCS "Dynamic Soil
// Properties Response to Biochar" layer (interpretation.ts), answering the first
// of the tool's two questions — "is this field a good candidate for biochar?"
// (the second — "which biochar?" — is the comparison downstream).
//
// Two tiers (quick-screen vs. pro):
//   • COMPACT summary, inline in Step 1 — verdict class + plain-language why +
//     any limitations biochar can't fix + a "View factors" trigger.
//   • DETAIL drawer (esa-side-dialog) — the response meter, the tile-drainage
//     gate, and the 13 toggleable criteria (7 dynamic membership factors + 6
//     use-invariant constraints). The Suitability Tool script re-runs
//     interpretSite() and patches this DOM on field switch, factor toggle, and
//     tile toggle.
//
// bcn-lego-checked: composes esa-side-dialog (detail drawer) + esa-button
// (drawer trigger) + esa-switch-toggle (tile gate + per-factor toggles). The
// verdict summary, response meter, band tints, and criterion rows are a bespoke
// interpretation readout with no esa- equivalent — bca-interpretation-panel is
// the reusable home.
import EsaButton from '@esa/ecology/esa-button.astro';
import type { InterpretationResult } from '../../data/interpretation';

interface Props {
  result: InterpretationResult;
}
const { result } = Astro.props;
const dynamic = result.criteria.filter((c) => c.group === 'dynamic');
const constraints = result.criteria.filter((c) => c.group === 'constraint');
// Dynamic factors are rated by IMPROVEMENT BENEFIT (green = lots to gain, not
// "healthy"); constraints keep the NRCS suitability words. Avoids the green-reads-
// as-fine misread flagged in review.
const bandLabel = (b: string, group: string): string =>
  group === 'dynamic'
    ? b === 'well'
      ? 'High benefit'
      : b === 'moderate'
        ? 'Some benefit'
        : 'Low benefit'
    : b === 'well'
      ? 'Clear'
      : b === 'moderate'
        ? 'Caution'
        : 'Limiting';
---

<section class="bca-fr" data-site-panel data-site-verdict={result.verdict} aria-label="Field readiness">
  <!-- ── compact summary (inline in Step 1) ── -->
  <div class="bca-fr__top">
    <span class="bca-fr__kicker">Field readiness</span>
    <span class="bca-fr__source mono">ARS model · {result.rulesetLabel}</span>
  </div>
  <div class="bca-fr__verdict">
    <span class="bca-fr__class" data-site-label>{result.verdictLabel}</span>
    <span class="bca-fr__filtered" data-site-filtered hidden></span>
  </div>
  <div class="bca-fr__metric">
    <span class="bca-fr__metric-label">Response potential</span>
    <span class="bca-fr__score"><strong data-site-score>{result.responseScore}</strong><span>/100</span></span>
  </div>
  <div class="bca-fr__meter" data-site-meter><i style={`width:${result.responseScore}%`}></i></div>
  <p class="bca-fr__narrative" data-site-narrative>{result.narrative}</p>
  <ul class="bca-fr__flags" data-site-flags hidden={result.flags.length === 0}>
    {result.flags.map((f) => <li class="bca-fr__flag">{f}</li>)}
  </ul>
  <div class="bca-fr__tile">
    <esa-switch-toggle id="tile-toggle" size="sm" label="Field is artificially drained (tiled)"></esa-switch-toggle>
    <p class="bca-fr__hint">Disables ponding / depth-to-water-table — they don't apply on tiled ground.</p>
  </div>
  <span id="view-factors-btn" class="bca-fr__view">
    <EsaButton color="ghost" appearance="outline" size="sm" icon="arrow-right">
      View {result.criteria.length} factors
    </EsaButton>
  </span>

  <!-- ── detail drawer ── -->
  <esa-side-dialog id="factors-dialog" heading="Field readiness" position="right" size="lg" show-close-button>
    <div class="bca-fr__detail">
      <div class="bca-fr__head">
        <span class="bca-fr__class" data-site-label>{result.verdictLabel}</span>
        <span class="bca-fr__score">
          <strong data-site-score>{result.responseScore}</strong><span>/100 response potential</span>
        </span>
      </div>
      <div class="bca-fr__meter" data-site-meter><i style={`width:${result.responseScore}%`}></i></div>
      <p class="bca-fr__detail-narrative" data-site-narrative>{result.narrative}</p>

      <div class="bca-fr__group">
        <h4 class="bca-fr__group-head">Dynamic soil properties <span>biochar can improve these</span></h4>
        <ul class="bca-fr__factors">
          {dynamic.map((c) => (
            <li class="bca-row" data-criterion={c.key} data-band={c.band} class:list={[{ 'is-off': !c.active }]}>
              <esa-switch-toggle class="bca-row__toggle" data-factor-toggle={c.key} size="xs" checked={c.active}></esa-switch-toggle>
              <div class="bca-row__body">
                <span class="bca-row__name">{c.label}</span>
                <span class="bca-row__impact">{c.impact}</span>
              </div>
              <div class="bca-row__readout">
                <span class="bca-row__value mono" data-crit-value>{c.valueText}</span>
                <span class="bca-row__band" data-crit-band>{bandLabel(c.band, c.group)}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="bca-fr__group">
        <h4 class="bca-fr__group-head">Site constraints <span>biochar can't change these</span></h4>
        <ul class="bca-fr__factors">
          {constraints.map((c) => (
            <li
              class="bca-row"
              data-criterion={c.key}
              data-band={c.band}
              class:list={[{ 'is-off': !c.active, 'is-disabled': c.disabled }]}
            >
              <esa-switch-toggle
                class="bca-row__toggle"
                data-factor-toggle={c.key}
                size="xs"
                checked={c.active}
                disabled={c.disabled}
              ></esa-switch-toggle>
              <div class="bca-row__body">
                <span class="bca-row__name">{c.label}</span>
                <span class="bca-row__impact" data-crit-impact>{c.disabledReason ?? c.impact}</span>
              </div>
              <div class="bca-row__readout">
                <span class="bca-row__value mono" data-crit-value>{c.valueText}</span>
                <span class="bca-row__band" data-crit-band>{bandLabel(c.band, c.group)}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <p class="bca-fr__method">
        Ratings come from the NRCS Dynamic Soil Properties Response model. Thresholds map to ARS's
        published criteria; the values shown are SSURGO-derived. This alpha weights factors equally —
        ARS's published ×0.15 coefficients, the slope × O-horizon response surface, and a
        depth-to-water-table input arrive in the build. Prototype — figures are mock.
      </p>
    </div>
  </esa-side-dialog>
</section>

<style>
  .bca-fr {
    /* Band palette — tokenized off the spoke ramps (success/warning/danger). */
    --band-well-dot: var(--color-success, #2e7d4f);
    --band-well-bg: var(--bca-green-100, #e2ecda);
    --band-well-text: var(--bca-green-900, #1b3b27);
    --band-moderate-dot: var(--color-warning, #c77f1f);
    --band-moderate-bg: var(--bca-amber-100, #f7ead2);
    --band-moderate-text: var(--color-warning-strong, #7c5310);
    --band-poor-dot: var(--color-danger, #cf3b2e);
    --band-poor-bg: var(--color-danger-subtle, #fbeae8);
    --band-poor-text: var(--color-danger-strong, #a32318);

    /* nests as the third section of the location card */
    display: block;
    padding: var(--spacing-400, 1rem);
    border-top: 1px solid var(--color-border-light, #ebe8e1);
  }

  /* Lift the drawer above the Leaflet map (controls sit at z-index ~1000); the
     hub's default modal layer (400) renders behind the map. Scoped to this
     dialog instance so other modals keep the house z-scale. */
  .bca-fr esa-side-dialog {
    --z-modal: 2000;
    --z-modal-backdrop: 1990;
  }

  /* verdict accent follows the composed class */
  .bca-fr[data-site-verdict='well'] { --verdict-dot: var(--band-well-dot); --verdict-text: var(--band-well-text); }
  .bca-fr[data-site-verdict='moderate'] { --verdict-dot: var(--band-moderate-dot); --verdict-text: var(--band-moderate-text); }
  .bca-fr[data-site-verdict='poor'] { --verdict-dot: var(--band-poor-dot); --verdict-text: var(--band-poor-text); }

  /* ── compact summary ── */
  .bca-fr__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-300, 0.75rem);
    margin-bottom: var(--spacing-150, 0.375rem);
  }
  .bca-fr__kicker {
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-secondary, #54514a);
  }
  .bca-fr__source { font-size: 0.75rem; color: var(--color-text-muted, #807c73); white-space: nowrap; }

  .bca-fr__verdict {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-300, 0.75rem);
    margin-top: var(--spacing-100, 0.25rem);
  }

  /* Response potential = the 0–100 dynamic-improvement metric, clearly labeled so
     it reads as a SEPARATE measure from the composed site class above it. */
  .bca-fr__metric {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-300, 0.75rem);
    margin-top: var(--spacing-250, 0.625rem);
  }
  .bca-fr__metric-label {
    font-size: 0.8125rem;
    color: var(--color-text-muted, #807c73);
  }
  /* "N factors off" — signals the score is a filtered subset (not the full model). */
  .bca-fr__filtered {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold, 600);
    padding: 1px 7px;
    border-radius: var(--radius-100, 4px);
    background: var(--bca-amber-100, #f7ead2);
    color: var(--color-warning-strong, #7c5310);
    white-space: nowrap;
  }

  .bca-fr__class {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-200, 0.5rem);
    font-size: 1.0625rem;
    font-weight: var(--font-weight-bold, 700);
    color: var(--verdict-text, var(--color-text-primary, #33312a));
  }
  .bca-fr__class::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full, 9999px);
    background: var(--verdict-dot, var(--color-text-muted, #807c73));
  }

  .bca-fr__narrative {
    margin: var(--spacing-200, 0.5rem) 0 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-secondary, #54514a);
  }

  .bca-fr__flags {
    list-style: none;
    margin: var(--spacing-300, 0.75rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-150, 0.375rem);
  }
  /* :global so runtime-recreated flags (replaceChildren in the page script) are
     styled too, scoped under .bca-fr — mirrors the results-card pattern. */
  .bca-fr :global(.bca-fr__flag) {
    font-size: 0.8125rem;
    line-height: 1.4;
    padding: var(--spacing-150, 0.375rem) var(--spacing-250, 0.625rem);
    border-radius: var(--radius-200, 0.375rem);
    background: var(--band-poor-bg);
    color: var(--band-poor-text);
  }

  .bca-fr__view { display: inline-block; margin-top: var(--spacing-300, 0.75rem); }

  /* ── detail drawer body ── */
  .bca-fr__detail { display: flex; flex-direction: column; gap: var(--spacing-400, 1rem); }
  .bca-fr__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-300, 0.75rem);
  }
  .bca-fr__score {
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    color: var(--color-text-muted, #807c73);
    white-space: nowrap;
  }
  .bca-fr__score strong { font-size: 1.125rem; color: var(--color-text-primary, #33312a); }
  .bca-fr__meter {
    height: 6px;
    margin: var(--spacing-200, 0.5rem) 0;
    border-radius: var(--radius-full, 9999px);
    background: var(--bca-score-track, #efe9da);
    overflow: hidden;
  }
  .bca-fr__meter i {
    display: block;
    height: 100%;
    border-radius: var(--radius-full, 9999px);
    background: var(--verdict-dot, var(--color-text-muted, #807c73));
    transition: width 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .bca-fr__detail-narrative {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-secondary, #54514a);
  }

  .bca-fr__tile {
    margin-top: var(--spacing-300, 0.75rem);
    padding-top: var(--spacing-300, 0.75rem);
    border-top: 1px solid var(--color-border-light, #ebe8e1);
  }
  .bca-fr__hint {
    margin: var(--spacing-150, 0.375rem) 0 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted, #807c73);
  }

  .bca-fr__group-head {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-200, 0.5rem);
    margin: 0 0 var(--spacing-200, 0.5rem);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-primary, #33312a);
  }
  .bca-fr__group-head span {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-regular, 400);
    color: var(--color-text-muted, #807c73);
  }
  .bca-fr__factors { list-style: none; margin: 0; padding: 0; }

  .bca-fr__method {
    margin: 0;
    padding-top: var(--spacing-300, 0.75rem);
    border-top: 1px solid var(--color-border-light, #ebe8e1);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted, #807c73);
  }

  /* ── criterion rows (shared in the drawer) ── */
  .bca-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
    padding: var(--spacing-250, 0.625rem) 0;
    border-top: 1px solid var(--color-border-light, #ebe8e1);
  }
  .bca-row__toggle { flex-shrink: 0; }
  .bca-row__body { min-width: 0; flex: 1; }
  .bca-row__name {
    display: block;
    font-size: 0.875rem;
    font-weight: var(--font-weight-medium, 500);
    color: var(--color-text-primary, #33312a);
  }
  .bca-row__impact { display: block; font-size: 0.75rem; color: var(--color-text-muted, #807c73); line-height: 1.35; }
  .bca-row__readout { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
  .bca-row__value { font-size: 0.8125rem; color: var(--color-text-secondary, #54514a); }
  .bca-row__band {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold, 600);
    padding: 1px 7px;
    border-radius: var(--radius-100, 4px);
  }
  .bca-row[data-band='well'] .bca-row__band { background: var(--band-well-bg); color: var(--band-well-text); }
  .bca-row[data-band='moderate'] .bca-row__band { background: var(--band-moderate-bg); color: var(--band-moderate-text); }
  .bca-row[data-band='poor'] .bca-row__band { background: var(--band-poor-bg); color: var(--band-poor-text); }
  .bca-row.is-off,
  .bca-row.is-disabled { opacity: 0.45; }
  .bca-row.is-disabled .bca-row__band { visibility: hidden; }

  .mono { font-family: var(--font-mono, 'Roboto Mono', monospace); }
</style>
