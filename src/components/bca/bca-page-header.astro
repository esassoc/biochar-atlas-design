---
// bca-page-header — the page top for every admin surface: a glyph, the page
// name, and the one or two actions that apply to the whole collection.
//
// Deliberately the SAME shape as bca-record-header one level down, so a list
// and the record it opens read as a pair: mark on the left, name beside it,
// actions right-aligned and top-aligned.
import EsaIcon from '@esa/ecology/esa-icon.astro';

interface Props {
  /** The page name — the h1. */
  title: string;
  /** esa-icon registry name for the glyph left of the title. */
  icon: string;
  /** Inner SVG for a glyph the registry does not ship. */
  iconPaths?: string;
  /** One line under the title. Omit unless the page genuinely needs it. */
  lede?: string;
}
const { title, icon, iconPaths, lede } = Astro.props as Props;
const hasActions = Astro.slots.has('actions');
---

<!-- bcn-lego-checked: esa-page-header is the hub's page-top lego and it was
     what this page used. It cannot carry this treatment: its `icon` prop is
     EYEBROW-only (`{icon && <EsaIcon name={icon} size="sm" />}` inside the
     eyebrow <p>), its title is a string prop with no slot, and its two slots
     are "breadcrumbs" and "actions". There is no way to get a glyph onto the
     h1's own line from outside the component. Beacon hit the same wall and
     hand-rolled it too — its PageLayout puts <EsaIcon> INSIDE the <h1>.

     So this hand-rolls the bar but reads esa-page-header's OWN public hooks
     for every value it shares (--page-header-title-*, --page-header-gap,
     --page-header-bar-gap). Re-point one of those in the theme and both
     components move together; that is the only thing keeping them from
     drifting. Hub fix: a `titleIcon` prop, or a "title" slot on
     esa-page-header. Filed in NEEDS.md. -->

<header class="bca-page-header">
  <div class="bca-page-header__bar">
    <div class="bca-page-header__titles">
      <h1 class="bca-page-header__title">
        <EsaIcon name={icon} size="md" paths={iconPaths} />
        <span>{title}</span>
      </h1>
      {lede && <p class="bca-page-header__lede">{lede}</p>}
    </div>

    {hasActions && (
      <div class="cluster bca-page-header__actions" data-gap="sm">
        <slot name="actions" />
      </div>
    )}
  </div>
</header>

<style>
  .bca-page-header__bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--page-header-bar-gap, var(--spacing-500, 1.5rem));
    flex-wrap: wrap;
  }

  .bca-page-header__titles {
    display: flex;
    flex-direction: column;
    gap: var(--page-header-gap, var(--spacing-200, 0.5rem));
    min-width: 0;
  }

  /* esa-page-header's own rung (--font-size-600) and the weight left unpinned,
     which is what lets [data-theme=biochar] h1's Crimson Pro Light land — see
     theme-biochar.css, where a rule that pins 600 is exactly how a heading
     ends up semibold in this spoke. */
  .bca-page-header__title {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
    margin: 0;
    font-family: var(--page-header-title-font, var(--typography-font-family-display));
    font-size: var(--page-header-title-size, var(--font-size-600, 1.75rem));
    line-height: 1.1;
    color: var(--page-header-title-color, var(--color-content-default, #21201c));
  }

  /* ABI Purple rather than the title's own ink: identity, not emphasis, and a
     step of mass back from the 2px-stroke glyph that Crimson Pro Light can't
     match at equal color. */
  .bca-page-header__title :global(.esa-icon) {
    color: var(--bca-brand-purple, #45173d);
    flex-shrink: 0;
  }

  .bca-page-header__lede {
    margin: 0;
    font-size: var(--page-header-lede-size, var(--font-size-300, 1.125rem));
    color: var(--page-header-lede-color, var(--color-content-default-secondary, #474540));
  }

  /* Top-aligned with the title rather than centred on the bar, so the actions
     do not drift when a lede lands.

     The size default for the slot, not for the page (Andy, 2026-08-14: "Invite
     user" read large against a 13px grid). Every admin page inherits it by
     slotting a plain <EsaButton> — no `size` at the call site, so the next page
     cannot forget.

     Mechanism: re-point the md family here and let it inherit. esa-button and
     esa-icon both resolve their size on the element (--_btn-height reads
     var(--form-height-md), --_icon-size reads var(--icon-size-md)), so the
     nearest ancestor wins. It only touches controls at the DEFAULT size —
     .esa-button--sm reads --form-*-sm and --lg reads --form-*-lg, neither of
     which is touched, so a caller who declares a size still gets it. No reach
     into .esa-button__native and no private --_btn-* tokens.

     Why the type is a literal and not var(--typography-label-xs-font-size): the theme
     re-points --typography-label-md-font-size to 1rem for Andy's 16px floor, which is
     about fields a person TYPES INTO. A page action is not that, and it
     inherited the 16px by accident. 0.8125rem is the same literal
     bca-user-grid uses for its control strip, so the CTA, the search field and
     the two ghost buttons under it all read at one scale. Presence comes from
     the box, not the type: --form-height-sm (32px) leaves it locked to the
     search field's height and 2px taller than the content-height ghost
     buttons, so the primary action is still the largest thing in the column
     while carrying the same label size. */
  .bca-page-header__actions {
    padding-top: var(--spacing-150, 0.375rem);
    --form-height-md: var(--form-height-sm, 32px);
    --radius-md: var(--radius-sm, 4px);
    --typography-label-md-font-size: 0.8125rem;
    --icon-size-md: var(--icon-size-sm, 16px);

    /* The page's one primary action takes the brand ORANGE fill (Andy,
       2026-08-25) — a step hotter than the step footers' gold, same dark-olive
       knockout. Scoped here so every admin page's slotted primary matches. */
    --color-background-brand: var(--bca-brand-gold-dark, #ff9e00);
    --color-background-brand-hover: var(--bca-gold-10, #ca8c02);
    --color-content-default-knockout: var(--bca-green-10, #262903);
  }
</style>
