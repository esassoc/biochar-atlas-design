---
// bca-user-grid — the Users list section: a carded control strip, the AG Grid
// itself, and the download + record-count strip welded under it.
//
// The composition is Beacon's house grid page (beacon-design's
// monitoring/compliance-observations.astro, its most recent), down to the
// numbers: a bordered .bcn-filterbar equivalent above, a brand-slab header,
// 44px rows at 13px, and a welded footer with tabular counts.
//
// Rows cross the SSR→client boundary through a JSON payload island rather than
// a serialized prop: the grid is created in a client script, and this keeps the
// fixture in one place with the markup that consumes it.
import EsaButton from '@esa/ecology/esa-button.astro';
import { users } from '../../data/users';

const rows = users.map((u) => ({
  id: u.id,
  name: u.name,
  email: u.email,
  org: u.org,
  role: u.role,
  status: u.status,
  lastActive: u.lastActive,
}));
---

<!-- bcn-lego-checked: the interactive parts here ARE legos — esa-button for
     every control, esa-text-field for the search. Two things are hand-rolled,
     for two different reasons.

     (1) The three-band frame: a control strip, an AG Grid host div, and a
     record-count strip. No esa-* lego is a data-grid host — AG Grid needs a
     bare element it owns outright — and esa-card would draw a second border and
     radius around a grid that already draws its own wrapper. Checked Beacon:
     beacon-design's grid pages hand-roll the identical .bcn-filterbar /
     grid host / .table-footer trio, and Beacon prod wraps it in an Angular
     `beacon-grid` component, which is what this file is for this spoke.

     (2) The status chip inside a cell. esa-pill IS the chip and the panel uses
     it — but .astro legos are COMPILE-TIME and their CSS is Astro-scoped to a
     `data-astro-cid` attribute. A cell renderer builds its node at runtime with
     document.createElement, so it can never carry that attribute and would
     render unstyled. Nor is the Lit tier an escape: there is no esa-pill web
     component. So the chip is reimplemented here in :global CSS. Beacon hit
     this exactly and resolved it the same way. Filed in NEEDS.md. -->

<section class="bca-user-grid">
  <div class="bca-user-grid__controls">
    <div class="bca-user-grid__search">
      <esa-text-field id="users-search" placeholder="Search users…" size="sm"></esa-text-field>
    </div>
    <EsaButton id="users-clear" variant="ghost" appearance="outline" size="sm">Clear filters</EsaButton>
  </div>

  <div id="users-grid" class="bca-user-grid__host"></div>

  <div class="bca-user-grid__foot">
    <EsaButton id="users-download" variant="ghost" appearance="outline" size="sm" icon="download">
      Download as CSV
    </EsaButton>
    <p class="bca-user-grid__count">
      <span id="users-total">0</span> users<span id="users-filtered" hidden></span>
    </p>
  </div>

  <script type="application/json" id="users-grid-data" set:html={JSON.stringify({ rows })}></script>
</section>

<script>
  import { createGrid, ModuleRegistry, AllCommunityModule } from 'ag-grid-community';
  import type { GridApi, GridOptions, ColDef } from 'ag-grid-community';
  import {
    atlasTheme,
    atlasDefaultColDef,
    makeStatusChipRenderer,
    makeLinkRenderer,
  } from '../../lib/bca-grid';
  import '@esa/ecology/esa-text-field';

  ModuleRegistry.registerModules([AllCommunityModule]);

  interface UserRow {
    id: string;
    name: string;
    email: string;
    org: string;
    role: string;
    status: string;
    lastActive: string | null;
  }

  const host = document.getElementById('users-grid');
  const payloadEl = document.getElementById('users-grid-data');
  if (host && payloadEl) {
    const { rows } = JSON.parse(payloadEl.textContent!) as { rows: UserRow[] };

    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    // An account that has never signed in has no last-active date. The em dash
    // is the absence itself, not a placeholder for a value we failed to load.
    const asDate = (iso: string | null) => {
      if (!iso) return '—';
      const [y, m, d] = iso.split('-').map(Number);
      return `${d} ${months[m - 1]} ${y}`;
    };

    // Colour only what deviates. "Active" is 8 of 10 rows — tinting the norm
    // makes a green column that carries no decision, which is the classic
    // dashboard failure. "Invited" is the one value that wants someone to do
    // something, so it is the only tinted chip on the page and the eye lands on
    // it directly. "Deactivated" recedes: an inert account is an end state, not
    // an error, which is also why nothing here is red — no user status is a
    // failure, and spending the danger colour on one would leave nothing to
    // spell an actual failure with.
    const statusTones = {
      active: { chip: '#177c52', quiet: true }, // --bca-status-green-11
      invited: { chip: '#a45e00' }, //             --bca-status-amber-11, tinted
      deactivated: { chip: '#898780', quiet: true }, // --bca-neutral-9
    };

    // Flex WEIGHTS, not widths — the six columns divide the full grid between
    // them, so nothing is left over on the right. The ratios are the old fixed
    // widths carried across (210/290/140/150/140/140), so the resting layout at
    // a typical viewport is the one that was already approved; what changed is
    // that the surplus now goes to the columns instead of to dead space.
    //
    // minWidth is the real work here. Name and Email hold the two values that
    // truncate worst, so they stop shrinking first and the grid scrolls rather
    // than crushing an address to "kathleen.elm…".
    const columnDefs: ColDef<UserRow>[] = [
      {
        field: 'name',
        headerName: 'Name',
        flex: 2.1,
        minWidth: 170,
        cellRenderer: makeLinkRenderer({ href: (d) => `?user=${d.id}` }),
      },
      { field: 'email', headerName: 'Email', flex: 2.9, minWidth: 230 },
      { field: 'org', headerName: 'Organization', flex: 1.4, minWidth: 130 },
      { field: 'role', headerName: 'Role', flex: 1.5, minWidth: 120 },
      {
        field: 'status',
        headerName: 'Status',
        flex: 1.4,
        minWidth: 120,
        cellRenderer: makeStatusChipRenderer(statusTones),
        cellClass: 'bca-grid-chip-cell',
      },
      {
        field: 'lastActive',
        headerName: 'Last active',
        flex: 1.4,
        minWidth: 125,
        valueFormatter: (p) => asDate(p.value),
      },
    ];

    const total = document.getElementById('users-total')!;
    const filtered = document.getElementById('users-filtered')!;
    const updateCounts = () => {
      const shown = api.getDisplayedRowCount();
      total.textContent = String(rows.length);
      const hidden = rows.length - shown;
      filtered.hidden = hidden === 0;
      filtered.textContent = hidden === 0 ? '' : ` · ${shown} shown`;
    };

    const gridOptions: GridOptions<UserRow> = {
      theme: atlasTheme,
      rowData: rows,
      columnDefs,
      // Stable row ids so a saved edit can find its node instead of rebuilding
      // the whole rowData and losing sort, filter and scroll position.
      getRowId: (p) => p.data.id,
      defaultColDef: atlasDefaultColDef,
      tooltipShowDelay: 0,
      tooltipShowMode: 'whenTruncated',
      onFirstDataRendered: updateCounts,
      onFilterChanged: updateCounts,
      // A click anywhere in the row opens the record — Beacon's uniform grid
      // gesture. The name cell's anchor is left alone so copy-link still gets a
      // real URL; the panel's own delegated handler catches that one.
      onRowClicked: (e) => {
        if ((e.event?.target as HTMLElement | undefined)?.closest('a')) return;
        if (e.data) {
          document.dispatchEvent(
            new CustomEvent('bca:user-row-clicked', { detail: { id: e.data.id } }),
          );
        }
      },
    };

    const api: GridApi<UserRow> = createGrid(host, gridOptions);

    // The edit panel saved. Re-read the row so the grid cannot contradict the
    // record open on top of it. The event carries the whole person now that the
    // edit surface does — the grid takes the five fields it renders and ignores
    // `title`, which lives only in the panel.
    document.addEventListener('bca:user-updated', (e) => {
      const { id, ...patch } = (e as CustomEvent<{ id: string } & Partial<UserRow>>).detail;
      const node = api.getRowNode(id) ?? null;
      const row = rows.find((r) => r.id === id);
      if (!row) return;
      for (const key of ['name', 'email', 'org', 'role', 'status'] as const) {
        if (patch[key] != null) row[key] = patch[key]!;
      }
      if (node) node.setData({ ...row });
      else api.applyTransaction({ update: [row] });
    });

    // esa-text-field fires a composed `change` carrying detail.value on every
    // keystroke, so the quick filter tracks typing without a debounce.
    const search = document.getElementById('users-search') as (HTMLElement & { value: string }) | null;
    search?.addEventListener('change', (e) => {
      api.setGridOption('quickFilterText', (e as CustomEvent).detail?.value ?? search.value ?? '');
    });

    document.getElementById('users-clear')?.addEventListener('click', () => {
      api.setFilterModel(null);
      api.setGridOption('quickFilterText', '');
      if (search) search.value = '';
    });

    document.getElementById('users-download')?.addEventListener('click', () =>
      api.exportDataAsCsv({ fileName: 'biochar-atlas-users.csv' }),
    );
  }
</script>

<style>
  .bca-user-grid {
    display: flex;
    flex-direction: column;
  }

  /* The control strip is a container, not loose controls above a table:
     Beacon's .bcn-filterbar, same border, same 12px/16px padding, same 16px
     gap to the grid. It reads as one grouped strip rather than a search box
     and a button that happen to share a line. */
  .bca-user-grid__controls {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
    flex-wrap: wrap;
    padding: var(--spacing-300, 0.75rem) var(--spacing-400, 1rem);
    margin-bottom: var(--spacing-400, 1rem);
    background: var(--color-background-elevation-raised, #fafaf7);
    border: 1px solid var(--color-border-default, #d0cfcc);
    border-radius: var(--radius-200, 0.5rem);
  }
  .bca-user-grid__search {
    flex: 0 1 320px;
    min-width: 220px;
  }
  .bca-user-grid__search :global(esa-text-field) {
    display: block;
  }

  /* The grid module runs at the dense scale — Andy's 2026-08-14 carve-out from
     the 16px floor, which covers the cells, the header, this strip and the
     footer. The floor still holds everywhere else on the page. */
  .bca-user-grid__controls :global(.esa-button__native),
  .bca-user-grid__foot :global(.esa-button__native) {
    font-size: 0.8125rem;
  }
  .bca-user-grid__controls :global(esa-text-field) {
    --typography-label-xs-font-size: 0.8125rem;
  }

  /* The grid owns the vertical space the shell's content region leaves after
     the topbar, the page header and the two strips. min-height keeps it usable
     on a short window rather than collapsing to a couple of rows. */
  .bca-user-grid__host {
    width: 100%;
    height: calc(100vh - 400px);
    min-height: 340px;
  }

  /* Welded under the grid: the grid's own bottom corners are squared to meet
     it, and this strip repeats the wrapper border with the top edge removed so
     the two read as one frame. */
  .bca-user-grid__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-400, 1rem);
    padding: var(--spacing-200, 0.5rem) var(--spacing-400, 1rem);
    background: var(--color-background-default, #f4f3ee);
    border: 1px solid var(--color-border-default, #d0cfcc);
    border-top: 0;
    border-radius: 0 0 var(--radius-100, 0.25rem) var(--radius-100, 0.25rem);
  }
  .bca-user-grid__count {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-content-default-secondary, #474540);
    font-variant-numeric: tabular-nums;
  }

  /* ── Cells AG Grid injects, which land outside Astro's style scope ────── */
  .bca-user-grid :global(.ag-cell.bca-grid-chip-cell) {
    display: flex;
    align-items: center;
  }
  /* Beacon's chip geometry exactly: a squared 4px badge rather than a pill,
     1px/8px padding, a 7px dot. The tinted case mixes the tone at 16% for the
     fill and 70% against the body ink for the label — the mix is what keeps it
     legible without picking a second hex per status. Measured on the amber:
     5.63:1 on the panel, 5.23:1 on the zebra row, 4.91:1 on a hovered row. The
     hovered row is the binding case; amber-11 unmixed would be 3.61:1 there. */
  .bca-user-grid :global(.bca-grid-chip) {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-150, 0.375rem);
    padding: 1px var(--spacing-200, 0.5rem);
    border-radius: var(--radius-100, 0.25rem);
    font-size: 0.8125rem;
    line-height: 1.5;
    font-weight: var(--typography-font-weight-semibold, 600);
    white-space: nowrap;
    background: color-mix(in srgb, var(--_chip, #898780) 16%, transparent);
    color: color-mix(in srgb, var(--_chip, #898780) 70%, var(--color-content-default, #21201c));
  }
  /* The quiet case: the dot alone carries the hue. Used for the values that are
     the norm and the end state, so the tinted chip is the only one that pulls. */
  .bca-user-grid :global(.bca-grid-chip[data-quiet]) {
    background: transparent;
    color: var(--color-content-default-secondary, #474540);
    font-weight: var(--typography-font-weight-regular, 400);
    padding-inline: 0;
  }
  .bca-user-grid :global(.bca-grid-chip__dot) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--_chip, #898780);
    flex-shrink: 0;
  }

  /* The name column. Purple links are the brand guide's own call for links on
     a light surface — --color-content-link is purple-12 at 13.92:1 on the panel. */
  .bca-user-grid :global(.bca-grid-name) {
    color: var(--color-content-link, #45173d);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .bca-user-grid :global(.bca-grid-name:hover) {
    color: var(--color-content-link-hover, #36082f);
  }
  /* The whole row is a target, so say so. */
  .bca-user-grid :global(.ag-row) {
    cursor: pointer;
  }
</style>
