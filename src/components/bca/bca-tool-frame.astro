---
// bca-tool-frame — the Suitability Tool's page top: the page header above the
// single Evaluate a Site workspace, slotted in by the page. The workflow
// controls (expand / collapse / start over) live in the workspace rail.
import BcaPageHeader from './bca-page-header.astro';

// Lucide map-pinned — same glyph the sidenav uses for the Suitability Tool.
const MAP_PINNED =
  '<path d="M18 8c0 3.613-3.869 7.429-5.393 8.795a1 1 0 0 1-1.214 0C9.87 15.429 6 11.613 6 8a6 6 0 0 1 12 0"/><circle cx="12" cy="8" r="2"/><path d="M8.714 14h-3.71a1 1 0 0 0-.948.683l-2.004 6A1 1 0 0 0 3 22h18a1 1 0 0 0 .948-1.316l-2-6a1 1 0 0 0-.949-.684h-3.712"/>';
---

<div class="bca-tool stack" data-gap="lg">
  <BcaPageHeader title="Suitability Tool" icon="map-pinned" iconPaths={MAP_PINNED} />

  <slot />
</div>

<style>
  /* The shell's content region is edge-to-edge; a document-shaped page
     supplies its own gutter (same move as the admin pages). */
  .bca-tool {
    padding: var(--spacing-600, 2rem);
  }

  /* The header band closes with a light rule, delineating it from the
     workspace below. */
  .bca-tool > :global(.bca-page-header) {
    padding-block-end: var(--spacing-400, 1rem);
    border-block-end: 1px solid var(--color-border-default-subtle, #ebe8e1);
  }
</style>
