---
// bca-user-panel — the user record as a slide-in panel over the Users grid,
// replacing the /admin/users/{id} page it used to be.
//
// Every record is server-rendered and hidden; opening one unhides it. That is
// Beacon's pattern (BcnProjectDataPanel) and it is what keeps the Astro
// components in play — bca-record-header, bca-field-group and bca-field render
// exactly as they did on the page, so the move cost no markup.
//
// Open state lives in the URL as `?user=<id>` — pushState on open, stripped on
// close, honoured on load and on popstate — so a record stays linkable after
// losing its own route. The contract is ported from beacon-design's
// BcnProjectDataPanel, including the two parts that are easy to miss: the
// `push` flag so a history-driven open does not re-push, and the re-entrancy
// guard so popstate → close() does not push a second entry.
//
// The URL carries the RECORD only, never the stack depth. Editing opens a
// second panel over this one (bca-user-edit-panel) and `?user=` does not
// change, which is what beacon-design's permit-tracking does — its drawers are
// not addressable at all. A link that reopened someone else's half-filled edit
// form would be a worse contract than no link.
import BcaRecordHeader from './bca-record-header.astro';
import BcaFieldGroup from './bca-field-group.astro';
import BcaField from './bca-field.astro';
import BcaStatusChip from './bca-status-chip.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { users, usersById, formatDate } from '../../data/users';
---

<!-- bcn-lego-checked: esa-side-dialog IS the lego and it is doing the work —
     the slide, the backdrop, the focus move and restore, the focus trap, the
     Escape and backdrop dismissal, role="dialog" and aria-modal. Nothing here
     re-implements any of it. What this file adds is the three things the lego
     leaves to its host: which record is showing, the URL contract, and the
     z-index that clears this shell's topbar (1100) and nav flyout (1200) —
     esa-side-dialog is a CUSTOM overlay, not a native <dialog>, so it has no
     top layer and DOM order will not save it.

     Width is 520px, and the edit panel that stacks over it matches — a stack
     only reads as a stack when the under card can peek out from behind the top
     one, and the peek is a --side-dialog-inset slide, not a width difference.

     Density is set once here, on the header and body scopes, as --record-*
     custom properties. bca-record-header, bca-field-group and bca-field all
     read them, so a component nested three deep picks up the panel's scale
     without a `density` prop threaded through every signature. -->

<esa-side-dialog
  id="users-record-panel"
  position="right"
  style="--_width: 520px; --z-modal: 1300; --z-modal-backdrop: 1250;"
>
  <div slot="header" class="bca-user-panel__heads">
    {users.map((user) => (
      <div class="bca-user-panel__head" data-user-head={user.id} data-user-scope={user.id} hidden>
        <BcaRecordHeader
          as="h2"
          name={user.name}
          context={`${user.title} · ${user.org}`}
          avatarName={user.name}
          avatarSize="md"
        >
          <Fragment slot="chips">
            <BcaStatusChip value={user.status} field="status" />
            <BcaStatusChip value={user.role} field="role" tone="plain" />
          </Fragment>
        </BcaRecordHeader>
      </div>
    ))}
  </div>

  {users.map((user) => {
    const invitedBy = usersById[user.invitedBy];
    return (
      <div
        class="bca-user-panel__body stack"
        data-gap="lg"
        data-user-body={user.id}
        data-user-scope={user.id}
        hidden
      >
        {/* Editable values carry data-user-field so a save can repaint them in
            place. Read-only ones do not — nothing can change them, so an
            attribute pointing at them would be a hook to nowhere. That split is
            the same one the edit panel makes: it edits exactly the fields that
            are instrumented here. */}
        <BcaFieldGroup title="Account" flush>
          <BcaField label="Email">
            <a href={`mailto:${user.email}`} data-user-field="email" data-user-mailto>
              {user.email}
            </a>
          </BcaField>
          <BcaField label="User ID" value={user.id} mono />
          <BcaField label="Member since" value={formatDate(user.memberSince)} />
          <BcaField label="Invited by">
            {invitedBy && invitedBy.id !== user.id ? (
              <a href={`?user=${invitedBy.id}`} data-opens-user={invitedBy.id}>{invitedBy.name}</a>
            ) : (
              'Created at project setup'
            )}
          </BcaField>
        </BcaFieldGroup>

        {/* Role and status are chips in the identity band directly above, so
            here they are plain values. Repeating the same chip twice in 520px
            makes the panel look like it is emphasising something. */}
        <BcaFieldGroup title="Access" flush>
          <BcaField label="Role">
            <span data-user-field="role">{user.role}</span>
          </BcaField>
          <BcaField label="Status">
            <span data-user-field="status">{user.status}</span>
          </BcaField>
          <BcaField label="Last active" value={formatDate(user.lastActive)} />
        </BcaFieldGroup>

        <BcaFieldGroup title="Organization" flush>
          <BcaField label="Organization">
            <span data-user-field="org">{user.org}</span>
          </BcaField>
          <BcaField label="Job title">
            <span data-user-field="title">{user.title}</span>
          </BcaField>
        </BcaFieldGroup>
      </div>
    );
  })}

  <!-- A real element carries slot="footer", not a <Fragment>: esa-side-dialog
       is a web component, so the slot has to survive into the DOM, and Astro's
       Fragment unwraps before it gets there. The lego collapses its footer bar
       via `.footer:not(:has(*))`, so getting this wrong renders an empty rule
       above the panel's bottom edge and drops the button into the body — which
       is exactly what it did on the first pass. -->
  <div slot="footer" class="bca-user-panel__foot">
    <EsaButton id="users-record-panel-edit" variant="primary" icon="pencil" data-opens-user-edit>
      Edit user
    </EsaButton>
  </div>
</esa-side-dialog>

<script>
  import '@esa/ecology/esa-side-dialog';

  type Panel = HTMLElement & { open: boolean; heading: string; show(): void; close(): void };

  const panel = document.getElementById('users-record-panel') as Panel | null;
  const editBtn = document.getElementById('users-record-panel-edit');

  if (panel) {
    const heads = [...document.querySelectorAll<HTMLElement>('[data-user-head]')];
    const bodies = [...document.querySelectorAll<HTMLElement>('[data-user-body]')];
    const nameOf = (id: string) =>
      document.querySelector<HTMLElement>(`[data-user-head="${id}"] h2`)?.textContent?.trim() ?? '';

    // esa-avatar derives both of these from the name at build time. A renamed
    // account has to re-derive them here, by the same two rules, or the disc
    // keeps the old initials in the old colour. Copied from the lego rather
    // than imported: it is an .astro component, so there is no runtime module
    // to import them from. Filed in NEEDS.md.
    const initialsOf = (n: string) => {
      const parts = n.trim().split(/\s+/);
      return parts.length === 1
        ? parts[0][0].toUpperCase()
        : (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    };
    const hueOf = (n: string) => {
      let hash = 0;
      for (let i = 0; i < n.length; i++) hash = n.charCodeAt(i) + ((hash << 5) - hash);
      return Math.abs(hash) % 360;
    };

    // Guards the one re-entrancy the URL contract has: popstate calls close(),
    // close() fires the lego's `close` event, and that handler would push a
    // second history entry for a navigation the user already made.
    let syncingHistory = false;
    let openId: string | null = null;

    function openUser(id: string, push = true): void {
      const body = bodies.find((b) => b.dataset.userBody === id);
      if (!body) return;
      heads.forEach((h) => (h.hidden = h.dataset.userHead !== id));
      bodies.forEach((b) => (b.hidden = b !== body));
      openId = id;
      // The lego uses `heading` as its aria-label even when a header is
      // slotted, so it has to be set regardless of what is visible.
      panel!.heading = nameOf(id);
      editBtn?.setAttribute('data-user-id', id);
      panel!.show();
      if (push) history.pushState({ user: id }, '', `?user=${id}`);
    }

    // Escape, the backdrop and the ✕ all funnel through this one event.
    panel.addEventListener('close', () => {
      openId = null;
      if (!syncingHistory && new URLSearchParams(location.search).has('user')) {
        history.pushState({}, '', location.pathname);
      }
    });

    window.addEventListener('popstate', () => {
      const id = new URLSearchParams(location.search).get('user');
      syncingHistory = true;
      if (id) openUser(id, false);
      else panel.close();
      syncingHistory = false;
    });

    // Any real anchor pointing at a record opens the panel instead of
    // navigating — the grid's name cells and the "Invited by" link. They stay
    // real hrefs so copy-link and middle-click still work.
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>('a[href*="?user="]');
      if (!link || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      const id = new URLSearchParams(link.search).get('user');
      if (!id) return;
      e.preventDefault();
      openUser(id);
    });

    // A row click anywhere opens the record — Beacon's uniform grid gesture.
    document.addEventListener('bca:user-row-clicked', (e) => {
      openUser((e as CustomEvent<{ id: string }>).detail.id);
    });

    // The edit panel saved; the open record and the grid both re-read it. The
    // payload is the whole person, so this repaints by field name rather than
    // knowing which two fields the write surface happened to expose.
    document.addEventListener('bca:user-updated', (e) => {
      const detail = (e as CustomEvent<Record<string, string>>).detail;
      const { id } = detail;
      // Kept in step with the TONES map in bca-status-chip.astro.
      const toneOf = (v: string) =>
        ({ active: 'quiet', invited: 'notice', deactivated: 'muted' })[v.toLowerCase()] ?? 'plain';

      document.querySelectorAll<HTMLElement>(`[data-user-scope="${id}"]`).forEach((scope) => {
        scope.querySelectorAll<HTMLElement>('[data-user-field]').forEach((el) => {
          const value = detail[el.dataset.userField!];
          if (value == null) return;
          // esa-pill renders its text in a child; a plain span holds its own.
          const label = el.querySelector<HTMLElement>('.esa-pill__label');
          if (label) label.textContent = value;
          else el.textContent = value;
          // The mailto has to follow the address or the link sends to the old one.
          if (el.dataset.userMailto !== undefined) el.setAttribute('href', `mailto:${value}`);
          // A status chip's tone is derived from its value, so it has to be
          // recomputed here or a deactivated account keeps the live treatment.
          if (el.dataset.userField === 'status' && el.classList.contains('bca-status-chip')) {
            el.dataset.tone = toneOf(value);
          }
        });

        // The identity band is rendered by bca-record-header, which takes its
        // name and context as props — so it is repainted by class rather than
        // by adding a data hook to a component that has no reason to know about
        // users. The avatar's initials AND its hue both derive from the name.
        const name = detail.name;
        if (name) {
          const heading = scope.querySelector<HTMLElement>('.bca-record-header__name');
          if (heading) heading.textContent = name;
          const initials = scope.querySelector<HTMLElement>('.esa-avatar__initials');
          if (initials) initials.textContent = initialsOf(name);
          const avatar = scope.querySelector<HTMLElement>('.esa-avatar');
          if (avatar) avatar.style.setProperty('--_avatar-hue', String(hueOf(name)));
          if (openId === id) panel!.heading = name;
        }
        const context = scope.querySelector<HTMLElement>('.bca-record-header__context');
        if (context && detail.title && detail.org) {
          context.textContent = `${detail.title} · ${detail.org}`;
        }
      });
    });

    const initial = new URLSearchParams(location.search).get('user');
    if (initial) openUser(initial, false);

    // Exposed for the grid, which needs to know whether a row is the open one.
    (window as unknown as { bcaOpenUser?: () => string | null }).bcaOpenUser = () => openId;
  }
</script>

<style>
  /* ═══ Panel density ═══
     One block, set on both slot scopes, inherited by every record component
     inside. The numbers are beacon-design's drawer scale verbatim (its segment
     dossier: --font-size-400 title, 0.875rem labels, 0.9375rem values), which
     is the same source that settled the grid's 13px/44px — so the drawer and
     the table it opens over are one product rather than two.

     THIS IS BELOW THE 16px FLOOR, and it widens Andy's 2026-08-14 carve-out
     from "data-grid cells" to "the dense data surfaces" — the grid and the
     record panel that reads out of it. His call, from looking at the panel
     over the finished grid: the header especially, but the body too. The floor
     still holds for page content; a record panel is a read-out of a row.

     The name takes Inter semibold rather than a smaller Crimson Pro. The
     display serif is the PAGE title's voice — bca-page-header owns it one
     level up on the same screen — and a second serif line inside a drawer over
     that page competes with it instead of sitting under it. */
  .bca-user-panel__heads,
  .bca-user-panel__body {
    --record-name-family: var(--typography-font-family-sans, Inter, system-ui, sans-serif);
    --record-name-size: var(--font-size-400, 1.25rem);
    --record-name-weight: var(--typography-font-weight-semibold, 600);
    --record-context-size: 0.875rem;
    --record-section-size: 0.9375rem;
    --record-label-size: 0.875rem;
    --record-value-size: 0.9375rem;
    --record-label-column: 6.5rem;
    --record-row-gap: var(--spacing-200, 0.5rem);
    --record-title-gap: var(--spacing-150, 0.375rem);
    --record-identity-gap: var(--spacing-300, 0.75rem);
  }

  /* ═══ The under card of the stack ═══
     When the edit panel opens over this one, it slides left by the inset so it
     peeks out from behind — the lego animates --side-dialog-inset itself, and
     explicitly supports a host re-pointing it while open. The class is toggled
     by the edit panel, which owns the stack; the rule lives here because a
     component styles its own element.

     36px, NOT Beacon's 44. The peek is the DIFFERENCE between the two insets,
     so 44 against the top card's default 16 exposes 28px of the under card —
     and esa-side-dialog pads its header, body and footer by 24px, so the last
     4px are the first sliver of every label. Measured on the first pass: a
     column of clipped glyph fragments down the left edge, which reads as a
     rendering fault rather than as a card behind. 36 gives a 20px peek that
     lands entirely inside the padding, so the strip is the card's own surface
     and its rounded corner. permit-tracking has the same 28px overhang; it is
     masked there by the double-dim bug noted in bca-user-edit-panel.astro. */
  #users-record-panel.is-under {
    --side-dialog-inset: 40px;
  }

  /* The leading edge. esa-side-dialog hardcodes box-shadow to --elevation-5 and
     ships no --side-dialog-shadow hook, so re-pointing --elevation-5 on the host
     is the only lever — see theme-biochar.css for why the shipped value (8%
     alpha, straight down) draws nothing on a right-anchored panel, and for the
     grep proving the re-point cannot reach anything else. */
  #users-record-panel {
    --elevation-5: var(--bca-panel-shadow);
  }

  /* The lego's header slot is a single row; the hidden siblings must not
     reserve space in it. */
  .bca-user-panel__heads > [hidden] {
    display: none;
  }
  .bca-user-panel__body[hidden] {
    display: none;
  }

  /* The identity band inside a 520px panel: the avatar and name sit tighter
     than they do on a full page, and the chips wrap under rather than beside. */
  .bca-user-panel__head {
    padding-right: var(--spacing-500, 1.5rem);
  }

  /* esa-pill hardcodes its font-size with no public hook, and the theme lifts
     it to 16px app-wide (theme-biochar.css § pill). Beside a 20px name and
     above 15px values, a 16px chip outweighs the record it labels — so the
     panel takes the grid chip's 13px and the two read as the same object.
     One class heavier than the theme rule, (0,4,0) against (0,3,0), so this
     wins on specificity rather than on bundle order. */
  .bca-user-panel__heads :global(.esa-pill.esa-pill--md) {
    font-size: 0.8125rem;
  }
</style>
