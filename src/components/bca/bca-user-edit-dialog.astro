---
// bca-user-edit-dialog — the two fields an administrator can actually change
// on someone else's account: the application role and the account status.
//
// Name, email, organization and job title are deliberately absent. They belong
// to the person, not to the account, and an admin editing them would be
// changing a fact about a colleague rather than a permission. Those arrive
// from the directory; this dialog is scoped to what an administrator owns.
//
// It edits WHICHEVER record is open — the trigger carries data-user-id — and
// announces the result as a `bca:user-updated` event rather than writing to the
// DOM itself. The panel and the grid both listen, so the record and the row it
// came from can never disagree. There is no server, so the change lives until
// reload; the interaction is the thing being prototyped.
import EsaButton from '@esa/ecology/esa-button.astro';
import { users, type UserRole, type UserStatus } from '../../data/users';

const roles: UserRole[] = ['Administrator', 'Contributor', 'Viewer'];
const statuses: UserStatus[] = ['Active', 'Invited', 'Deactivated'];
const seed = {
  roles: roles.map((r) => ({ label: r, value: r })),
  statuses: statuses.map((s) => ({ label: s, value: s })),
  users: Object.fromEntries(users.map((u) => [u.id, { name: u.name, role: u.role, status: u.status }])),
};
---

<esa-dialog id="user-edit-dialog" heading="Edit user" size="sm">
  <div class="stack" data-gap="md">
    <esa-select id="user-edit-role" label="Role" size="md"></esa-select>
    <esa-select id="user-edit-status" label="Status" size="md"></esa-select>
  </div>

  <Fragment slot="footer">
    <EsaButton id="user-edit-cancel" color="ghost" appearance="outline">Cancel</EsaButton>
    <EsaButton id="user-edit-save" color="primary">Save changes</EsaButton>
  </Fragment>
</esa-dialog>

<script type="application/json" id="user-edit-seed" set:html={JSON.stringify(seed)}></script>

<script>
  import '@esa/ecology/esa-dialog';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-snackbar-container';

  interface Seed {
    roles: { label: string; value: string }[];
    statuses: { label: string; value: string }[];
    users: Record<string, { name: string; role: string; status: string }>;
  }
  type Select = HTMLElement & { options: { label: string; value: string }[]; value: string };
  type Dialog = HTMLElement & { open: boolean; heading: string };

  const seedEl = document.getElementById('user-edit-seed');
  const dialog = document.getElementById('user-edit-dialog') as Dialog | null;
  const roleSel = document.getElementById('user-edit-role') as Select | null;
  const statusSel = document.getElementById('user-edit-status') as Select | null;

  if (seedEl && dialog && roleSel && statusSel) {
    const seed = JSON.parse(seedEl.textContent!) as Seed;
    // A live copy of every record, not the server-rendered one. Saving mutates
    // this, so reopening shows what the record now says; cancelling leaves it
    // untouched, so a cancelled edit is genuinely discarded.
    const current = structuredClone(seed.users);
    let editingId: string | null = null;

    // `options` is an array property, not an attribute — it has to be assigned,
    // and the value assigned after it so the label resolves.
    const seedSelects = (id: string) => {
      const user = current[id];
      if (!user) return;
      roleSel.options = seed.roles;
      roleSel.value = user.role;
      statusSel.options = seed.statuses;
      statusSel.value = user.status;
      dialog.heading = `Edit ${user.name}`;
    };

    document.querySelectorAll('[data-opens-user-edit]').forEach((trigger) =>
      trigger.addEventListener('click', () => {
        const id = (trigger as HTMLElement).dataset.userId;
        if (!id || !current[id]) return;
        editingId = id;
        seedSelects(id);
        dialog.open = true;
      }),
    );

    document.getElementById('user-edit-cancel')?.addEventListener('click', () => {
      dialog.open = false;
    });

    document.getElementById('user-edit-save')?.addEventListener('click', () => {
      if (!editingId) return;
      const role = String(roleSel.value);
      const status = String(statusSel.value);
      const user = current[editingId];
      user.role = role;
      user.status = status;

      document.dispatchEvent(
        new CustomEvent('bca:user-updated', { detail: { id: editingId, role, status } }),
      );

      dialog.open = false;

      const toasts = document.getElementById('app-toasts') as
        | (HTMLElement & { success: (m: string) => void })
        | null;
      toasts?.success(`${user.name} is now a ${role.toLowerCase()} · ${status.toLowerCase()}`);
    });
  }
</script>
