---
// bca-step-section — one step in the main column. Chrome-free by design: the
// steps sit directly on the canvas, separated by the workspace's hairline
// rules. The header row is the disclosure control (numbered dot, headline,
// Optional badge). The body holds a guidance aside beside the Phase 2
// placeholder panel, and the footer carries the step's navigation actions.
// The workspace controller owns [data-status] / [data-open]; this component
// renders every state. The captured key values live in the rails only.
//
// bcn-lego-checked: esa-collapsible is the hub's disclosure lego, but its
// <summary> is fixed icon + title string — it cannot carry the stateful dot
// or the Optional badge, and its native <details> open state cannot be driven
// alongside the controller's status model. Checked Beacon: no wizard/step UI.
// The reusable home is a hub esa-stepper suite; filed with the bca-step-dot
// need.
import type { StepDef } from '../../data/workflow';
import BcaStepDot from './bca-step-dot.astro';
import EsaBadge from '@esa/ecology/esa-badge.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaIcon from '@esa/ecology/esa-icon.astro';

interface Props {
  step: StepDef;
  /** 1-based position in the workflow. */
  index: number;
  total: number;
  workflowId: string;
}
const { step, index, total, workflowId } = Astro.props;
const isFirst = index === 1;
const isLast = index === total;
const bodyId = `${workflowId}-${step.id}-body`;

// Lucide info — not in esa-icon's built-in registry (same inline-path move as
// the AppShell's About glyph).
const INFO_PATHS =
  '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>';
---

<section
  class="bca-step"
  id={`${workflowId}-${step.id}`}
  data-step={step.id}
  data-status={isFirst ? 'active' : 'upcoming'}
  data-open={isFirst ? '' : undefined}
>
  <button
    type="button"
    class="bca-step__header"
    data-toggle
    aria-expanded={isFirst ? 'true' : 'false'}
    aria-controls={bodyId}
  >
    <BcaStepDot index={index} />
    <span class="bca-step__titles">
      <span class="bca-step__title typography-label-md-strong">{step.title}</span>
      {step.optional && (
        <span class="bca-step__optional typography-microcopy-2xs">Optional</span>
      )}
    </span>
    <span class="bca-step__chevron">
      <EsaIcon name="chevron-down" size="sm" />
    </span>
  </button>

  <div class="bca-step__body" id={bodyId}>
    <div class="bca-step__body-inner">
      <div class="bca-step__cols sidebar" data-gap="xl">
        <aside class="bca-step__guidance">
          <EsaIcon name="info" size="sm" paths={INFO_PATHS} />
          <p class="typography-body-sm">{step.guidance}</p>
        </aside>
        <div class="bca-step__panel">
          <span class="bca-step__phase">
            <EsaBadge value="Phase 2" variant="secondary" size="xs" />
          </span>
          <ul class="bca-step__planned" role="list">
            {step.planned.map((p) => <li class="typography-label-sm">{p}</li>)}
          </ul>
        </div>
      </div>

      <footer class="bca-step__footer repel">
        <div class="bca-step__footer-start">
          {!isFirst && (
            <EsaButton variant="ghost" size="sm" data-action="back">
              Back
            </EsaButton>
          )}
        </div>
        <div class="cluster" data-gap="sm">
          <EsaButton variant="primary" size="sm" data-action="continue">
            {isLast ? 'Finish' : 'Save and continue'}
          </EsaButton>
          {step.optional && (
            <EsaButton variant="secondary" appearance="outline" size="sm" data-action="skip">
              Skip
            </EsaButton>
          )}
        </div>
      </footer>
    </div>
  </div>
</section>

<style>
  .bca-step {
    padding-block: var(--spacing-400, 1rem);
    scroll-margin-block-start: var(--spacing-400, 1rem);
  }

  /* ── header — the disclosure row ── */
  .bca-step__header {
    --bca-step-dot-size: 18px;
    --bca-step-dot-num-size: 0.6875rem;

    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
    width: 100%;
    padding: var(--spacing-200, 0.5rem);
    margin-inline: calc(-1 * var(--spacing-200, 0.5rem));
    border-radius: var(--radius-200, 0.5rem);
    text-align: left;
    transition: background 150ms ease;
  }
  .bca-step__header:hover {
    background: var(--color-active-overlay, rgba(0, 0, 0, 0.04));
  }
  .bca-step__header:focus-visible {
    outline: 2px solid var(--color-primary, #364500);
    outline-offset: 2px;
  }

  .bca-step__titles {
    display: flex;
    align-items: center;
    gap: var(--spacing-300, 0.75rem);
    min-width: 0;
  }

  .bca-step__title {
    color: var(--color-text-primary, #33312a);
    white-space: nowrap;
  }

  /* the quiet text marker the rail used to carry — a word, not a pill */
  .bca-step__optional {
    flex-shrink: 0;
    color: var(--color-text-muted, #807c73);
  }
  .bca-step[data-status='upcoming'] .bca-step__title,
  .bca-step[data-status='skipped'] .bca-step__title {
    color: var(--color-text-tertiary, #615f5a);
  }

  .bca-step__chevron {
    margin-inline-start: auto;
    flex-shrink: 0;
    color: var(--color-text-muted, #807c73);
    transition: transform 200ms ease;
  }
  .bca-step[data-open] .bca-step__chevron {
    transform: rotate(180deg);
  }

  /* ── body — grid-rows collapse animation, no JS measuring ── */
  .bca-step__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 250ms ease;
  }
  .bca-step[data-open] .bca-step__body {
    grid-template-rows: 1fr;
  }
  .bca-step__body-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500, 1.5rem);
    /* aligns the body under the header label, past the dot column */
    padding-inline-start: calc(18px + var(--spacing-300, 0.75rem));
    padding-block-start: var(--spacing-300, 0.75rem);
  }

  .bca-step__cols {
    --sidebar-width: 15rem;
    --sidebar-content-min: 55%;
  }

  .bca-step__guidance {
    display: flex;
    gap: var(--spacing-200, 0.5rem);
  }
  .bca-step__guidance > :global(.esa-icon) {
    flex-shrink: 0;
    margin-block-start: 2px;
    color: var(--color-text-tertiary, #615f5a);
  }
  .bca-step__guidance p {
    margin: 0;
    max-width: 34ch;
    color: var(--color-text-secondary, #54514a);
    /* Medium, deliberately — body-sm's regular weight read too thin at this
       size on the canvas, and no medium body composite exists on the ramp. */
    font-weight: var(--font-weight-medium, 500);
  }

  /* The Phase 2 stage — a dashed placeholder for the step's real surface. */
  .bca-step__panel {
    min-height: 180px;
    padding: var(--spacing-500, 1.5rem);
    border: 1.5px dashed var(--color-border-default, #c6c5c1);
    border-radius: var(--radius-300, 0.75rem);
    background: var(--color-surface, #fdfdfc);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-300, 0.75rem);
  }
  .bca-step__phase {
    align-self: flex-start;
  }
  .bca-step__planned {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-150, 0.375rem);
  }
  .bca-step__planned li {
    color: var(--color-text-secondary, #54514a);
    padding-inline-start: var(--spacing-400, 1rem);
    position: relative;
  }
  .bca-step__planned li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.55em;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 2px;
    background: var(--color-border-default, #c6c5c1);
  }

  /* The one brand-forward control on the surface: the primary action takes
     the ABI Gold fill with dark-olive ink (the avatar's pairing; ~9:1).
     Scoped token re-points — esa-button reads these three for its fill,
     hover, and on-fill text; the ghost and outline siblings don't. */
  .bca-step__footer {
    --color-background-brand: var(--bca-brand-gold, #ffc261);
    --color-background-brand-hover: var(--bca-brand-gold-dark, #ff9e00);
    --color-content-default-knockout: var(--bca-green-10, #262903);
  }

  /* Upcoming steps preview with everything inert; the controller also
     disables the footer buttons so the state is honest to a keyboard. */
  .bca-step[data-status='upcoming'] .bca-step__cols,
  .bca-step[data-status='upcoming'] .bca-step__footer,
  .bca-step[data-status='skipped'] .bca-step__cols {
    opacity: 0.55;
  }
  .bca-step[data-status='upcoming'] .bca-step__footer {
    pointer-events: none;
  }
</style>
