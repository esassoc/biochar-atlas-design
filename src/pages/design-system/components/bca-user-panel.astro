---
import ComponentDoc from '../../../layouts/ComponentDoc.astro';
import Section from '@esa/docs/Section.astro';
import Api from '@esa/docs/Api.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import BcaUserPanel from '../../../components/bca/bca-user-panel.astro';
import BcaUserEditPanel from '../../../components/bca/bca-user-edit-panel.astro';
import { users } from '../../../data/users';

const demo = users.slice(0, 3);

const legoApi = [
  { name: 'open', type: 'boolean', default: 'false', description: 'Reflected. Prefer show() / close() — they run the animation and the focus handling.' },
  { name: 'heading', type: 'string', default: "''", description: 'Renders as the panel title, and is the aria-label. Set it even when you slot a header, or the panel loses its accessible name.' },
  { name: 'position', type: "'left' | 'right'", default: "'right'", description: 'Which edge it enters from.' },
  { name: 'size', type: "'sm' | 'md' | 'lg'", default: "'md'", description: '320 / 400 / 520px. Override --_width directly for anything else.' },
  { name: 'show-close-button', type: 'boolean', default: 'true', description: 'The ✕ in the header.' },
  { name: 'close', type: 'CustomEvent', description: 'Fires on ✕, Escape and backdrop click alike — one handler covers all three. There is no matching open event.' },
];

const hooks = [
  { name: '--_width', type: 'length', default: 'per size', description: 'The one to set. 520px here, and the edit panel that stacks over it matches — a stack needs equal widths, because the under card peeks by sliding rather than by being wider.' },
  { name: '--z-modal / --z-modal-backdrop', type: 'number', default: '400 / 300', description: 'Must be raised above the app shell. esa-side-dialog is a custom overlay, not a native <dialog>, so it has no top layer and DOM order will not save it. This shell’s topbar is 1100 and its nav flyout 1200, so the record panel runs at 1300 / 1250 and the edit panel above it at 1340 / 1310.' },
  { name: '--side-dialog-inset', type: 'length', default: '16px', description: 'The gap on all four sides, and the stacking knob: the under card re-points it to 40px while a second panel is open, which the lego animates. The peek is the difference between the two insets, capped at the lego\u2019s 24px body padding \u2014 past that the strip slices glyphs off the labels underneath.' },
  { name: '--side-dialog-backdrop-bg', type: 'color', default: 'rgba(0,0,0,.5)', description: 'The scrim. The top card of a stack sets it to --bca-panel-stack-scrim (30% black), which dims the card underneath one step without taking the page to the 50% the record panel already applies. It must be this token and not --color-background-overlay-backdrop: the lego falls back to --color-background-overlay-backdrop only when this one is unset, and component-tokens.css sets it at :root \u2014 so the substitution has already happened and the concrete colour is what inherits down.' },
  { name: '--elevation-5', type: 'shadow', default: '0 8px 32px -8px rgba(0,0,0,.08)', description: 'The panel\u2019s elevation, hardcoded in the lego with no --side-dialog-shadow hook. Both panels re-point it to --bca-panel-shadow: the shipped value throws straight DOWN at 8%, and a right-anchored panel only ever shows its left edge.' },
  { name: '--record-*', type: 'length / weight', default: 'page scale', description: 'The density block. bca-record-header, bca-field-group and bca-field all read these, so a panel sets its scale once on the slot scopes rather than threading a prop through three components.' },
];
---
<ComponentDoc
  name="Record panel"
  category="Patterns"
  slug="bca-user-panel"
  type=".astro"
  origin="spoke"
  summary="A record read as a slide-in panel over the list it came from, rather than a page you navigate away to. Wraps the hub's <code>esa-side-dialog</code> and adds the three things it leaves to its host: which record is showing, the URL contract, and the z-index."
>
  <Section id="preview" title="Preview">
    <p>
      Opening a record does not leave the list. The panel overlays the grid at
      520px with a scrim behind it; the grid keeps its scroll position, its
      sort and its filters, which is the whole reason for the pattern.
    </p>
    <div class="cluster" data-gap="sm">
      {demo.map((u) => (
        <EsaButton variant="secondary" appearance="outline" data-ds-open-user={u.id}>{u.name}</EsaButton>
      ))}
    </div>
  </Section>

  <Section id="url" title="The URL contract">
    <p>
      A record that loses its own route must not lose its link. Open state lives
      in <code>?user=&lt;id&gt;</code> — pushed on open, stripped on close,
      honoured on load and on <code>popstate</code>. Escape then Back reopens
      the record you just closed, and a pasted URL lands with the panel already
      open.
    </p>
    <p>
      Two parts are easy to leave out and both are load-bearing. Opens driven by
      history pass <code>push: false</code>, or every Back press adds an entry.
      And <code>popstate</code> → <code>close()</code> fires the lego's
      <code>close</code> event, whose handler would push a second entry for a
      navigation the user already made — so a re-entrancy flag guards it.
    </p>
    <p>
      Triggers stay real anchors carrying <code>href="?user=&lt;id&gt;"</code>
      with the left click intercepted. That is what makes the link genuinely
      shareable rather than a click handler wearing an underline.
    </p>
  </Section>

  <Section id="anatomy" title="Anatomy">
    <p>
      Every record is server-rendered into the panel and hidden; opening one
      unhides it. Nothing is built at runtime, so the same
      <code>bca-record-header</code>, <code>bca-field-group</code> and
      <code>bca-field</code> the record page used render unchanged.
    </p>
    <p>
      The identity band goes in the <code>header</code> slot, the field groups
      in the default slot at their flush variant — three outlined cards inside a
      bordered 520px drawer is four nested rectangles for one record — and the
      record's actions in the <code>footer</code> slot. That slot has to sit on
      a real element, not an Astro <code>&lt;Fragment&gt;</code>: the Fragment
      unwraps before the DOM, the attribute is lost, and the lego's
      <code>.footer:not(:has(*))</code> rule then collapses an empty bar while
      the button falls into the body.
    </p>
  </Section>

  <Section id="stacking" title="Stacking: the write surface">
    <p>
      Editing opens a <em>second</em> panel over the record rather than a modal
      beside it. Two overlay grammars on one screen for one record is the thing
      being avoided; the stack keeps one grammar and shows the relationship —
      the record you were reading is still there, one card back.
    </p>
    <p>
      Three things separate the layers, and the geometry is the weakest of them.
      The under card re-points <code>--side-dialog-inset</code> to 40px, which
      the lego animates, so it slides left and peeks out by 24px — the peek is
      the difference between the two insets, and 24px is a hard ceiling because
      it is the lego's own body padding. One pixel more and the strip shows the
      first sliver of every label instead of the card's own edge.
    </p>
    <p>
      A 24px strip is not enough on its own, so the top card also brings a scrim
      and a leading edge. <code>--side-dialog-backdrop-bg</code> goes to 30%
      black — the card underneath dims, the way the page dims when the record
      opens, but at well under the page scrim's 50% because this is one step of
      depth rather than the app going away. That is the primary lever. Sampled
      off the render, the profile across the seam runs <code>#484847</code> for
      the page, <code>#aeaeab</code> for the card underneath and
      <code>#fafaf7</code> for the top card — two hard steps, which is a bigger
      value break than any shadow can draw.
    </p>
    <p>
      The shadow draws the line the scrim's value break implies.
      esa-side-dialog hardcodes <code>box-shadow</code> to
      <code>--elevation-5</code> and ships no shadow hook of its own, and the
      shipped <code>--elevation-5</code> is <code>0 8px 32px -8px rgba(0,0,0,.08)</code>
      — straight down, at 8%. On a panel pinned to the right edge, the only edge
      you see is the left one, and a downward shadow draws nothing there. Both
      panels re-point <code>--elevation-5</code> to
      <code>--bca-panel-shadow</code>, which throws left and keeps its density
      near the edge so the peek beside it stays legible.
    </p>
    <p>
      It holds at three levels. Each panel's backdrop dims everything below it,
      so the scrims compose without any depth bookkeeping — a third card puts
      the record at 51%, the editor at 30% and itself at zero, which stays
      monotonic and readable. The insets are the only part that would need a
      third value.
    </p>
    <p>
      The backdrop has to be the component token and not
      <code>--color-background-overlay-backdrop</code>. The lego reads
      <code>var(--side-dialog-backdrop-bg, var(--color-background-overlay-backdrop, …))</code>, and
      <code>component-tokens.css</code> already sets the component token at
      <code>:root</code> from the generic one — so the substitution has happened
      by the time the value reaches a panel, and the generic token has nothing
      left to redirect.
    </p>
    <p>
      Escape unwinds one level at a time, because the lego binds Escape to its
      own panel's <code>keydown</code> rather than to the document. Handing
      focus back is the part that does need code: the lego stores
      <code>document.activeElement</code> at open and calls
      <code>.focus()</code> on it at close, and when the record panel is open
      that reports the <code>&lt;esa-side-dialog&gt;</code> <em>host</em> — real
      focus is inside its shadow root. Focusing a host with no tabindex is a
      no-op, so focus fell to <code>&lt;body&gt;</code> and the second Escape
      did nothing. The editor's close handler restores focus to the control that
      opened it instead.
    </p>
    <p>
      The URL carries the record and not the depth. Beacon's drawers are not
      addressable at all; a link that reopened someone else's half-filled edit
      form would be a worse contract than no link.
    </p>
    <p>
      Widths match at 520px. A wider top card would cover the peek entirely and
      the two would read as one panel that changed its mind.
    </p>
  </Section>

  <Section id="density" title="Density">
    <p>
      The panel runs at beacon-design's drawer scale — a
      <code>--font-size-400</code> name, 15px values, 14px labels — set once as
      a block of <code>--record-*</code> custom properties on the two slot
      scopes. Every record component inside reads them, so a component nested
      three deep picks up the scale without a <code>density</code> prop in three
      signatures.
    </p>
    <p>
      The name takes Inter semibold rather than a smaller Crimson Pro. The
      display serif is the page title's voice, one level up on the same screen,
      and a second serif line inside a drawer over that page competes with it
      instead of sitting under it.
    </p>
  </Section>

  <Section id="behavior" title="Behaviour the lego already handles">
    <p>
      Focus moves into the panel on open and is restored on close, Tab wraps
      inside it, and ✕ / Escape / backdrop all resolve to one <code>close</code>
      event. It carries <code>role="dialog"</code> and
      <code>aria-modal="true"</code>. It does <em>not</em> apply
      <code>inert</code> to the page behind — the trap is JS, not native — so
      background content stays in the accessibility tree.
    </p>
  </Section>

  <Section id="api" title="API">
    <h3>esa-side-dialog</h3>
    <Api props={legoApi} />

    <h3>CSS hooks</h3>
    <Api props={hooks} />
  </Section>

  <BcaUserPanel />
  <BcaUserEditPanel />
  <esa-snackbar-container id="app-toasts"></esa-snackbar-container>
</ComponentDoc>

<script>
  // The panel's own delegated handler listens for anchors; these demo triggers
  // are buttons, so they use the same row-click event the grid dispatches.
  document.querySelectorAll<HTMLElement>('[data-ds-open-user]').forEach((el) =>
    el.addEventListener('click', () => {
      document.dispatchEvent(
        new CustomEvent('bca:user-row-clicked', { detail: { id: el.dataset.dsOpenUser } }),
      );
    }),
  );
</script>
