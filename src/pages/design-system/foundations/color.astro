---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import Section from '@esa/docs/Section.astro';
import ColorScale from '@esa/docs/ColorScale.astro';
import { withBase } from '../../../lib/base';

// The ABI brand palette, as issued. Final — never edited, re-mixed or nudged.
const issued = [
  { step: 'Green', value: '#364500', token: 'bca-brand-green' },
  { step: 'Green Dark', value: '#262903', token: 'bca-brand-green-dark' },
  { step: 'Sage', value: '#918f7a', token: 'bca-brand-sage' },
  { step: 'Sage Dark', value: '#666345', token: 'bca-brand-sage-dark' },
  { step: 'Gold', value: '#ffc261', token: 'bca-brand-gold' },
  { step: 'Gold Dark', value: '#ff9e00', token: 'bca-brand-gold-dark' },
  { step: 'Ash', value: '#e8e5de', token: 'bca-brand-ash' },
  { step: 'Ash Dark', value: '#bfb8a3', token: 'bca-brand-ash-dark' },
  { step: 'Grey', value: '#474540', token: 'bca-brand-grey' },
  { step: 'Grey Dark', value: '#292621', token: 'bca-brand-grey-dark' },
  { step: 'Purple', value: '#45173d', token: 'bca-brand-purple' },
  { step: 'Jade', value: '#bae8c2', token: 'bca-brand-jade' },
];

const ramp = (name: string, hexes: string[]) =>
  hexes.map((value, i) => ({ step: String(i + 1), value, token: `bca-${name}-${i + 1}` }));

const neutral = ramp('neutral', ['#fdfdfc', '#f6f5f4', '#e8e5de', '#dedddb', '#d8d7d4', '#d0cfcc', '#c6c5c1', '#b5b2ad', '#898780', '#7f7c77', '#615f5a', '#21201c']);
const green = ramp('green', ['#fdfdfb', '#f5f6f2', '#e6eae0', '#d6dccc', '#c1c8b2', '#a6b092', '#84906a', '#576631', '#364500', '#262903', '#1d1f00', '#131500']);
const gold = ramp('gold', ['#fefdfb', '#fcf6ee', '#fbefde', '#fee8c8', '#ffe1b4', '#ffd9a2', '#ffd28e', '#ffca79', '#ffc261', '#ca8c02', '#8b5e01', '#473822']);
const sage = ramp('sage', ['#fdfdf7', '#f9f9f3', '#f2f1e9', '#eae9e1', '#e3e2d9', '#dbdad3', '#d0cfc4', '#bebdb2', '#918f7a', '#878570', '#676556', '#22200b']);
const purple = ramp('purple', ['#fefcfe', '#fcf7fb', '#f9ecf5', '#f4dfee', '#edd2e6', '#e4c2db', '#d8aecd', '#c892bb', '#965a89', '#8d5180', '#834877', '#45173d']);
const jade = ramp('jade', ['#fafefb', '#f2fbf4', '#e3f6e6', '#d0f1d5', '#bae8c2', '#a7dcb1', '#95c99f', '#7db087', '#699c73', '#5f9169', '#457750', '#143e20']);

// Semantic roles — these ARE wired under [data-theme="biochar"], so the
// swatches render live via var() and reflect exactly what ships.
const roles = [
  { token: 'color-primary', value: '#364500', note: 'ABI Green at green/9, the Radix home of a solid. Buttons, solid actions, focus rings, the active nav item. 10.46:1 on white, 8.83:1 on the sidenav.' },
  { token: 'color-primary-hover', value: '#262903', note: 'Green Dark — the issued darker green, which falls out of the ramp at green/10 rather than being reached for.' },
  { token: 'color-primary-subtle', value: '#e6eae0', note: 'Tinted fills on canvas and panel only (green/3). It disappears into the shell’s tinted chrome — ΔE 0.0126 against the sidenav — so it is never a state on chrome.' },
  { token: 'color-primary-border', value: '#84906a', note: 'Borders on primary-tinted surfaces (green/7). The first primary border in this palette to clear WCAG 1.4.11: 3.06 on canvas, 3.25 on the panel.' },
  { token: 'color-secondary', value: '#676556', note: 'Sage at text weight (sage/11). Brand Sage itself fills; it never carries body copy.' },
  { token: 'color-info', value: '#676556', note: 'Advisory messages — the quiet one. Sage family.' },
  { token: 'color-success', value: '#177c52', note: 'Positive — suitable, saved, complete. Conventional green, deliberately not a brand color.' },
  { token: 'color-warning', value: '#a45e00', note: 'Caution. Conventional amber at text/icon weight — the brand’s own Gold is 2.07:1 and cannot carry a state.' },
  { token: 'color-danger', value: '#cd2a30', note: 'Negative. Conventional red. Status is functional convention; brand color carries identity.' },
  { token: 'color-text-primary', value: '#21201c', note: 'Body text. 15.59:1 on the panel, 12.90:1 on the topbar — the shell’s darkest surface.' },
  { token: 'color-text-secondary', value: '#474540', note: 'Supporting text — brand Grey, doing real work.' },
  { token: 'color-text-muted', value: '#615f5a', note: 'Meta text. The palette floor: 5.05:1 on the topbar, and anything lighter fails AA there.' },
  { token: 'color-text-link', value: '#45173d', note: 'Purple on light, jade on dark — per the brand guide.' },
  { token: 'color-border', value: '#d0cfcc', note: 'Hairline dividers inside content (neutral/6). The shell’s own seams use bca-chrome-seam.' },
  { token: 'color-surface', value: '#fafaf7', note: 'Cards, the workflow panel, and floating map controls. Near-white for table legibility, tinted just enough to hold an edge against the canvas (ΔE 0.0209).' },
  { token: 'color-background', value: '#f4f3ee', note: 'The canvas — report and landing layouts only. The suitability tool fills its content area edge to edge, so the canvas never paints there.' },
  { token: 'color-surface-sunken', value: '#e8e5de', note: 'Control wells, hover fills and status pills. Brand Ash exactly. No longer the sidebar — see the chrome tokens below.' },
];

// The app shell. Four surfaces in the Sage family, stepped in lightness with
// chroma tapering as they lighten. Chosen by Andy 2026-08-13.
const chrome = [
  { token: 'bca-chrome-topbar', value: '#e6e5dd', note: 'Topbar. The darkest of the four by one tick — ΔE 0.0215 from the sidenav, just over the 0.020 floor. The midpoint of sage/4 and sage/5, so it is a rung of the ramp rather than a value picked to hit a number.' },
  { token: 'bca-chrome-sidenav', value: '#edece5', note: 'App navigation. Sits ΔE 0.0427 from the workflow panel, down from 0.0783 when both this and the topbar were untinted.' },
  { token: 'color-background', value: '#f4f3ee', note: 'Canvas. ΔE 0.0218 from the sidenav.' },
  { token: 'color-surface', value: '#fafaf7', note: 'Panel and cards. ΔE 0.0209 from the canvas.' },
  { token: 'bca-chrome-seam', value: '#deddd4', note: 'The shell hairline. It carries the sidenav/basemap edge outright on map-bearing report layouts, where the two fills sit ΔE 0.0170 apart — under the perceptual floor.' },
];

// Functional scales — the app's data-carrying color, separate from the brand
// ramps that feed the semantic chain.
const suitability = [
  { step: '1', value: '#ffd393', token: 'bca-soh-1' },
  { step: '2', value: '#d9aa0a', token: 'bca-soh-2' },
  { step: '3', value: '#9b8901', token: 'bca-soh-3' },
  { step: '4', value: '#656702', token: 'bca-soh-4' },
  { step: '5', value: '#364500', token: 'bca-soh-5' },
  { step: 'n/a', value: '#dedddb', token: 'bca-soh-nodata' },
];
const bars = [
  { step: '1', value: '#fceeda', token: 'bca-bar-1' },
  { step: '2', value: '#ccbfa0', token: 'bca-bar-2' },
  { step: '3', value: '#9a9369', token: 'bca-bar-3' },
  { step: '4', value: '#686b36', token: 'bca-bar-4' },
  { step: '5', value: '#364500', token: 'bca-bar-5' },
];

// Cartography + badge accents — single-purpose spoke tokens.
const accents = [
  { token: 'bca-badge-recommended', value: '#364500', note: 'Badge ink, "Recommended". Badges share one neutral fill and separate by ink — tinted fills sit 0.008 apart and read as one color.' },
  { token: 'bca-badge-suitable', value: '#473822', note: 'Badge ink, "Suitable".' },
  { token: 'bca-badge-not-recommended', value: '#45173d', note: 'Badge ink, "Not Recommended".' },
  { token: 'bca-badge-excluded', value: '#21201c', note: 'Badge ink, "Excluded".' },
  { token: 'bca-field-stroke', value: '#364500', note: 'Selected field outline on the map.' },
  { token: 'bca-map-land', value: '#f2f1ee', note: 'Basemap land. The map ramp was cleared against this and the other three tile values.' },
  { token: 'bca-map-water', value: '#dfe6e8', note: 'Basemap water.' },
  { token: 'bca-provenance-derived', value: '#615f5a', note: 'SSURGO-derived values. Provenance separates by weight here and by shape in the component.' },
  { token: 'bca-provenance-authored', value: '#21201c', note: 'User-entered and lab-report values.' },
];
---
<DocsLayout title="Color — Biochar Atlas" activeHref="/design-system/foundations/color">
  <nav class="crumbs"><a href={withBase('/design-system')}>Biochar Atlas</a> <span>/</span> <span>Foundations</span> <span>/</span> <span>Color</span></nav>
  <h1>Color</h1>
  <p class="lede">
    The ABI brand palette, extended for app use. The twelve issued colors are final; the ramps
    below are derived from them, and the shell is tinted on the palette's own Sage hue so it
    reads as the same family rather than a gray parked beside it.
  </p>

  <Section id="issued" title="Brand — as issued">
    <p>
      Verbatim from the ABI Brand Guide, and never modified. Reference these wherever the brand
      color itself has to appear — a logo lockup, print parity, a swatch card — rather than a
      ramp step that happens to sit nearby.
    </p>
    <ColorScale name="ABI palette" steps={issued} />
  </Section>

  <Section id="ramps" title="Derived ramps">
    <p>
      Twelve steps each, anchored so the issued hex appears unmodified at the step it actually
      occupies by lightness. That anchor moves per family, and where it lands tells you what the
      color is for: <strong>Green</strong>, <strong>Gold</strong> and <strong>Sage</strong> anchor
      at 9 — they are solid fills. <strong>Purple</strong> anchors at 12, a text and link color.
      <strong>Jade</strong> anchors at 5, a light tint.
    </p>
    <p>
      Steps read the Radix way: 1–2 backgrounds, 3–5 surfaces, 6–7 borders, 8–10 solid fills,
      11–12 text. Green earns its 9 twice over: Green Dark, the issued hover, lands on 10 by
      itself, and steps 11–12 extend past it so pressed states stay inside the scale.
    </p>
    <ColorScale name="Neutral — borders, text and wells, on the palette's own hue (87.1°)" steps={neutral} />
    <ColorScale name="Green — primary" steps={green} />
    <ColorScale name="Gold — accent and CTA fill" steps={gold} />
    <ColorScale name="Sage — secondary" steps={sage} />
    <ColorScale name="Purple — links and the negative signal" steps={purple} />
    <ColorScale name="Jade — the positive tint" steps={jade} />
  </Section>

  <Section id="roles" title="Semantic roles">
    <p>
      What components reference. The Biochar theme re-points these off the ramps above — each
      swatch below renders live from its token, so it reflects exactly what ships.
    </p>
    <div class="roles">
      {roles.map((r) => (
        <div class="role">
          <span class="role__sw" style={`background: var(--${r.token});`}></span>
          <div class="role__body">
            <code>--{r.token}</code>
            <span class="role__val">{r.value}</span>
            <span class="role__note">{r.note}</span>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section id="chrome" title="App shell">
    <p>
      Four surfaces on one hue, stepped in lightness, with chroma tapering as they lighten so the
      tint stays even instead of going chalky at the top. Listed darkest to lightest — the order
      they appear across the screen, left and top inward.
    </p>
    <p>
      Two edges fall under the perceptual floor of ΔE 0.020 and are carried by the seam border
      rather than by fill: the sidenav against basemap land on map-bearing report layouts, and
      white over the panel. The panel cannot clear both the canvas and white — there is 0.036 of
      lightness between them and two visible steps need 0.040 — so it takes the canvas side,
      which is where cards actually sit.
    </p>
    <div class="roles">
      {chrome.map((r) => (
        <div class="role">
          <span class="role__sw" style={`background: var(--${r.token});`}></span>
          <div class="role__body">
            <code>--{r.token}</code>
            <span class="role__val">{r.value}</span>
            <span class="role__note">{r.note}</span>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section id="functional" title="Functional scales">
    <p>
      The app's data-carrying color, kept separate from the brand ramps that feed the semantic
      chain. The <strong>suitability</strong> scale is the national map's five discrete SOH-BC
      classes — a Gold→Green path, which the ABI palette supplies natively. Every adjacent pair
      clears worst-case ΔE 0.120 under protanopia, deuteranopia and tritanopia; ColorBrewer's
      published YlGn-5 measures 0.092 on its own first pair under the same test. Class 1 carries
      chroma on purpose, because a pale achromatic light end collides with both the app chrome
      and the basemap; the freed achromatic value becomes "no data".
    </p>
    <p>
      Labels never sit on classes 2–4 — best ink contrast against class 3 is 4.29:1. Values
      belong in the legend and the readout.
    </p>
    <ColorScale name="SOH-BC suitability — 5 discrete map classes" steps={suitability} />
    <p>
      The <strong>bar</strong> scale is continuous 0–100 indicator scores, single-hue with
      lightness doing the work. The developer guide's screenshots show a red→yellow→green
      gradient; its two ends collapse to ΔE 0.051 under deuteranopia, which makes the two
      readings that matter most the same color. This path holds 0.580 worst-case.
    </p>
    <ColorScale name="Indicator bars — continuous 0–100" steps={bars} />
  </Section>

  <Section id="accents" title="Badge, cartography &amp; provenance accents">
    <p>
      Single-purpose spoke tokens. Provenance matters here: NRCS users need to see at a glance
      whether a soil value came from SSURGO or from their own lab test — and since color is
      already spoken for by the rating classes, provenance separates by weight and by shape.
    </p>
    <div class="roles">
      {accents.map((r) => (
        <div class="role">
          <span class="role__sw" style={`background: var(--${r.token}, ${r.value});`}></span>
          <div class="role__body">
            <code>--{r.token}</code>
            <span class="role__val">{r.value}</span>
            <span class="role__note">{r.note}</span>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section id="theming" title="Theming">
    <p>
      One <code>[data-theme="biochar"]</code> block in <code>theme-biochar.css</code> overrides the
      semantic layer; primitives never move. Links are the exception to chaining off primary — the
      brand guide puts them on Purple, so <code>--color-text-link</code> is set directly.
    </p>
    <p class="note">
      <strong>Gold cannot carry a state.</strong> White on Gold is 1.60:1 and white on Gold Dark
      2.07:1, so Gold fills take dark labels only — Green Dark on Gold is 9.38:1, which is what
      the brand guide's own CTA examples already do. Gold Dark against the canvas is 1.90:1,
      under the 3.0 WCAG 1.4.11 requires of a non-text indicator, so focus rings, selected-state
      borders and icon-only controls come from Green or Purple.
    </p>
    <p class="note">
      <strong>Focus rings are re-pointed.</strong> <code>@esa/tokens</code> defines
      <code>--focus-ring-color</code> twice, and the later one wins:
      <code>component-tokens.css</code> chains it to <code>--color-grass-8</code> (#65ba74),
      a mint green from a ramp this brand doesn't use, measuring 2.18:1 against the canvas —
      below the 3.0 WCAG 1.4.11 requires. This theme points it back at Green, at 9.60:1.
    </p>
  </Section>
</DocsLayout>

<style>
  .roles { display: flex; flex-direction: column; gap: var(--spacing-200, 0.5rem); }
  .role { display: flex; gap: var(--spacing-400, 1rem); align-items: center; padding: var(--spacing-300, 0.75rem) 0; border-bottom: 1px solid var(--color-border-light, #ebe8e1); }
  .role:last-child { border-bottom: 0; }
  .role__sw { width: 40px; height: 40px; border-radius: 8px; flex: none; border: 1px solid color-mix(in srgb, var(--color-text-primary, #000) 10%, transparent); }
  .role__body { display: grid; gap: 1px; }
  .role__body code { font-family: var(--font-mono, monospace); font-size: 14px; color: var(--color-text-primary, #33312a); }
  .role__val { font-family: var(--font-mono, monospace); font-size: 14px; color: var(--color-text-muted, #807c73); text-transform: uppercase; }
  .role__note { font-size: 14px; color: var(--color-text-secondary, #54514a); }

  .note { padding: var(--spacing-300, 0.75rem) var(--spacing-400, 1rem); background: var(--color-surface-sunken, #f3f1ea); border-radius: 8px; font-size: 15px; line-height: 1.55; }
</style>
