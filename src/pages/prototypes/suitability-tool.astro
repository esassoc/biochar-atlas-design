---
// Suitability Tool — the centerpiece prototype, inside the Atlas app shell.
// Left: a small numbered workflow (name → location + soil → goals → biochar
// compare → evaluate/save/clear). Right: Leaflet map with the field boundary,
// SSURGO unit overlays, layer legend, and the floating results card. Scores
// come from the deterministic mock engine in src/data/scoring.ts (calibrated
// to the 78/64 anchors).
//
// Composes esa-* legos per .claude/skills/component-first: esa-text-field
// (assessment name), esa-combobox (field search/select), esa-chip-group
// (goals), esa-select (biochar options), esa-card (compare cards), esa-button,
// esa-collapsible, esa-icon (via shell).
import AppShell from '../../layouts/AppShell.astro';
import '../../styles/biochar-map.css'; // shared Leaflet chrome (tooltip restyle + palette focus ring)
import EsaButton from '@esa/ecology/esa-button.astro';
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaCollapsible from '@esa/ecology/esa-collapsible.astro';
import EsaAlertBox from '@esa/ecology/esa-alert-box.astro';
import BcaInterpretationPanel from '../../components/bca/bca-interpretation-panel.astro';
import { fields } from '../../data/fields';
import { soilUnits, hsgFor } from '../../data/soil-units';
import { biocharCatalog } from '../../data/biochar-catalog';
import { goals } from '../../data/goals';
import { CURRENT_RULESET, BASELINE_RATE_TONS_PER_ACRE } from '../../data/scoring';
import { interpretSite } from '../../data/interpretation';

const defaultField = fields[0];
const defaultSoil = soilUnits.find((s) => s.mukey === defaultField.soilMukey) ?? soilUnits[0];
const defaultInterpretation = interpretSite(defaultSoil);

const fmtCoords = ([lat, lng]: [number, number]): string =>
  `${Math.abs(lat).toFixed(4)}° ${lat >= 0 ? 'N' : 'S'}, ${Math.abs(lng).toFixed(4)}° ${lng >= 0 ? 'E' : 'W'}`;

// Lit array-typed attributes JSON.parse their attribute value.
const fieldOptions = JSON.stringify(
  fields.map((f) => ({ value: f.id, label: `${f.name} · ${f.acres} ac` })),
);
const goalOptions = JSON.stringify(
  goals.map((g) => ({ value: g.id, label: g.label, tone: 'brand' })),
);
const charOptions = JSON.stringify(
  biocharCatalog.map((b) => ({ value: b.id, label: b.name })),
);
// Application-rate choices (tons/acre); the baseline is the default + neutral
// point that reproduces the calibration anchors.
const rateChoices = [1, 2.5, 5, 10, 15, 20];
const rateOptions = JSON.stringify(
  rateChoices.map((r) => ({ value: String(r), label: `${r} tons/acre` })),
);
const defaultRate = String(BASELINE_RATE_TONS_PER_ACRE);
---

<!-- manifest:
  layout: AppShell                                       # page spine — Atlas app shell + sidenav
  sections:
    - assessment workflow (left col)      -> bca-assessment-form       # inline today — extraction planned
    - field readiness (NRCS interpretation) -> bca-interpretation-panel  # compact verdict + side-drawer detail
    - field map (right col)               -> bca-field-map             # inline Leaflet today — extraction planned
    - suitability results card            -> bca-results-card          # client-rendered today — extraction planned
-->

<!-- bcn-lego-checked: composed esa-text-field / esa-combobox / esa-chip-group /
     esa-select / esa-card / esa-button / esa-collapsible. Honest remainders:
     (1) .step-num markers — esa-badge hardcodes pill radius, the 4px-radius
     numbered step marker doesn't fit (logged in NEEDS.md as a hub hook gap);
     (2) the client-rendered results card + score bars — esa-card /
     esa-progress-bar are server-only .astro and these render at runtime from
     scoring output; the no-score uncertainty state DOES reuse the esa-alert-box
     lego (rendered server-side, hidden, its message text patched client-side);
     (3) the map-overlay search pill + Leaflet legend/controls —
     map chrome with no esa- equivalent, matching beacon-design's map
     prototypes. -->

<AppShell title="Biochar Suitability Tool" activeNavId="suitability-tool">
  <div class="tool">
    <!-- ════════ LEFT · workflow ════════ -->
    <section class="config" data-mode="quick" data-field-selected="false" aria-label="Suitability assessment workflow">
      <!-- bcn-lego-checked: the Quick screen / Detailed depth control composes
        esa-button-toggle (hub segmented single-select), sat on the H1 row
        (space-between). Drives data-mode on .config; CSS gates .is-detailed-only
        markup. One workflow, two depths. -->
      <header class="config__head">
        <h1>
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          Suitability Tool
        </h1>
        <esa-button-toggle id="mode-toggle" size="sm"></esa-button-toggle>
      </header>

      <!-- ── Step 1 · Location ── -->
      <div class="block">
        <div class="block__label">
          <span class="step-num" aria-hidden="true">1</span>
          <h2>Where's your field?</h2>
        </div>

        <!-- bcn-lego-checked: per-step guidance composes the esa-popover lego
             (click trigger in the default slot, help copy in slot="content").
             The trigger is a minimal text+icon affordance matching the page's
             existing .text-action convention — esa-button's chrome is too heavy
             for an inline help link, and esa-icon-link is an href anchor, not a
             popover trigger. Checked Ecology + Beacon. -->
        <esa-popover class="step-guide" position="right" trigger="click" style="--popover-max-width: 320px;">
          <button type="button" class="step-guide__trigger">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <span>How is soil derived?</span>
          </button>
          <div slot="content" class="step-guide__content">
            <p>Click a field on the map and its soil properties pull automatically from USDA's <strong>SSURGO</strong> survey — the same soil database NRCS uses. Expand <em>Soil details</em> for the full profile, survey area, and map-unit key.</p>
          </div>
        </esa-popover>

        <esa-combobox
          id="field-combobox"
          class="field-combobox"
          mode="select"
          size="md"
          placeholder="Search or select a field…"
          options={fieldOptions}
        ></esa-combobox>

        <div class="card location">
          <!-- Empty state: shown until a field is picked (no defaults on load). -->
          <p class="location__empty is-when-empty">
            Pick a field on the map or search above — its soil and field readiness
            auto-derive from SSURGO once you do.
          </p>

          <div class="location__summary is-when-field">
            <div class="location__thumb" aria-hidden="true">
              <svg viewBox="0 0 64 64" width="56" height="56">
                <rect width="64" height="64" rx="6" fill="var(--bca-parchment-100, #ece9d8)" />
                <path d="M0 38 C18 30 30 44 64 34" fill="none" stroke="var(--bca-water, #b8cfd8)" stroke-width="3" />
                <rect x="24" y="24" width="18" height="14" fill="var(--bca-field-fill, rgba(78,125,82,0.28))" stroke="var(--bca-field-stroke, #234a31)" stroke-width="2" />
              </svg>
            </div>
            <div class="location__body">
              <div class="location__coords mono" data-field="coords">{fmtCoords(defaultField.centroid)}</div>
              <div class="location__name" data-field="name">
                {defaultField.name} · {defaultField.locality} · {defaultField.acres} ac
              </div>
              <button type="button" class="text-action" title="Prototype — boundary editing is planned">Edit boundary</button>
            </div>
          </div>

          <div class="soil is-when-field">
            <div class="soil__head">
              <span class="soil__label">Soil context</span>
              <span class="soil__provenance" data-soil="provenance">Auto-derived from SSURGO</span>
            </div>
            <div class="soil__series" data-soil="name">{defaultSoil.name.split(',')[0]}</div>
            <div class="soil__taxonomy" data-soil="taxonomy">{defaultSoil.taxonomy}</div>

            <!-- Full stat grid. Quick screen keeps it behind the "Soil details"
                 disclosure; Detailed forces it open (summary hidden via CSS). -->
            <details class="soil__disclosure">
              <summary class="soil__disclosure-summary">Soil details</summary>
              <div class="soil__disclosure-body">
                <dl class="soil__stats">
                  <div><dt>Clay</dt><dd class="mono" data-soil="clay">{defaultSoil.clayPct}%</dd></div>
                  <div><dt>Organic matter</dt><dd class="mono" data-soil="om">{defaultSoil.omPct}%</dd></div>
                  <div><dt>pH (1:1 H₂O)</dt><dd class="mono" data-soil="ph">{defaultSoil.ph}</dd></div>
                  <div><dt>CEC</dt><dd class="mono" data-soil="cec">{defaultSoil.cecCmolKg} meq/100g</dd></div>
                </dl>
                <EsaCollapsible title="Show 7 more properties" flush>
                  <dl class="soil__more">
                    <div><dt>Drainage class</dt><dd data-soil="drainage">{defaultSoil.drainageClass}</dd></div>
                    <div><dt>Hydrologic soil group</dt><dd class="mono" data-soil="hsg">{hsgFor(defaultSoil)}</dd></div>
                    <div><dt>Available water capacity</dt><dd class="mono" data-soil="awc">{defaultSoil.awcInPerIn} in/in</dd></div>
                    <div><dt>Profile depth</dt><dd class="mono" data-soil="depth">{defaultSoil.depthIn} in</dd></div>
                    <div><dt>Slope</dt><dd class="mono" data-soil="slope">{defaultSoil.slopePct}%</dd></div>
                    <div><dt>Surface texture</dt><dd data-soil="texture">{defaultSoil.texture}</dd></div>
                    <div><dt>Farmland class</dt><dd data-soil="farmland">{defaultSoil.farmlandClass}</dd></div>
                  </dl>
                </EsaCollapsible>
                <div class="soil__source">
                  <span class="mono" data-soil="source">SSURGO · {defaultSoil.surveyArea} · MUKEY {defaultSoil.mukey}</span>
                </div>
              </div>
            </details>
          </div>
          <div class="is-when-field">
            <BcaInterpretationPanel result={defaultInterpretation} />
          </div>
        </div>
      </div>

      <!-- ── Step 2 · Goals ── -->
      <div class="block">
        <div class="block__label">
          <span class="step-num" aria-hidden="true">2</span>
          <h2>What are you trying to improve?</h2>
        </div>
        <!-- bcn-lego-checked: esa-popover guidance affordance (see Step 1 note). -->
        <esa-popover class="step-guide" position="right" trigger="click" style="--popover-max-width: 320px;">
          <button type="button" class="step-guide__trigger">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <span>How do goals work?</span>
          </button>
          <div slot="content" class="step-guide__content">
            <p>Pick what you want this field to do, in plain terms. Each goal maps to the soil-response factors the science scores against — choose as many as apply, and the suitability scores weight toward them.</p>
          </div>
        </esa-popover>
        <esa-chip-group
          id="goal-chips"
          multiple
          size="md"
          label="Biochar application goals"
          options={goalOptions}
          values="[]"
        ></esa-chip-group>
      </div>

      <!-- ── Step 3 · Compare biochars ── -->
      <div class="block">
        <div class="block__label">
          <span class="step-num" aria-hidden="true">3</span>
          <h2>Which biochars are you weighing?</h2>
        </div>
        <!-- bcn-lego-checked: esa-popover guidance affordance (see Step 1 note). -->
        <esa-popover class="step-guide" position="right" trigger="click" style="--popover-max-width: 320px;">
          <button type="button" class="step-guide__trigger">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <span>How do I choose?</span>
          </button>
          <div slot="content" class="step-guide__content">
            <p>Choose one or two biochars from the curated catalog to weigh side by side. Each lists its lab specs — feedstock, highest treatment temperature (HTT), fixed carbon, and surface area — the properties that drive performance.</p>
          </div>
        </esa-popover>
        <div class="compare">
          {(['a', 'b'] as const).map((slot) => {
            return (
              <EsaCard variant="outlined" padding="compact">
                <div class="compare-option" data-slot={slot}>
                  <esa-select
                    data-char-select={slot}
                    label={`Option ${slot.toUpperCase()}`}
                    placeholder="Select…"
                    size="md"
                    options={charOptions}
                  ></esa-select>
                  {/* Spec lines render empty (—) until a biochar is picked; the
                      page script fills them on selection (and on Clear). */}
                  <dl class="compare-option__stats">
                    <div><dt>Feedstock</dt><dd class="mono" data-char-stat="feedstock">—</dd></div>
                    <div><dt>HTT</dt><dd class="mono" data-char-stat="htt">—</dd></div>
                    <div><dt>Fixed C</dt><dd class="mono" data-char-stat="fixedC">—</dd></div>
                    <div><dt>Surface area</dt><dd class="mono" data-char-stat="surface">—</dd></div>
                  </dl>

                  {/* Application controls — Detailed mode only (answers Q8:
                      compare materials AND rates/compost). Wired into the
                      deterministic scoring; baseline rate + compost off = no
                      change to the calibration anchors. */}
                  <div class="compare-option__app is-detailed-only">
                    <esa-select
                      data-rate-select={slot}
                      label="Application rate"
                      size="sm"
                      options={rateOptions}
                    ></esa-select>
                    <esa-checkbox
                      data-compost-toggle={slot}
                      size="sm"
                      label="Co-apply compost"
                    ></esa-checkbox>
                  </div>
                </div>
              </EsaCard>
            );
          })}
        </div>
      </div>

      <!-- ── Actions ── -->
      <div class="actions">
        <span id="save-btn" class="is-detailed-only"><EsaButton color="ghost" appearance="outline" size="md">Save</EsaButton></span>
        <span id="clear-btn" class="is-detailed-only"><EsaButton color="ghost" size="md">Clear</EsaButton></span>
        <span id="evaluate-btn" class="actions__primary"><EsaButton color="primary" size="md" icon="arrow-right">Evaluate suitability</EsaButton></span>
      </div>
      <p class="actions__status" id="actions-status" hidden></p>

      <p class="config__disclaimer">
        Field assessments are advisory; producers should consult NRCS conservationists before application.
      </p>
    </section>

    <!-- ════════ RIGHT · Map ════════ -->
    <section class="mappane" aria-label="Field map">
      <div id="map"></div>

      <!-- search (visual prototype; map-overlay control, see lego note above) -->
      <div class="map-search">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" placeholder="Search address, county, or PLSS…" title="Prototype — search is planned" />
      </div>

      <!-- layer legend -->
      <div class="map-legend" aria-label="Map layers">
        <div class="map-legend__title">Map layers</div>
        <ul id="legend-list"></ul>
      </div>

      <!-- mock data-source badge (CARTO/OSM attribution stays in Leaflet's control) -->
      <div class="map-sources mono">USDA NRCS SSURGO · USGS NHD · OR Geo Hub</div>

      <!-- ── floating results card (client-rendered; see lego note above) ──
        data-confidence reflects the field-readiness verdict (set in showResults):
        confident → 0–100 scores shown (the hero path, unchanged); blocked →
        a hard site constraint means no score is responsible, so the score bars
        are withheld and the esa-alert-box explains why. This is SCIENTIFIC
        uncertainty (in the result), in the warm product palette. -->
      <aside class="results" id="results" data-confidence="confident" hidden aria-label="Suitability results">
        <div class="results__kicker">Suitability for selected goals</div>
        <h2 class="results__title" id="results-title">—</h2>

        <!-- No-score state (hard constraint) — replaces the scores; populated in
             showResults(). Reuses the esa-alert-box danger lego. -->
        <div class="results__noscore" id="results-noscore" hidden role="status">
          <EsaAlertBox variant="danger" title="Can't be responsibly scored here">
            <span data-noscore-text></span>
          </EsaAlertBox>
        </div>

        <ol class="results__rows" id="results-rows"></ol>
        <p class="results__narrative" id="results-narrative"></p>
        <details class="results__why">
          <summary>Why these scores</summary>
          <ul id="results-why-list"></ul>
        </details>
        <div class="results__footer">
          <span class="mono results__ruleset">{CURRENT_RULESET.label} ruleset</span>
          <button type="button" class="results__download" id="download-report" title="Open the field-ready report">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>
            Download report (PDF)
          </button>
        </div>
        <div class="results__toast" id="results-toast" hidden>The printable report is the next prototype on the roadmap.</div>
      </aside>
    </section>
  </div>
</AppShell>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  // Register the esa-* web components used in the markup above.
  import '@esa/ecology/esa-text-field';
  import '@esa/ecology/esa-combobox';
  import '@esa/ecology/esa-chip-group';
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-checkbox';
  import '@esa/ecology/esa-popover';
  import '@esa/ecology/esa-switch-toggle';
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-side-dialog';
  import { parcels } from '../../data/parcels';
  import { fields } from '../../data/fields';
  import { soilUnits, hsgFor } from '../../data/soil-units';
  import { biocharCatalog } from '../../data/biochar-catalog';
  import { goals } from '../../data/goals';
  import { compareBiochars, DEFAULT_APP_OPTIONS, BASELINE_RATE_TONS_PER_ACRE } from '../../data/scoring';
  import type { AppOptions } from '../../data/scoring';
  import { interpretSite } from '../../data/interpretation';
  import { withBase } from '../../lib/base';
  import {
    MAP_CENTER,
    MAP_ZOOM,
    TILE_URL,
    TILE_ATTRIBUTION,
    mapLayers,
  } from '../../data/map-fixture';
  import type { FieldSite } from '../../data/fields';

  // ───────────────────────── state ─────────────────────────
  // Null/empty on load: nothing is pre-selected. The user picks a field, goals,
  // and biochars; Evaluate stays disabled until field + ≥1 goal + ≥1 biochar.
  const state = {
    fieldId: null as string | null,
    goalIds: new Set<string>(),
    chars: { a: null, b: null } as Record<'a' | 'b', string | null>,
    // Per-slot application options (rate + compost). Start at the neutral
    // baseline so a fresh selection reproduces the calibration anchors.
    apps: {
      a: { ...DEFAULT_APP_OPTIONS },
      b: { ...DEFAULT_APP_OPTIONS },
    } as Record<'a' | 'b', AppOptions>,
  };

  // Interpretation (site-response) UI state: which factors are toggled off, plus
  // the tile-drainage answer. Independent of the biochar evaluation below.
  const interp = {
    disabled: new Set<string>(),
    tiled: false,
  };

  const byId = <T extends { id: string }>(list: T[], id: string): T =>
    list.find((x) => x.id === id) ?? list[0];
  // Null-aware lookups: return null when nothing is selected (empty state).
  const field = (): FieldSite | null =>
    state.fieldId ? fields.find((f) => f.id === state.fieldId) ?? null : null;
  const soil = () => {
    const f = field();
    return f ? soilUnits.find((s) => s.mukey === f.soilMukey) ?? null : null;
  };

  const fmtCoords = ([lat, lng]: [number, number]): string =>
    `${Math.abs(lat).toFixed(4)}° ${lat >= 0 ? 'N' : 'S'}, ${Math.abs(lng).toFixed(4)}° ${lng >= 0 ? 'E' : 'W'}`;

  /** createElement + class + text, the safe-DOM way (no innerHTML anywhere). */
  const el = <K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ): HTMLElementTagNameMap[K] => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  // The esa-* form controls (value accessors + composed 'change' events).
  type ValueControl = HTMLElement & { value: string | string[] | null; errorText?: string };
  const fieldCombobox = document.getElementById('field-combobox') as ValueControl | null;
  const goalChips = document.getElementById('goal-chips') as
    | (HTMLElement & { values: string[] })
    | null;
  const charSelects: Record<'a' | 'b', ValueControl | null> = {
    a: document.querySelector('[data-char-select="a"]'),
    b: document.querySelector('[data-char-select="b"]'),
  };
  // Application-rate selects + compost checkboxes (Detailed-mode controls).
  const rateSelects: Record<'a' | 'b', ValueControl | null> = {
    a: document.querySelector('[data-rate-select="a"]'),
    b: document.querySelector('[data-rate-select="b"]'),
  };
  const compostToggles: Record<'a' | 'b', (HTMLElement & { checked: boolean }) | null> = {
    a: document.querySelector('[data-compost-toggle="a"]'),
    b: document.querySelector('[data-compost-toggle="b"]'),
  };

  // Empty state on load: leave the field combobox, biochar selects, and goal
  // chips unselected. They populate only when the user makes a choice. The
  // application controls DO start at their baseline (rate select shows the
  // default, compost off) — they're a refinement of a chosen biochar, not a
  // selection gate.
  if (goalChips) goalChips.values = [];
  for (const slot of ['a', 'b'] as const) {
    if (rateSelects[slot]) rateSelects[slot]!.value = String(BASELINE_RATE_TONS_PER_ACRE);
    if (compostToggles[slot]) compostToggles[slot]!.checked = false;
  }

  // ───────────────────────── mode (quick screen / detailed) ─────────────────────────
  // One workflow at two depths. The toggle sets data-mode on the .config root;
  // CSS gates .is-detailed-only markup. Default = quick screen (the calm first
  // pass for a farmer); detailed reveals the full professional controls.
  type ViewMode = 'quick' | 'detailed';
  const configEl = document.querySelector('.config') as HTMLElement | null;
  const modeToggle = document.getElementById('mode-toggle') as
    | (HTMLElement & { options: unknown[]; value: string })
    | null;
  const whyDetails = document.querySelector<HTMLDetailsElement>('.results__why');
  const soilDisclosure = document.querySelector<HTMLDetailsElement>('.soil__disclosure');

  function applyMode(mode: ViewMode) {
    const detailed = mode === 'detailed';
    if (configEl) configEl.setAttribute('data-mode', mode);
    // The soil grid lives in a native <details>; a closed one won't render its
    // body whatever the CSS says, so force it open for the pro view (and fold it
    // back for the calm quick screen).
    if (soilDisclosure) soilDisclosure.open = detailed;
    // "Why these scores" rides with the mode: expanded for pros, collapsed in
    // quick screen (it lives in the map pane, out of CSS reach, so set it here).
    if (whyDetails) whyDetails.open = detailed;
  }
  if (modeToggle) {
    modeToggle.options = [
      { value: 'quick', label: 'Quick screen' },
      { value: 'detailed', label: 'Detailed' },
    ];
    modeToggle.value = 'quick';
    modeToggle.addEventListener('change', (e) => {
      const value = (e as CustomEvent).detail?.value;
      if (value === 'quick' || value === 'detailed') applyMode(value);
    });
  }

  // ───────────────────────── map ─────────────────────────
  // Open wide (the full 20-parcel farm belt, a valley-scale view);
  // fly to a field's own bounds when it's explicitly picked.
  const mapEl = document.getElementById('map');
  const map = L.map(mapEl!, { zoomControl: true, attributionControl: true }).setView(
    MAP_CENTER,
    MAP_ZOOM,
  );
  {
    // Fit the parcel belt only (the demo fields ARE these parcels).
    const bounds = L.latLngBounds([]);
    for (const p of parcels) for (const [lng, lat] of p.ring) bounds.extend([lat, lng]);
    map.fitBounds(bounds.pad(0.06), { maxZoom: 14 });
  }
  L.tileLayer(TILE_URL, { attribution: TILE_ATTRIBUTION, maxZoom: 19 }).addTo(map);
  L.control.scale({ imperial: true, metric: false, position: 'bottomleft' }).addTo(map);

  // North arrow (static custom control)
  const North = L.Control.extend({
    onAdd() {
      const arrow = L.DomUtil.create('div', 'north-arrow');
      arrow.append('▲', el('span', undefined, 'N'));
      arrow.title = 'North';
      return arrow;
    },
  });
  new North({ position: 'topright' }).addTo(map);

  const fieldStroke = '#234a31';
  const fieldFill = 'rgba(78, 125, 82, 0.28)';

  // Layer groups, keyed by the legend registry ids in map-fixture.ts
  const groups: Record<string, L.LayerGroup> = {};

  // Selected field boundary (rebuilt on field switch; empty until a field exists)
  groups['selected-field-boundary'] = L.layerGroup();
  function drawBoundary() {
    groups['selected-field-boundary'].clearLayers();
    const f = field();
    if (!f) return; // empty state — parcels only, no selected-field overlay
    const boundary = L.geoJSON(
      { type: 'Feature', geometry: f.boundary, properties: {} } as GeoJSON.Feature,
      { style: { color: fieldStroke, weight: 2.5, fillColor: fieldFill, fillOpacity: 0.5 } },
    );
    boundary.bindTooltip(`Selected field · ${f.acres} ac · MUKEY ${f.soilMukey}`, {
      sticky: true,
    });
    groups['selected-field-boundary'].addLayer(boundary);
  }

  // Surrounding parcels — REAL OSM farmland geometry (scripts/fetch-parcels.mjs),
  // styled as a parchment patchwork. Tone is assigned
  // deterministically in the fixture so the patchwork never reshuffles.
  const PARCEL_TONES = [
    '#e7e1c8',
    '#dee3cd',
    '#d8d2b4',
    '#cfd9c0',
    '#e3ddc4',
    '#d2cdb0',
    '#dce0c6',
    '#e9e4d0',
  ];
  // Parcels double as the field pickers: click one to assess it (the demo
  // fields ARE these parcels — no separate markers needed).
  groups['surrounding-parcels'] = L.layerGroup();
  // Resolve the shared parcel stroke from the theme token once (Leaflet's
  // canvas paint takes a literal, not a CSS var; --bca-parcel-stroke is the
  // single source of truth, mirrored by the legend swatch CSS).
  const parcelStroke =
    getComputedStyle(document.documentElement).getPropertyValue('--bca-parcel-stroke').trim() ||
    '#b3ac92';
  for (const parcel of parcels) {
    const fill = PARCEL_TONES[parcel.tone % PARCEL_TONES.length];
    const f = fields.find((x) => x.id === parcel.id);
    const layer = L.polygon(
      parcel.ring.map(([lng, lat]) => [lat, lng] as [number, number]),
      { color: parcelStroke, weight: 1, fillColor: fill, fillOpacity: 0.55 },
    )
      .bindTooltip(`${f?.name ?? 'Farmland parcel'} · ${parcel.acres} ac — click to assess`, {
        sticky: true,
      })
      .on('click', () => setFieldAndSync(parcel.id))
      .on('mouseover', () => layer.setStyle({ fillOpacity: 0.78, weight: 1.5 }))
      .on('mouseout', () => layer.setStyle({ fillOpacity: 0.55, weight: 1 }));
    layer.addTo(groups['surrounding-parcels']);
  }

  drawBoundary();

  // Legend — built from the fixture registry; checkboxes add/remove layer groups
  const legendList = document.getElementById('legend-list');
  const SWATCH: Record<string, string> = {
    'selected-field-boundary': 'swatch--field',
    'surrounding-parcels': 'swatch--parcels',
  };
  for (const entry of mapLayers) {
    const group = groups[entry.id];
    if (!group) continue;
    if (entry.defaultOn) group.addTo(map);
    const li = el('li', 'map-legend__row');
    const cb = document.createElement('esa-checkbox') as HTMLElement & { checked: boolean };
    cb.setAttribute('size', 'sm');
    cb.setAttribute('aria-label', `Toggle ${entry.label}`);
    cb.checked = entry.defaultOn;
    const setLayer = (on: boolean) => {
      if (on) group.addTo(map);
      else map.removeLayer(group);
    };
    cb.addEventListener('change', (e) => setLayer((e as CustomEvent).detail?.checked ?? cb.checked));
    const swatch = el('span', `swatch ${SWATCH[entry.id] ?? ''}`);
    const name = el('span', 'map-legend__name', entry.label);
    // Clicking the swatch/name toggles too (esa-checkbox only toggles itself).
    const rowToggle = () => {
      cb.checked = !cb.checked;
      setLayer(cb.checked);
    };
    swatch.addEventListener('click', rowToggle);
    name.addEventListener('click', rowToggle);
    li.append(cb, swatch, name);
    legendList?.appendChild(li);
  }

  // Keep Leaflet sized to its pane (sidebar collapse changes the width)
  if (mapEl) new ResizeObserver(() => map.invalidateSize()).observe(mapEl);

  // ───────────────────────── results card ─────────────────────────
  const resultsEl = document.getElementById('results');

  function hideResults() {
    if (resultsEl) resultsEl.hidden = true;
  }

  // Results-card child elements the no-score state toggles.
  const noScorePanel = document.getElementById('results-noscore');
  const noScoreText = noScorePanel?.querySelector<HTMLElement>('[data-noscore-text]') ?? null;
  const rowsEl = document.getElementById('results-rows');
  const narrativeEl = document.getElementById('results-narrative');
  const whyDetailsEl = document.querySelector<HTMLDetailsElement>('.results__why');

  type Confidence = 'confident' | 'blocked';
  /** Map the field-readiness state to the result's scientific confidence.
   *  HARD CASES ONLY: a poorly-suited verdict OR a hard site constraint (a
   *  use-invariant site limit biochar can't fix — ponding, karst, frequent
   *  flooding) means no 0–100 score is defensible, so the card withholds the
   *  bars. Well/moderate fields score confidently — moderate-suitability is
   *  NOT caveated (per the product decision; keeps the hero's 78/64 clean).
   *  bcn-lego-checked: logic-only change in the page script, no UI primitive. */
  function confidenceFor(site: ReturnType<typeof interpretSite>): Confidence {
    return (site.hardConstraint || site.verdict === 'poor') ? 'blocked' : 'confident';
  }

  function showResults() {
    const s = soil();
    const f = field();
    if (!s || !f) return; // guarded by syncEvaluateDisabled; satisfies the types
    // Same interpretation the field-readiness panel shows — honors the user's
    // factor toggles + tile-drainage answer, so the no-score state stays in
    // lockstep with the readiness verdict above it.
    const site = interpretSite(s, { disabledKeys: interp.disabled, tiled: interp.tiled });
    const confidence = confidenceFor(site);
    const blocked = confidence === 'blocked';
    if (resultsEl) resultsEl.setAttribute('data-confidence', confidence);

    // Compare only the biochars the user actually selected (one or both slots),
    // each with its own application rate + compost options (parallel arrays, so
    // apps[i] stays paired with the biochar from the same slot).
    const chosen: typeof biocharCatalog = [];
    const chosenApps: AppOptions[] = [];
    for (const slot of ['a', 'b'] as const) {
      const id = state.chars[slot];
      if (!id) continue;
      chosen.push(byId(biocharCatalog, id));
      chosenApps.push(state.apps[slot]);
    }
    const compared = compareBiochars(s, chosen, [...state.goalIds], chosenApps);

    const title = document.getElementById('results-title');
    if (title) {
      title.textContent = `${f.name} · ${s.name.split(',')[0]}`;
    }

    // ── No-score state (poorly-suited verdict OR hard constraint) ──
    // Lead with the specific site limit, then say plainly that no 0–100 score is
    // defensible here whatever the biochar. When a constraint flag exists we name
    // it; otherwise the readiness narrative already carries the reason.
    if (noScorePanel) {
      noScorePanel.hidden = !blocked;
      if (blocked && noScoreText) {
        const tail =
          `So a 0–100 suitability score isn't defensible here — whichever biochar ` +
          `you choose. Review the field with an NRCS conservationist first.`;
        noScoreText.textContent = site.flags[0]
          ? `${site.flags[0]} It's a use-invariant site limit biochar can't change. ${tail}`
          : `${site.narrative} ${tail}`;
      }
    }
    // Withhold the score-bearing parts when blocked; restore otherwise.
    if (rowsEl) rowsEl.hidden = blocked;
    if (narrativeEl) narrativeEl.hidden = blocked;
    if (whyDetailsEl) whyDetailsEl.hidden = blocked;

    if (blocked) {
      if (resultsEl) resultsEl.hidden = false;
      return; // no scores to render
    }

    const rows = rowsEl;
    if (rows) {
      rows.replaceChildren();
      for (const entry of compared) {
        const li = el('li', 'score-row');
        const head = el('div', 'score-row__head');
        head.appendChild(el('span', 'score-row__name', entry.biochar.name));
        if (entry.recommended) head.appendChild(el('span', 'rec-chip', 'Best fit'));
        const num = el('span', 'score-row__num');
        num.append(el('strong', undefined, String(entry.result.total)), el('span', undefined, '/100'));
        head.appendChild(num);
        const bar = el('div', 'score-bar');
        const fill = el('i');
        fill.style.width = '0%';
        bar.appendChild(fill);
        li.append(head, bar);
        rows.appendChild(li);
        // animate after insertion
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            fill.style.width = `${entry.result.total}%`;
          }),
        );
      }
    }

    const narrative = document.getElementById('results-narrative');
    const top = compared[0];
    if (narrative && top) {
      // Bold the leading biochar name (the narrative always starts with it).
      const text = top.result.narrative;
      const splitAt = text.indexOf(' is ');
      narrative.replaceChildren();
      if (splitAt > 0) {
        narrative.append(el('strong', undefined, text.slice(0, splitAt)), text.slice(splitAt));
      } else {
        narrative.textContent = text;
      }
    }

    // bcn-lego-checked: client-rendered rows inside the existing results card
    // (covered by the card lego note above); no new component.
    const why = document.getElementById('results-why-list');
    const whySummary = document.querySelector('.results__why summary');
    if (why && top) {
      why.replaceChildren();
      if (compared.length >= 2) {
        // Full A/B comparison: show EVERY goal side by side so the trade-off is
        // legible (where each biochar wins), not just the recommended pick's
        // rationale. Both biochars expose perGoal in the same goal order.
        if (whySummary) whySummary.textContent = 'Compare scores by goal';
        why.classList.add('is-compare');
        const [colA, colB] = compared; // colA is the recommended (best-first) pick
        const bScoreByGoal = new Map(colB.result.perGoal.map((g) => [g.goalId, g.score]));
        const head = el('li', 'cmp-row cmp-row--head');
        head.append(
          el('span', 'cmp-goal cmp-goal--head', 'By goal'),
          el('span', 'cmp-col cmp-col--head is-rec', colA.biochar.name),
          el('span', 'cmp-col cmp-col--head', colB.biochar.name),
        );
        why.appendChild(head);
        for (const g of colA.result.perGoal) {
          const goal = goals.find((x) => x.id === g.goalId);
          const a = g.score;
          const b = bScoreByGoal.get(g.goalId) ?? 0;
          const aCol = el('span', 'cmp-col mono', String(a));
          const bCol = el('span', 'cmp-col mono', String(b));
          if (a > b) aCol.classList.add('is-win');
          else if (b > a) bCol.classList.add('is-win');
          const row = el('li', 'cmp-row');
          row.append(el('span', 'cmp-goal', goal?.label ?? g.goalId), aCol, bCol);
          why.appendChild(row);
        }
      } else {
        // Single biochar: the per-goal rationale list.
        if (whySummary) whySummary.textContent = 'Why these scores';
        why.classList.remove('is-compare');
        for (const g of top.result.perGoal) {
          const goal = goals.find((x) => x.id === g.goalId);
          const li = el('li');
          li.append(
            el('span', 'why-goal', goal?.label ?? g.goalId),
            el('span', 'why-score mono', String(g.score)),
            el('span', 'why-text', g.rationale),
          );
          why.appendChild(li);
        }
      }
    }

    if (resultsEl) resultsEl.hidden = false;
  }

  // ───────────────────────── actions ─────────────────────────
  const statusEl = document.getElementById('actions-status');
  let statusTimer: ReturnType<typeof setTimeout> | null = null;
  function setStatus(message: string) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.hidden = !message;
    if (statusTimer) clearTimeout(statusTimer);
    if (message) statusTimer = setTimeout(() => (statusEl.hidden = true), 3200);
  }

  const evalNative = document.querySelector<HTMLButtonElement>('#evaluate-btn .esa-button__native');
  function syncEvaluateDisabled() {
    if (!evalNative) return;
    // Need a field, at least one goal, and at least one biochar to evaluate.
    const hasField = state.fieldId !== null;
    const hasGoal = state.goalIds.size > 0;
    const hasChar = !!(state.chars.a || state.chars.b);
    const ready = hasField && hasGoal && hasChar;
    evalNative.disabled = !ready;
    evalNative.title = ready
      ? ''
      : !hasField
        ? 'Select a field to evaluate'
        : !hasGoal
          ? 'Select at least one goal to evaluate'
          : 'Select at least one biochar to evaluate';
  }
  evalNative?.addEventListener('click', () => {
    if (evalNative.disabled) return;
    hideResults();
    const labelEl = evalNative.querySelector('.esa-button__label') ?? evalNative;
    const original = labelEl.textContent;
    labelEl.textContent = 'Evaluating…';
    evalNative.disabled = true;
    setTimeout(() => {
      labelEl.textContent = original;
      evalNative.disabled = false;
      showResults();
    }, 900);
  });

  document
    .querySelector<HTMLButtonElement>('#save-btn .esa-button__native')
    ?.addEventListener('click', () => {
      // Naming is deferred: an assessment auto-names from its field + soil (rename
      // later from Saved Assessments). Removes the cold-start name field while
      // Save still demonstrates the Saved Assessments on-ramp for the pro path.
      const f = field();
      const s = soil();
      if (!f || !s) {
        setStatus('Pick a field before saving.');
        return;
      }
      const name = `${f.name} · ${s.name.split(',')[0]}`;
      setStatus(`Saved “${name}” — find it under Saved Assessments (prototype; persistence is planned).`);
    });

  document
    .querySelector<HTMLButtonElement>('#clear-btn .esa-button__native')
    ?.addEventListener('click', () => {
      // Clear → back to the empty state (nothing selected), matching first load.
      state.goalIds = new Set<string>();
      if (goalChips) goalChips.values = [];
      state.chars = { a: null, b: null };
      if (charSelects.a) charSelects.a.value = '';
      if (charSelects.b) charSelects.b.value = '';
      // Reset application options to the neutral baseline + their controls.
      state.apps = { a: { ...DEFAULT_APP_OPTIONS }, b: { ...DEFAULT_APP_OPTIONS } };
      for (const slot of ['a', 'b'] as const) {
        if (rateSelects[slot]) rateSelects[slot]!.value = String(BASELINE_RATE_TONS_PER_ACRE);
        if (compostToggles[slot]) compostToggles[slot]!.checked = false;
      }
      syncCharCard('a');
      syncCharCard('b');
      syncSelectDisabling();
      interp.disabled.clear();
      interp.tiled = false;
      if (tileToggle) tileToggle.checked = false;
      state.fieldId = null;
      if (fieldCombobox) fieldCombobox.value = '';
      configEl?.setAttribute('data-field-selected', 'false');
      groups['selected-field-boundary'].clearLayers();
      hideResults();
      syncEvaluateDisabled();
      setStatus('Cleared.');
    });

  document.getElementById('download-report')?.addEventListener('click', () => {
    window.open(withBase('/prototypes/assessment-report'), '_blank', 'noopener');
  });

  // ───────────────────────── workflow interactions ─────────────────────────

  // Step 1 · field switching (combobox + map markers)
  function setField(id: string) {
    if (id === state.fieldId) return;
    state.fieldId = id;
    const f = field();
    const s = soil();
    if (!f || !s) return;
    // Leaving the empty state: reveal soil + readiness + the field summary.
    configEl?.setAttribute('data-field-selected', 'true');

    const set = (key: string, text: string) => {
      const node = document.querySelector(`[data-field="${key}"]`);
      if (node) node.textContent = text;
    };
    set('coords', fmtCoords(f.centroid));
    set('name', `${f.name} · ${f.locality} · ${f.acres} ac`);

    const soilSet = (key: string, text: string) => {
      const node = document.querySelector(`[data-soil="${key}"]`);
      if (node) node.textContent = text;
    };
    soilSet('name', s.name.split(',')[0]);
    soilSet('taxonomy', s.taxonomy);
    soilSet('clay', `${s.clayPct}%`);
    soilSet('om', `${s.omPct}%`);
    soilSet('ph', String(s.ph));
    soilSet('cec', `${s.cecCmolKg} meq/100g`);
    soilSet('drainage', s.drainageClass);
    soilSet('hsg', hsgFor(s));
    soilSet('awc', `${s.awcInPerIn} in/in`);
    soilSet('depth', `${s.depthIn} in`);
    soilSet('slope', `${s.slopePct}%`);
    soilSet('texture', s.texture);
    soilSet('farmland', s.farmlandClass);
    soilSet('source', `SSURGO · ${s.surveyArea} · MUKEY ${s.mukey}`);

    drawBoundary();
    const b = L.latLngBounds([]);
    for (const ring of f.boundary.coordinates)
      for (const [lng, lat] of ring) b.extend([lat, lng]);
    map.flyToBounds(b.pad(0.6), { duration: 0.8, maxZoom: 15 });
    renderInterpretation();
    hideResults();
  }
  fieldCombobox?.addEventListener('change', (e) => {
    const value = (e as CustomEvent).detail?.value;
    if (typeof value === 'string' && value) setField(value);
  });
  // Map marker clicks switch the field too — mirror the choice into the combobox.
  function setFieldAndSync(id: string) {
    setField(id);
    if (fieldCombobox) fieldCombobox.value = id;
  }

  // Step 2 · goals (esa-chip-group, multi-select)
  goalChips?.addEventListener('change', (e) => {
    const values: string[] = (e as CustomEvent).detail?.values ?? [];
    state.goalIds = new Set(values);
    hideResults();
    syncEvaluateDisabled();
  });

  // Step 3 · biochar selects (esa-select)
  function syncCharCard(slot: 'a' | 'b') {
    const id = state.chars[slot];
    const card = document.querySelector(`.compare-option[data-slot="${slot}"]`);
    if (!card) return;
    const set = (key: string, text: string) => {
      const node = card.querySelector(`[data-char-stat="${key}"]`);
      if (node) node.textContent = text;
    };
    // Empty until this slot has a biochar: blank the spec lines (em dash).
    if (!id) {
      for (const key of ['feedstock', 'htt', 'fixedC', 'surface']) set(key, '—');
      return;
    }
    const char = byId(biocharCatalog, id);
    set('feedstock', char.feedstockClass);
    set('htt', `${char.htt}°C`);
    set('fixedC', `${char.fixedCarbonPct}%`);
    set('surface', `${char.surfaceAreaM2g} m²/g`);
  }
  function syncSelectDisabling() {
    for (const slot of ['a', 'b'] as const) {
      const other = slot === 'a' ? 'b' : 'a';
      const sel = charSelects[slot] as (ValueControl & { options: unknown[] }) | null;
      if (!sel) continue;
      sel.options = biocharCatalog.map((b) => ({
        value: b.id,
        label: b.name,
        // Only disable the option the OTHER slot has actually picked.
        disabled: state.chars[other] !== null && b.id === state.chars[other],
      }));
    }
  }
  for (const slot of ['a', 'b'] as const) {
    charSelects[slot]?.addEventListener('change', (e) => {
      const value = (e as CustomEvent).detail?.value;
      if (typeof value !== 'string' || !value) return;
      state.chars[slot] = value;
      syncCharCard(slot);
      syncSelectDisabling();
      syncEvaluateDisabled();
      hideResults();
    });
    // Application rate (Detailed) — feeds the deterministic scoring modifier.
    rateSelects[slot]?.addEventListener('change', (e) => {
      const value = (e as CustomEvent).detail?.value;
      const n = typeof value === 'string' ? Number(value) : NaN;
      if (!Number.isFinite(n)) return;
      state.apps[slot].rateTonsPerAcre = n;
      hideResults(); // a changed input must be re-evaluated, not shown stale
    });
    // Compost co-application (Detailed).
    compostToggles[slot]?.addEventListener('change', (e) => {
      const checked =
        (e as CustomEvent).detail?.checked ?? compostToggles[slot]!.checked;
      state.apps[slot].compost = !!checked;
      hideResults();
    });
  }
  // ───────────────────────── interpretation (site response) ─────────────────────────
  // Recompute the NRCS site-readiness layer and patch the bca-interpretation-panel
  // DOM in place. Runs on load, on field switch, on a factor toggle, and on the
  // tile-drainage answer. Independent of the biochar evaluation.
  const sitePanel = document.querySelector('[data-site-panel]');
  const bandLabel = (b: string, group: string): string =>
    group === 'dynamic'
      ? b === 'well'
        ? 'High benefit'
        : b === 'moderate'
          ? 'Some benefit'
          : 'Low benefit'
      : b === 'well'
        ? 'Clear'
        : b === 'moderate'
          ? 'Caution'
          : 'Limiting';

  function renderInterpretation() {
    if (!sitePanel) return;
    const s = soil();
    if (!s) return; // empty state — readiness panel is hidden, nothing to patch
    const result = interpretSite(s, { disabledKeys: interp.disabled, tiled: interp.tiled });

    sitePanel.setAttribute('data-site-verdict', result.verdict);
    sitePanel.querySelectorAll('[data-site-label]').forEach((node) => {
      node.textContent = result.verdictLabel;
    });
    sitePanel.querySelectorAll('[data-site-score]').forEach((node) => {
      node.textContent = String(result.responseScore);
    });
    sitePanel.querySelectorAll<HTMLElement>('[data-site-meter] i').forEach((node) => {
      node.style.width = `${result.responseScore}%`;
    });
    // "N factors off" badge — the response score is computed over the ACTIVE
    // factors, so flag when the user has filtered any out.
    const off = interp.disabled.size;
    const filteredEl = sitePanel.querySelector('[data-site-filtered]') as HTMLElement | null;
    if (filteredEl) {
      filteredEl.textContent = `${off} factor${off === 1 ? '' : 's'} off`;
      filteredEl.hidden = off === 0;
    }
    sitePanel.querySelectorAll('[data-site-narrative]').forEach((node) => {
      node.textContent = result.narrative;
    });

    const flagsEl = sitePanel.querySelector('[data-site-flags]') as HTMLElement | null;
    if (flagsEl) {
      flagsEl.replaceChildren();
      for (const f of result.flags) flagsEl.appendChild(el('li', 'bca-fr__flag', f));
      flagsEl.hidden = result.flags.length === 0;
    }

    for (const c of result.criteria) {
      const row = sitePanel.querySelector(`.bca-row[data-criterion="${c.key}"]`);
      if (!row) continue;
      row.setAttribute('data-band', c.band);
      row.classList.toggle('is-off', !c.active && !c.disabled);
      row.classList.toggle('is-disabled', c.disabled);
      const v = row.querySelector('[data-crit-value]');
      if (v) v.textContent = c.valueText;
      const bandEl = row.querySelector('[data-crit-band]');
      if (bandEl) bandEl.textContent = bandLabel(c.band, c.group);
      const impact = row.querySelector('[data-crit-impact]');
      if (impact) impact.textContent = c.disabledReason ?? c.impact;
      const toggle = row.querySelector('[data-factor-toggle]') as
        | (HTMLElement & { checked: boolean; disabled: boolean })
        | null;
      if (toggle) {
        toggle.disabled = c.disabled;
        toggle.checked = c.active;
      }
    }
  }

  const tileToggle = document.getElementById('tile-toggle') as
    | (HTMLElement & { checked: boolean })
    | null;
  tileToggle?.addEventListener('change', (e) => {
    interp.tiled = (e as CustomEvent).detail?.checked ?? tileToggle.checked;
    renderInterpretation();
  });

  for (const t of Array.from(document.querySelectorAll('[data-factor-toggle]'))) {
    t.addEventListener('change', (e) => {
      const key = (t as HTMLElement).getAttribute('data-factor-toggle');
      if (!key) return;
      const checked =
        (e as CustomEvent).detail?.checked ?? (t as HTMLElement & { checked: boolean }).checked;
      if (checked) interp.disabled.delete(key);
      else interp.disabled.add(key);
      renderInterpretation();
    });
  }

  const factorsDialog = document.getElementById('factors-dialog') as
    | (HTMLElement & { show: () => void; close: () => void })
    | null;
  document
    .querySelector<HTMLButtonElement>('#view-factors-btn .esa-button__native')
    ?.addEventListener('click', () => factorsDialog?.show());

  // Empty state on load: blank the server-rendered default biochar spec lines so
  // the unselected cards don't show stale defaults. Field/soil/readiness are
  // hidden via data-field-selected; the boundary group starts empty.
  syncCharCard('a');
  syncCharCard('b');
  syncSelectDisabling();
  syncEvaluateDisabled();
  renderInterpretation(); // no-op until a field is picked
  applyMode('quick'); // sync the "why" disclosure to the default depth
</script>

