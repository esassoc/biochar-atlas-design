---
// Admin › Users — the list, and the record. The house pattern this app reuses
// for every collection: a page header carrying the one create action, a
// searchable AG Grid, and the record itself as a slide-in panel over it rather
// than a page you navigate away to.
import AppShell from '../../layouts/AppShell.astro';
import BcaPageHeader from '../../components/bca/bca-page-header.astro';
import BcaUserGrid from '../../components/bca/bca-user-grid.astro';
import BcaUserPanel from '../../components/bca/bca-user-panel.astro';
import BcaUserEditPanel from '../../components/bca/bca-user-edit-panel.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
---

<!-- manifest:
  layout: AppShell > stack(lg) spine      # Atlas app shell + sidenav
  sections:
    - page header  -> bca-page-header     # glyph, title, the Invite user action
    - user list    -> bca-user-grid       # control strip, AG Grid, record count
    - user record  -> bca-user-panel      # the slide-in record, ?user=<id>
    - edit         -> bca-user-edit-panel # the write surface, stacked over it
-->

<AppShell title="Users — Biochar Atlas" activeNavId="admin-users">
  <div class="page stack" data-gap="lg">
    <BcaPageHeader title="Users" icon="users">
      <Fragment slot="actions">
        <EsaButton variant="primary" size="sm" icon="plus">Invite user</EsaButton>
      </Fragment>
    </BcaPageHeader>

    <BcaUserGrid />
  </div>

  <BcaUserPanel />
  <BcaUserEditPanel />
  <esa-snackbar-container id="app-toasts"></esa-snackbar-container>
</AppShell>

<style>
  /* The shell's content region has no padding of its own — it is edge-to-edge
     so the suitability tool can fill it — so a document-shaped page supplies
     its own gutter. */
  .page {
    padding: var(--spacing-600, 2rem);
  }
</style>
