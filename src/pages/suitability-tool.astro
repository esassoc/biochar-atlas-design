---
// Suitability Tool — the stepper chrome, "split rails" arrangement (chosen
// direction, 2026-08-25): the checklist rail on the left, the step stack in
// the center, the accumulating Summary card on the right. The alternate
// "fused rail" direction remains at suitability-tool/option-b.astro.
import AppShell from '../layouts/AppShell.astro';
import BcaToolFrame from '../components/bca/bca-tool-frame.astro';
import BcaWorkflowWorkspace from '../components/bca/bca-workflow-workspace.astro';
import { evaluateASite, exploreBiochars } from '../data/workflow';
---

<!-- manifest:
  layout: AppShell                              # Atlas app shell + sidenav
  sections:
    - tool frame          -> bca-tool-frame     # page header + workflow switch
    - evaluate workspace  -> bca-workflow-workspace  # soil-first stepper, split rails
    - explore workspace   -> bca-workflow-workspace  # biochar-first stepper, split rails
-->

<AppShell title="Suitability Tool — Biochar Atlas" activeNavId="suitability-tool">
  <BcaToolFrame>
    <BcaWorkflowWorkspace slot="evaluate" workflow={evaluateASite} variant="split" />
    <BcaWorkflowWorkspace slot="explore" workflow={exploreBiochars} variant="split" />
  </BcaToolFrame>
</AppShell>
