---
// Biochar Atlas — Home. A mark-forward hub on warm paper: the leaf mark in
// ABI Green, then the two layers of the repo — the Design System (live) and
// the Pattern Library (coming soon) — and the prototype library, rendered
// straight off the typed registry in src/data/prototypes.ts so shipping a new
// screen is a one-row data edit.
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
import { prototypes, type PrototypeStatus } from '../data/prototypes';

// Newest first. ISO dates compare correctly as strings.
const rows = [...prototypes].sort((a, b) => b.createdAt.localeCompare(a.createdAt));

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
// Format from the ISO parts directly — avoids new Date() timezone drift that can
// roll a UTC-midnight date back a day in the build environment.
const fmtDate = (iso: string): string => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${MONTHS[m - 1]} ${d}, ${y}`;
};

const STATUS_LABEL: Record<PrototypeStatus, string> = {
  live: 'Live',
  'in-progress': 'In progress',
  planned: 'Planned',
  archived: 'Archived',
};
---
<BaseLayout title="Biochar Atlas — Design & Prototypes">
  <main class="home">
    <header class="hero">
      <div class="hero__mark">
        <svg width="104" height="104" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
      </div>
      <h1 class="hero__title">Biochar Atlas</h1>
      <p class="hero__tagline">
        Design spoke for the Biochar Suitability Tool — tokens, components,
        and working prototypes on the ESA Ecology hub.
      </p>
    </header>

    <section class="layers" aria-label="Layers">
      <a class="layer" href={withBase('/design-system')}>
        <span class="layer__status layer__status--live"><span class="dot"></span>Live</span>
        <h2 class="layer__title">Design System</h2>
        <p class="layer__body">The brand layer — the ABI palette extended into 12-step ramps, warm neutral chrome on the palette's own hue, and Inter with Crimson Pro headlines over the inherited Ecology components.</p>
        <span class="layer__go">Open the design system<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
      </a>

      <a class="layer layer--soon" href={withBase('/patterns')}>
        <span class="layer__status layer__status--soon"><span class="dot"></span>Coming soon</span>
        <h2 class="layer__title">Pattern Library</h2>
        <p class="layer__body">Composed, multi-component patterns — the suitability workflow shell, score &amp; rationale displays, soil context panels — assembled from the system.</p>
        <span class="layer__go">Preview<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
      </a>
    </section>

    <section class="protos" aria-label="Prototype library">
      <div class="protos__head">
        <h2>Prototype Library</h2>
        <p>Working screens for the Biochar Suitability Tool, built on the system. Newest first; the statuses are honest.</p>
      </div>
      <ul class="proto-list">
        {rows.map((p) => (
          <li class="proto-card">
            <a class="proto-card__link" href={withBase(p.route)}>
              <span class="proto-card__title">
                {p.title}
                <svg class="proto-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
              </span>
            </a>
            <p class="proto-card__desc">{p.description}</p>
            <div class="proto-card__foot">
              <span class="lib-status" data-status={p.status}>
                <span class="lib-status__dot" aria-hidden="true"></span>
                {STATUS_LABEL[p.status]}
              </span>
              <time class="proto-card__meta" datetime={p.createdAt}>{fmtDate(p.createdAt)}</time>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <footer class="home__foot">
      <svg class="home__foot-mark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
      <span>A spoke of the ESA Ecology design system</span>
    </footer>
  </main>

  <style>
    .home { max-width: 1040px; margin: 0 auto; padding: 0 var(--spacing-500, 24px); }

    /* ---- Hero — the leaf, big and ABI Green on warm paper ---- */
    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: var(--spacing-900, 96px) 0 var(--spacing-800, 64px);
    }
    .hero__mark {
      color: var(--color-primary, #364500);
      line-height: 0;
      /* No tinted halo. Green at tint weight on this palette is a yellow-green
         (#eef7dc) and reads as a highlighter smudge behind the mark; the
         drop-shadow alone carries the depth. */
      padding: var(--spacing-700, 48px);
      margin: calc(-1 * var(--spacing-500, 24px)) 0 var(--spacing-400, 16px);
      filter: drop-shadow(0 8px 24px color-mix(in srgb, var(--color-primary, #364500) 18%, transparent));
    }
    .hero__title {
      margin: 0;
      /* Face and weight inherit from the theme — this is the one place the
         brand headline voice gets to be the whole composition. */
      font-size: clamp(2.75rem, 2rem + 3.5vw, 4.25rem);
      line-height: 1.02;
      letter-spacing: -0.02em;
      color: var(--color-text-primary, #21201c);
    }
    .hero__tagline {
      margin: var(--spacing-400, 16px) auto 0;
      max-width: 56ch;
      font-size: 18px;
      line-height: 1.6;
      color: var(--color-text-secondary, #54514a);
    }

    /* ---- Layer cards ---- */
    .layers {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-400, 16px);
      padding-bottom: var(--spacing-800, 64px);
    }
    .layer {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: var(--spacing-600, 32px);
      border: 1px solid var(--color-border, #ddd9d0);
      border-radius: var(--radius-400, 12px);
      background: var(--color-surface, #fff);
      transition: border-color 0.14s ease, box-shadow 0.14s ease, transform 0.14s ease;
    }
    .layer:hover {
      border-color: var(--color-primary-border, #c8dabe);
      box-shadow: 0 12px 32px color-mix(in srgb, var(--color-primary, #234a31) 12%, transparent);
      transform: translateY(-2px);
    }
    .layer--soon { background: var(--color-surface-sunken, #f3f1ea); }
    .layer__status {
      display: inline-flex; align-items: center; gap: var(--spacing-150, 6px);
      font-size: 14px; font-weight: var(--font-weight-medium, 500);
    }
    .layer__status .dot { width: 8px; height: 8px; border-radius: 50%; }
    .layer__status--live { color: var(--color-success, #2e7d4f); }
    .layer__status--live .dot { background: var(--color-success, #2e7d4f); }
    .layer__status--soon { color: var(--color-text-muted, #807c73); }
    .layer__status--soon .dot { background: var(--color-secondary, #4e7d52); }
    .layer__title {
      margin: var(--spacing-300, 12px) 0 var(--spacing-200, 8px);
      font-size: var(--type-size-600, 2rem);
      font-weight: var(--font-weight-semibold, 600);
      letter-spacing: -0.01em;
      color: var(--color-text-primary, #33312a);
    }
    .layer__body { margin: 0; font-size: 16px; line-height: 1.55; color: var(--color-text-secondary, #54514a); }
    .layer__go {
      display: inline-flex; align-items: center; gap: var(--spacing-150, 6px);
      margin-top: var(--spacing-500, 24px);
      font-weight: var(--font-weight-semibold, 600);
      font-size: 16px;
      color: var(--color-text-link, #234a31);
    }
    .layer__go svg { transition: transform 0.14s ease; }
    .layer:hover .layer__go svg { transform: translateX(3px); }
    .layer--soon .layer__go { color: var(--color-text-muted, #807c73); }

    /* ---- Prototype library ---- */
    .protos { padding-bottom: var(--spacing-800, 64px); }
    .protos__head { margin-bottom: var(--spacing-400, 16px); }
    .protos__head h2 {
      margin: 0;
      font-size: var(--type-size-500, 1.5rem);
      font-weight: var(--font-weight-semibold, 600);
      color: var(--color-text-primary, #33312a);
    }
    .protos__head p { margin: var(--spacing-100, 4px) 0 0; font-size: 16px; color: var(--color-text-secondary, #54514a); }
    .proto-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-300, 12px); }
    .proto-card {
      position: relative;
      padding: var(--spacing-400, 16px) var(--spacing-500, 24px);
      border: 1px solid var(--color-border, #ddd9d0);
      border-radius: var(--radius-300, 8px);
      background: var(--color-surface, #fff);
      transition: background-color 0.12s ease, border-color 0.12s ease;
    }
    .proto-card:hover { background: var(--color-primary-subtle, #f0f5ec); border-color: var(--color-primary-border, #c8dabe); }
    .proto-card__link { display: block; }
    .proto-card__link::after { content: ''; position: absolute; inset: 0; }
    .proto-card__title {
      display: inline-flex; align-items: center; gap: var(--spacing-150, 6px);
      font-weight: var(--font-weight-semibold, 600);
      font-size: 17px;
      color: var(--color-text-link, #234a31);
    }
    .proto-card__arrow { opacity: 0; transition: opacity 0.12s ease; flex: none; }
    .proto-card:hover .proto-card__arrow { opacity: 0.7; }
    .proto-card__desc { margin: var(--spacing-150, 6px) 0 var(--spacing-300, 12px); font-size: 15px; line-height: 1.5; color: var(--color-text-secondary, #54514a); }
    .proto-card__foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-300, 12px); }
    .proto-card__meta { font-size: 14px; color: var(--color-text-muted, #807c73); font-variant-numeric: tabular-nums; }

    .lib-status {
      display: inline-flex; align-items: center; gap: var(--spacing-150, 6px);
      padding: 2px var(--spacing-250, 10px) 2px var(--spacing-200, 8px);
      border-radius: var(--radius-full, 999px);
      font-size: 14px; font-weight: var(--font-weight-medium, 500); white-space: nowrap;
    }
    .lib-status__dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
    .lib-status[data-status='live'] { background: var(--bca-green-100, #e2ecda); color: var(--color-success-strong, #1b3b27); }
    .lib-status[data-status='live'] .lib-status__dot { background: var(--color-success, #2e7d4f); }
    .lib-status[data-status='in-progress'] { background: var(--bca-amber-100, #f7ead2); color: var(--color-warning-strong, #7c5310); }
    .lib-status[data-status='in-progress'] .lib-status__dot { background: var(--bca-amber-500, #d99a2b); }
    .lib-status[data-status='planned'] { background: var(--color-surface-sunken, #f3f1ea); color: var(--color-text-secondary, #54514a); }
    .lib-status[data-status='planned'] .lib-status__dot { background: var(--color-text-muted, #807c73); }
    .lib-status[data-status='archived'] { background: var(--color-surface-sunken, #f3f1ea); color: var(--color-text-muted, #807c73); }
    .lib-status[data-status='archived'] .lib-status__dot { background: var(--color-border-strong, #c2beb4); }

    /* ---- Footer ---- */
    .home__foot {
      display: flex; align-items: center; gap: var(--spacing-250, 10px);
      padding: var(--spacing-500, 24px) 0 var(--spacing-800, 64px);
      border-top: 1px solid var(--color-border, #ddd9d0);
      color: var(--color-text-muted, #807c73);
      font-size: 14px;
    }
    .home__foot-mark { color: var(--color-primary, #234a31); flex: none; }

    @media (max-width: 720px) {
      .layers, .proto-list { grid-template-columns: 1fr; }
      .hero { padding-top: var(--spacing-800, 64px); }
    }
  </style>
</BaseLayout>
